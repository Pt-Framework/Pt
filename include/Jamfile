SubDir TOP include ;

SubDir TOP include Pt ;
PT_INCLUDES_SUBDIR = [ FDirName $(TOP) include Pt ] ;
PT_INSTALL_INCLUDES = [ GLOB $(PT_INCLUDES_SUBDIR) : *.h  ] ;
PT_INSTALL_INCLUDES += [ GLOB $(PT_INCLUDES_SUBDIR) : *.tpp  ] ;
InstallFile [ FDirName $(INSTALL_INCLUDE) Pt ] : $(PT_INSTALL_INCLUDES:BS) ;

