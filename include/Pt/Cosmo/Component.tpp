#ifndef COSMO_COMPONENT_TPP
#define COSMO_COMPONENT_TPP

#include <Pt/Cosmo/IComponentType.h>

namespace Pt {

 namespace Cosmo {

inline Component::Component()
: _type(0)
, _decl(0)
{
}


inline void Component::init(const IComponentType* type,
                            const IComponentDeclaration* decl)
{
  _type = type;
  _decl = decl;

  onInitialize(*_decl);
}


inline bool Component::hasFeatureId(const char* featureId) const
{
  return _type ? _type->hasFeatureId(featureId) : false;
}


inline const char* Component::classId() const
{
  return _type ? _type->classId() : "";
}


template <typename I>
I* Component::queryInterface()
{      
  if(_type)
    return _type->queryInterface<I>(*this);

  return 0;
}

} // namespace Cosmo

} // namespace Pt

#endif
