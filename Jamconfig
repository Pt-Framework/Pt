#############################################################################
# Compiler and linker settings
#############################################################################

ConfigureCc ;
ConfigureC++ ;

local rc = [ TryCompileC++ WITH_LONG_LONG : "#include <iostream>"
                                            "int main() { long long ll = 42; std::cout << ll; }" ] ;

if ! $(rc)
{
    Echo "  INFO: no long long available" ;
}
else
{
    Echo "  INFO: long long available" ;
}

ALL_LOCATE_OBJECTS = tmp$(SLASH)$(CONFIG) ;
Configure ALL_LOCATE_OBJECTS ;

ALL_LOCATE_TARGET = build$(SLASH)$(CONFIG) ;
Configure ALL_LOCATE_TARGET ;

# TODO: is this obsolete?
OUTPUT_TARGET = build$(SLASH)$(CONFIG) ;
Configure OUTPUT_TARGET ;

#############################################################################
# Platform settings
#############################################################################

if $(TARGET_OS:L) = "nt"
{
    ConfigurePlatformSDK ;

    SYS     ?= win32 ;
    GUI     ?= gdi ;
    SYSLIBS = version.lib Psapi.lib ;
    NETLIBS = wsock32.lib ws2_32.lib ;

    if $(MINGW) || $(TOOLSET) = "gcc"
    {
        SYSLIBS = -lversion -lwinmm -lpsapi ;
                  #$(MINGW)$(SLASH)lib$(SLASH)libversion.a
                  #$(MINGW)$(SLASH)lib$(SLASH)libwinmm.a
                  #$(MINGW)$(SLASH)lib$(SLASH)libpsapi.a ;
        NETLIBS = -lwsock32 -lws2_32 ;
                  #$(MINGW)$(SLASH)lib$(SLASH)libwsock32.a
                  #$(MINGW)$(SLASH)lib$(SLASH)libws2_32.a ;
    }
}
if $(TARGET_OS:L) = "wince"
{
    ConfigurePlatformSDK ;

    SYS     ?= win32 ;
    GUI     ?= gdi ;
    SYSLIBS = mmtimer.lib ;
    NETLIBS = winsock.lib Ws2.lib ;
}
if $(TARGET_OS:L) = "linux"
{
    SYS     ?= posix ;
    GUI     ?= x11 ;
    SYSLIBS = -ldl -lpthread -lrt ;
    NETLIBS = -lnsl ;
}
if $(TARGET_OS:L) = "macosx"
{
    SYS     ?= posix ;
    GUI     ?= cocoa ;
    SYSLIBS = -ldl -lpthread ;
    #NETLIBS =  ;
}
if $(TARGET_OS:L) = "aspen"
{
    SYS     ?= posix ;
    GUI     ?= uikit ;
    SYSLIBS = -ldl -lpthread ;
}
if $(TARGET_OS) = "aix"
{
    SYS      ?= posix ;
    GUI      ?= x11 ;
    SYSLIBS  = -bdynamic -ldl -lpthread -lrt ;
    LINKLIBS += $(SYSLIBS) ;
    # NETLIBS =
}
if $(TARGET_OS) = "solaris"
{
    SYS     ?= posix ;
    GUI     ?= x11 ;
    SYSLIBS = -ldl -lpthread -lrt ;
    NETLIBS = -lsocket -lnsl ;
}
if $(TARGET_OS:L) = "qnxnto"
{
    SYS     ?= posix ;
    GUI     ?= photon ;
    SYSLIBS =  ;
    NETLIBS = -lsocket ;
}
if $(TARGET_OS:L) = "symbian"
{
    SYS     ?= symbian ;
    GUI     ?= symbian-eikon ;
    SYSLIBS =  ;
    NETLIBS =  ;
}

Configure SYS ;
Echo "Checking for subsystem..." $(SYS) ;

Configure SYSLIBS ;
Echo "Checking for system libraries..." $(SYSLIBS) ;

Configure NETLIBS ;
Echo "Checking for network libraries..." $(NETLIBS) ;

Configure GUI ;
Echo "Checking for graphics UI..." $(GUI) ;


#############################################################################
# OpenSSL libraries and includes
#############################################################################

WITH_OPENSSL ?= "no" ;

for local arg in $(ARGV)
{
    if $(arg) = "--with-openssl"
    {
        WITH_OPENSSL = "yes" ;
    }
}

Configure WITH_OPENSSL ;
Echo "Checking for OpenSSL (--with-openssl)..." $(WITH_OPENSSL) ;


#############################################################################
# HTTP2 libraries and includes
#############################################################################

WITH_HTTP2 ?= "no" ;

for local arg in $(ARGV)
{
    if $(arg) = "--with-http2"
    {
        WITH_HTTP2 = "yes" ;
    }
}

Configure WITH_HTTP2 ;
Echo "Checking for HTTP2 (--with-http2)..." $(WITH_HTTP2) ;


#############################################################################
# Gfx libraries and includes
#############################################################################

JamInclude freetype.jam ;

ConfigureFreetype ;
    
if ! $(FREETYPE_INCLUDES) || ! $(FREETYPE_LINKFLAGS)
{
    FREETYPE_INCLUDES = src/Pt-Gfx/freetype/include ;
    FREETYPE_LINKFLAGS = "" ;

    Configure FREETYPE_INCLUDES ;
    Echo "Checking for freetype includes..." $(FREETYPE_INCLUDES) ;

    Configure FREETYPE_LINKFLAGS ;
    Echo "Checking for freetype linkflags..." $(FREETYPE_LINKFLAGS) ;
}


#############################################################################
# GUI libraries and includes
#############################################################################

if $(GUI:L) = "gdi"
{
    if $(TARGET_OS:L) = "nt"
    {
        GUILIBS = gdi32.lib user32.lib ;
    }
    if $(MINGW) || $(TOOLSET) = "gcc"
    {
        GUILIBS = -lgdi32 -luser32 ;
                  #$(MINGW)$(SLASH)lib$(SLASH)libgdi32.a
                  #$(MINGW)$(SLASH)lib$(SLASH)libuser32.a  ;
    }
}

if $(GUI:L) = "x11"
{
    if ! $(GUILIBS) 
    {
        JamInclude x11.jam ;

        local x11incl = [ X11Includes ] ;
        if $(x11incl) = ""
        {
            Echo "    ERROR: X11 includes are required!" ;
        }

        local x11libs = [ X11Libs ] ;
        if $(x11libs) = ""
        {
            Echo "    ERROR: X11 libraries are required!" ;
        }

       local xextlibs = [ XextLibs ] ;
        if $(xextlibs) = ""
       {
            Echo "    ERROR: Xext libraries are required!" ;
        }

        local xftincl = [ XftIncludes ] ;
        if $(xftincl) = ""
        {
            Echo "    INFO: Xft includes not available!" ;
        }

        local xftlibs = [ XftLibs ] ;
        if $(xftlibs) = ""
        {
            Echo "    INFO: Xft libraries not available!" ;
        }

        GUILIBS += $(x11libs) $(xextlibs) $(xftlibs) ;
    }
}

if $(GUI:L) = "photon"
{
    GUILIBS = -lphrender -lph ;
}

if $(GUI:L) = "symbian-eikon"
{
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\apparc.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\cone.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\eikcore.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\avkon.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\commonengine.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\estor.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\hlplch.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bafl.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\charconv.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\ws32.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\fbscli.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bitgdi.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\gdi.dso ;
}

if $(GUI:L) = "cocoa"
{
    GUILIBS = -framework AppKit -framework Foundation ;
}

if $(GUI:L) = "uikit"
{
    GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
}

Configure GUILIBS ;
Echo "Checking for gui libss..." $(GUILIBS) ;

