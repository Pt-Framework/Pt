
JamInclude freetype.jam ;

ConfigureCc ;

ConfigureC++ ;

if $(TARGET_OS:L) = "nt"
{
    ConfigurePlatformSDK ;

    CCFLAGS   += /DWIN32 ;
    LINKFLAGS += /MANIFEST ;

    STDHDRS += $(VISUALC_INCLUDES) $(PLATFORMSDK_INCLUDES) ;
    LINKFLAGS += $(VISUALC_LINKFLAGS) $(PLATFORMSDK_LINKFLAGS) ;

    Configure STDHDRS : $(STDHDRS) ;
    Configure CCFLAGS : $(CCFLAGS) ;
    Configure LINKFLAGS : $(LINKFLAGS) ;
}

if $(TARGET_OS:L) = "wince"
{
    ConfigurePlatformSDK ;

    LINKFLAGS += /MANIFEST:NO ;

    if $(TARGET_OSPLAT:L) = "arm"
    {
        LINKLIBS += "coredll.lib corelibc.lib ccrtrtti.lib secchk.lib" ;
    }

    CCFLAGS += $(PLATFORMSDK_CCFLAGS) ;
    STDHDRS += $(VISUALC_INCLUDES) $(PLATFORMSDK_INCLUDES) ;
    LINKFLAGS += $(VISUALC_LINKFLAGS) $(PLATFORMSDK_LINKFLAGS) ;

    Configure STDHDRS : $(STDHDRS) ;
    Configure CCFLAGS : $(CCFLAGS) ;
    Configure LINKFLAGS : $(LINKFLAGS) ;
    Configure MAINLINKFLAGS : $(MAINLINKFLAGS) ;
    Configure LINKLIBS : $(LINKLIBS) ;
}

ConfigureFreetype ;

WITH_OPENSSL = "no" ;

for local arg in $(ARGV)
{
    if $(arg) = "--with-openssl"
    {
        WITH_OPENSSL = "yes" ;
    }
}


Configure WITH_OPENSSL : $(WITH_OPENSSL) ;
Echo "Checking for OpenSSL (--with-openssl)..." $(WITH_OPENSSL) ;


if $(TARGET_OS:L) = "linux"
{
    SYS     ?= posix ;
    GUI     ?= x11 ;
    SYSLIBS = -ldl -lpthread -lrt ;
    NETLIBS = -lnsl ;
}

if $(GUI:L) = "x11"
{
    JamInclude x11.jam ;

    local x11incl = [ X11Includes ] ;
    if $(x11incl) = ""
    {
        Exit "    ERROR: X11 includes are required!" ;
    }

    local x11libs = [ X11Libs ] ;
    if $(x11libs) = ""
    {
        Exit "    ERROR: X11 libraries are required!" ;
    }

    local xextlibs = [ XextLibs ] ;
    if $(xextlibs) = ""
    {
        Exit "    ERROR: Xext libraries are required!" ;
    }

    local xftincl = [ XftIncludes ] ;
    if $(xftincl) = ""
    {
        Exit "    INFO: Xft includes not available!" ;
    }

    local xftlibs = [ XftLibs ] ;
    if $(xftlibs) = ""
    {
        Exit "    INFO: Xft libraries not available!" ;
    }

    GUILIBS += $(x11libs) $(xextlibs) $(xftlibs) ;
    Configure GUILIBS : $(GUILIBS:J=" ") ;
}
