SubDir PT_TOP ;

#############################################################################
# General values and settings
#############################################################################

# include rules an actions to build unit tests
Load unittest.jam ;

# set directory to build objects and targets
ALL_LOCATE_OBJECTS ?= [ FDirName $(PT_TOP) tmp $(CONFIG) ] ;
ALL_LOCATE_TARGET ?= [ FDirName $(PT_TOP) build $(CONFIG) ] ;

# set directory to build objects and targets
# this is used by MakeLocate and SubDirObjects in the Jamfiles
OUTPUT_TARGET = [ FDirName $(PT_TOP) build $(CONFIG) ] ;
OUTPUT_OBJECT = [ FDirName $(PT_TOP) tmp $(CONFIG) ] ;
OUTPUT_TEST = [ FDirName $(PT_TOP) build $(CONFIG) ] ;

#############################################################################
# Pt Header Files
#############################################################################

SubDir PT_TOP include Pt ;
PT_INCLUDES_SUBDIR = [ FDirName $(PT_TOP) include Pt ] ;
PT_INSTALL_INCLUDES = [ GLOB $(PT_INCLUDES_SUBDIR) : *.h  ] ;
PT_INSTALL_INCLUDES += [ GLOB $(PT_INCLUDES_SUBDIR) : *.tpp  ] ;
InstallFile [ FDirName $(INSTALL_INCLUDEDIR) Pt ] : $(PT_INSTALL_INCLUDES:BS) ;

