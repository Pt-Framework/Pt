SubDir PT_TOP ;

if $(PTHREAD_INCLUDES)
{
    SubDirHdrs $(PTHREAD_INCLUDES) ;
}

#############################################################################
# General values and settings
#############################################################################

Load unittest.jam ;
Load lsbpkg.jam ;

# set default directory to build objects and targets
# ALL_LOCATE_OBJECTS ?= [ FDirName $(PT_TOP) output ] ;
# ALL_LOCATE_TARGET ?= [ FDirName $(PT_TOP) output ] ;

#############################################################################
# Pt Header Files
#############################################################################

SubDir PT_TOP include Pt ;
PT_INCLUDES_SUBDIR = [ FDirName $(PT_TOP) include Pt ] ;
PT_INSTALL_INCLUDES = [ GLOB $(PT_INCLUDES_SUBDIR) : *.h  ] ;
PT_INSTALL_INCLUDES += [ GLOB $(PT_INCLUDES_SUBDIR) : *.tpp  ] ;
InstallFile [ FDirName $(PT_INSTALL_INCLUDEDIR) Pt ] : $(PT_INSTALL_INCLUDES:BS) ;

SubDir PT_TOP include Pt System ;
PT_INCLUDES_SUBDIR = [ FDirName $(PT_TOP) include Pt System ] ;
PT_INSTALL_INCLUDES = [ GLOB $(PT_INCLUDES_SUBDIR) : *.h  ] ;
PT_INSTALL_INCLUDES += [ GLOB $(PT_INCLUDES_SUBDIR) : *.tpp  ] ;
InstallFile [ FDirName $(PT_INSTALL_INCLUDEDIR) Pt System ] : $(PT_INSTALL_INCLUDES:BS) ;

SubDir PT_TOP include Pt Net ;
PT_INCLUDES_SUBDIR = [ FDirName $(PT_TOP) include Pt Net ] ;
PT_INSTALL_INCLUDES = [ GLOB $(PT_INCLUDES_SUBDIR) : *.h  ] ;
PT_INSTALL_INCLUDES += [ GLOB $(PT_INCLUDES_SUBDIR) : *.tpp  ] ;
InstallFile [ FDirName $(PT_INSTALL_INCLUDEDIR) Pt Net ] : $(PT_INSTALL_INCLUDES:BS) ;

