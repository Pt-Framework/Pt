#############################################################################
# Pt Build Targets
#############################################################################

SubInclude PT_TOP src Pt ;
SubInclude PT_TOP src Pt-Unit ;
SubInclude PT_TOP src Pt-Xml ;

if $(SYS)
{
    SubInclude PT_TOP src Pt-System ;
    SubInclude PT_TOP src Pt-Net ;
    SubInclude PT_TOP src Pt-Http ;
    SubInclude PT_TOP src Pt-XmlRpc ;
    SubInclude PT_TOP src Pt-Ssl ;

    if $(WITH_OPENSSL)
    {
        SubInclude PT_TOP src openssl ;
    }
}

#############################################################################
# LSB packages
#############################################################################

PT_LSB_PACKAGE_ROOTDIR = [ FDirName opt Pt-1.0.0 ] ;
PT_LSB_PACKAGE_LIBDIR = [ FDirName $(PT_LSB_PACKAGE_ROOTDIR) lib ] ;

PT_LSB_PACKAGE_DESCRIPTION = Platinum (Pt) is a comprehensive C++ framework, 
                             which allows developers to write high-performance
                             applications for many platforms with only one
                             codebase. ;

LsbPackage Pt-devel : --license 'extended LGPL' 
                      --version 1.0.0 --release 1 
                      --group 'C++ Framework' 
                      --package 'Pt Development Team' 
                      --vendor 'Pt Development Team' 
                      --summary 'Platinum (Pt) C++ Framework Development Package' 
                      --description '$(PT_LSB_PACKAGE_DESCRIPTION:J=" ")' ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp  ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt System ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/System : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt Net ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/Net : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt Ssl ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/Ssl : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt Http ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/Http : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt Unit ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/Unit : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt Xml ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/Xml : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;

PT_INCLUDES_SUBDIRS = [ FDirName $(PT_TOP) include Pt XmlRpc ] ;
LsbPackageAdd Pt-devel : $(PT_LSB_PACKAGE_ROOTDIR)/include/Pt/XmlRpc : [ GLOB $(PT_INCLUDES_SUBDIRS) : *.h *.tpp ] ;


LsbPackage Pt : --license 'extended LGPL' 
                --version 1.0.0 --release 1 
                --group 'C++ Framework' 
                --package 'Pt Development Team' 
                --vendor 'Pt Development Team' 
                --summary 'Platinum (Pt) C++ Framework Runtime Libraries' 
                --description '$(PT_LSB_PACKAGE_DESCRIPTION:J=" ")' ;

LsbPackageAdd Pt : $(PT_LSB_PACKAGE_LIBDIR) : $(PRELIB)Pt$(SUFDLL) 
                                              $(PRELIB)Pt-System$(SUFDLL) 
                                              $(PRELIB)Pt-Net$(SUFDLL) 
                                              $(PRELIB)Pt-Ssl$(SUFDLL) 
                                              $(PRELIB)Pt-Http$(SUFDLL) 
                                              $(PRELIB)Pt-Unit$(SUFDLL) 
                                              $(PRELIB)Pt-Xml$(SUFDLL) 
                                              $(PRELIB)Pt-XmlRpc$(SUFDLL) ;
