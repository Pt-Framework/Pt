SubDir PT_TOP src Pt-Gfx tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

Main Pt-Gfx-test : Pt-Gfx-test.cpp
                   BlockScaleTest.cpp
                   Argb32Test.cpp
                   Yuv12Test.cpp ;

LinkSharedLibraries Pt-Gfx-test : Pt Pt-Gfx Pt-System Pt-Unit ;
MakeLocate Pt-Gfx-test : $(PT_OUTPUT_TARGET) ;
RunUnitTest Pt-Gfx-test : $(PT_OUTPUT_TEST) ;

Main ImagePainterTest : ImagePainterTest.cpp ;
LinkSharedLibraries ImagePainterTest : Pt Pt-Gfx Pt-System ;
MakeLocate ImagePainterTest : $(PT_OUTPUT_TARGET) ;

if $(WITH_RASTERIZER2)
{
    SubDirC++Flags [ FIncludes "/usr/include/cairo" ] ;

    Main ImagePainterTest2 : ImagePainterTest2.cpp SDL_SavePNG/savepng.c ;
    LinkSharedLibraries ImagePainterTest2 : Pt Pt-Gfx Pt-System ;
    MakeLocate ImagePainterTest2 : $(PT_OUTPUT_TARGET) ;
    LinkFlags ImagePainterTest2 : -lcairo -lpng -lSDL2 -lX11 ;
}

