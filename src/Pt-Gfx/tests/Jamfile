SubDir PT_TOP src Pt-Gfx tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if $(PNG_INCLUDES)
{
    SubDirHdrs $(PNG_INCLUDES) ;
}

Main Pt-Gfx-test : Pt-Gfx-test.cpp
                   BlockScaleTest.cpp
                   Argb32Test.cpp
                   Yuv12Test.cpp 
                   ;

LinkSharedLibraries Pt-Gfx-test : Pt Pt-Gfx Pt-System Pt-Unit ;
MakeLocate Pt-Gfx-test : $(PT_OUTPUT_TARGET) ;
RunUnitTest Pt-Gfx-test : $(PT_OUTPUT_TEST) ;

Main ImagePainterTest : ImagePainterTest.cpp ;
LinkSharedLibraries ImagePainterTest : Pt Pt-Gfx Pt-System ;
MakeLocate ImagePainterTest : $(PT_OUTPUT_TARGET) ;

#######################################################################
# raster2 backend tests
#######################################################################
#WITH_EXPERIMENTAL_GFX = yes ;

if $(WITH_EXPERIMENTAL_GFX)
{
    rule FGeneric
    { return $(<) ; }

    if $(TARGET_OSPLAT:L) = arm
    {
        CPU_FLAGS = -mfpu=neon ;
       #CPU_FLAGS = ;
    }

    if $(TARGET_OSPLAT:L) = x86_64
    {
        CPU_FLAGS = -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -mavx -mavx2 -mfma ;
       #CPU_FLAGS = -msse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-fma ;
    }

    SubDirCcFlags  [ FGeneric $(CPU_FLAGS) ] ;
    SubDirC++Flags [ FGeneric $(CPU_FLAGS) ] ;

    SubDirC++Flags [ FDefines WITH_EXPERIMENTAL_GFX ] ;
    SubDirC++Flags [ FDefines 'lprintf(...)'='fprintf(stderr,__VA_ARGS__)' ] ;

    Main ImagePainterTest2 : ImagePainterTest2.cpp ;
    LinkSharedLibraries ImagePainterTest2 : Pt Pt-Gfx Pt-System ;
    MakeLocate ImagePainterTest2 : $(PT_OUTPUT_TARGET) ;

    if $(WITH_EXPERIMENTAL_GFX)
    {
        LinkFlags ImagePainterTest2 : -lSDL2 -lX11 ;
    }

    if $(WITH_BUILTIN_LIBPNG)
    {
        LinkLibraries ImagePainterTest2 : png ;
    }
    else
    {
        LinkFlags ImagePainterTest2 : $(PNG_LINKFLAGS) ;
        LinkLibs ImagePainterTest2 : $(PNG_LINKLIBS) ;
    }

    if $(WITH_BUILTIN_ZLIB)
    {
        LinkLibraries ImagePainterTest2 : $(ZLIB) ;
    }
    else
    {
        LinkFlags ImagePainterTest2 : $(ZLIB_LINKFLAGS) ;
        LinkLibs ImagePainterTest2 : $(ZLIB_LINKLIBS) ;
    }

    # pkg-config --cflags sdl2
    # pkg-config --libs sdl2
}


