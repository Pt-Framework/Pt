                              Path.cpp
                              Polygonizer.cpp
                              Polygonizer_Rect.cpp
                              Polygonizer_Ellipse.cpp
                              Polygonizer_Arc.cpp
                              Polygonizer_Polyline.cpp
                              Polygonizer_PolylineSolidOpen.cpp
                              Polygonizer_PolylineSolidClosed.cpp
                              Polygonizer_PolylineDashed.cpp
                              Polygonizer_Collision.cpp
                              Polygonizer_Cleanup.cpp
                              clipper_aj$(SLASH)clipper.cpp
                              ;

