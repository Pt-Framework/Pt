                       $(PT_GFX_NEW_RASTERIZER_FILES)
                       ;

LinkSharedLibraries Pt-Gfx : Pt Pt-System ;
MakeLocate Pt-Gfx : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Gfx : $(PT_INSTALL_LIBDIR) ;

if $(WITH_BUILTIN_LIBPNG)
{
    LinkLibraries Pt-Gfx : png ;
}
else
{
    LinkFlags Pt-Gfx : $(PNG_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(PNG_LINKLIBS) ;
}

if $(WITH_BUILTIN_LIBJPEG)
{
    LinkLibraries Pt-Gfx : jpeg ;
}
else
{
    LinkFlags Pt-Gfx : $(JPEG_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(JPEG_LINKLIBS) ;
}

if $(WITH_BUILTIN_ZLIB)
{
    LinkLibraries Pt-Gfx : $(ZLIB) ;
}
else
{
    LinkFlags Pt-Gfx : $(ZLIB_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(ZLIB_LINKLIBS) ;
}

if $(WITH_BUILTIN_FREETYPE)
{
    LinkLibraries Pt-Gfx : freetype ;
}
else
{
    LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(FREETYPE_LINKLIBS) ;
}

SubInclude PT_TOP src Pt-Gfx tests ;
