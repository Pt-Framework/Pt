SubDir TOP src Pt-Gfx ;
SubDirHdrs $(TOP)/include ;
SubDirHdrs $(FREETYPE_INCLUDES) ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;

SharedLibrary Pt-Gfx : ARgbColor.cpp
                       ARgbFColor.cpp
                       ARgb8888Color.cpp
                       Rgb888Color.cpp
                       Rgb565Color.cpp
                       Rgb555Color.cpp
                       PlanarImage.cpp
                       InterleavedImage.cpp
                       Pen.cpp
                       Brush.cpp
                       Fill.cpp
                       Font.cpp
                       FontMetrics.cpp
                       ImagePainter.cpp
                       DrawText.cpp
                       DrawThinPolyline.cpp
                       Dash.cpp
                       DrawWideSolidPolyline.cpp
                       DrawWideDashPolyline.cpp
                       DrawWidePolyline.cpp
                       FillPolygon.cpp
                       ClipPolygon.cpp
                       FreeType.cpp
                       Exception.cpp
                       DrawThinEllipse.cpp
                       DrawThickEllipse.cpp
                       FillEllipse.cpp
                       Stroke.cpp
                       ;

SharedLibrary_LinkSharedLibraries Pt-Gfx : Pt  Pt-System ;
if $(FREETYPE_LINKFLAGS)
{
    SharedLibrary_LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
}
else
{
    SharedLibrary_LinkLibraries Pt-Gfx : Pt-Gfx-freetype ;
}
SharedLibrary_MakeLocate Pt-Gfx : $(OUTPUT_TARGET) ;

Main GreyscaleTest : GreyscaleTest.cpp ;
Main_LinkSharedLibraries GreyscaleTest : Pt Pt-System  Pt-Gfx ;
Main_MakeLocate GreyscaleTest : $(OUTPUT_TARGET) ;

Main BlockscaleTest : BlockscaleTest.cpp ;
