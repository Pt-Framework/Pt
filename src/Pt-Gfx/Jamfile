LinkSharedLibraries DrawLineBenchmark : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate DrawLineBenchmark : $(OUTPUT_TARGET) ;

Main DrawRectDemo : DrawRectDemo.cpp ;
LinkSharedLibraries DrawRectDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate DrawRectDemo : $(OUTPUT_TARGET) ;

Main FillPolygonDemo : FillPolygonDemo.cpp ;
LinkSharedLibraries FillPolygonDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate FillPolygonDemo : $(OUTPUT_TARGET) ;

Main DrawEllipseDemo : DrawEllipseDemo.cpp ;
LinkSharedLibraries DrawEllipseDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate DrawEllipseDemo : $(OUTPUT_TARGET) ;

Main GfxPerf : GfxPerf.cpp ;
LinkSharedLibraries GfxPerf : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate GfxPerf : $(OUTPUT_TARGET) ;

}

PtUnitTest ImagePainterTest : ImagePainterTest.cpp ;
LinkSharedLibraries ImagePainterTest : Pt Pt-System  Pt-Gfx Pt-Unit ;
MakeLocate ImagePainterTest : $(OUTPUT_TARGET) ;

PtUnitTest PlanarImageTest : PlanarImageTest.cpp ;
LinkSharedLibraries PlanarImageTest : Pt Pt-Gfx  Pt-System Pt-Unit ;
