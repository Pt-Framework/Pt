SubDir PT_TOP src Pt-Gfx ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if $(PNG_INCLUDES)
{
    SubDirHdrs $(PNG_INCLUDES) ;
}

if $(FREETYPE_INCLUDES)
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
}

SharedLibrary Pt-Gfx : Argb8888Format.cpp
                       Brush.cpp
                       ClipPolygon.cpp
                       Color.cpp
                       DrawText.cpp
                       Exception.cpp
                       Font.cpp
                       FontMetrics.cpp
                       FreeType.cpp
#                       GraphicsPipeline.cpp          
                       Image.cpp
                       ImageFormat.cpp
                       ImagePainter.cpp
                       ImageReader.cpp
                       Pen.cpp
                       PngReader.cpp
                       Rasterizer.cpp
                       Rgb888Format.cpp
                       Rgb565Format.cpp ;

LinkSharedLibraries Pt-Gfx : Pt Pt-System ;
MakeLocate Pt-Gfx : $(PT_OUTPUT_TARGET) ;

if $(WITH_BUILTIN_FREETYPE)
{
    LinkLibraries Pt-Gfx : freetype ;
}
else
{
    LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(FREETYPE_LINKLIBS) ;
}

if $(WITH_BUILTIN_LIBPNG)
{
    LinkLibraries Pt-Gfx : png ;
}
else
{
    LinkFlags Pt-Gfx : $(PNG_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(PNG_LINKLIBS) ;
}

if $(WITH_BUILTIN_ZLIB)
{
    LinkLibraries Pt-Gfx : $(ZLIB) ;
}
else
{
    LinkFlags Pt-Gfx : $(ZLIB_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(ZLIB_LINKLIBS) ;
}