SubDir PT_TOP src Pt-Gfx ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if $(PNG_INCLUDES)
{
    SubDirHdrs $(PNG_INCLUDES) ;
}

if $(JPEG_INCLUDES)
{
    SubDirHdrs $(JPEG_INCLUDES) ;
}

if $(FREETYPE_INCLUDES)
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
}

if $(WITH_RASTERIZER2)
{
    rule FGeneric
    { return $(<) ; }

    SubDirC++Flags [ FDefines RASTERIZER2 ] ;
    SubDirC++Flags [ FDefines 'lprintf(...)'='fprintf(stderr,__VA_ARGS__)' ] ;

    if $(TARGET_OSPLAT:L) = arm
    {
        SubDirCcFlags  [ FGeneric -mfpu=neon ] ;
        SubDirC++Flags [ FGeneric -mfpu=neon ] ;
    }

    if $(TARGET_OSPLAT:L) = x86_64
    {
        SubDirCcFlags  [ FGeneric -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -mavx -mavx2 -mfma ] ;
        SubDirC++Flags [ FGeneric -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -mavx -mavx2 -mfma ] ;
        #SubDirCcFlags  [ FGeneric -msse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-fma ] ;
        #SubDirC++Flags [ FGeneric -msse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-fma ] ;
    }

    PT_GFX_RASTERIZER2_FILES = FreeType2.cpp
                               DrawText2.cpp
                               Path.cpp
                               SGNode.cpp
                               SGNodeLine.cpp
                               SGNodePath.cpp
                               SGNodeRect.cpp
                               ImagePainter2.cpp
                               Rasterizer2.cpp
                               Rasterizer2_PixelScanline.cpp
                               Rasterizer2_Line.cpp
                               Rasterizer2_PatternedLine.cpp
                               Rasterizer2_Rectangle.cpp
                               Rasterizer2_Polygon.cpp
                               Rasterizer2_Bezier.cpp
                               Rasterizer2_Arc.cpp
                               Rasterizer2_Ellipse.cpp
                               SvgReader.cpp
                               SvgRasterizer.cpp
                               SvgRasterizer_Color.cpp
                               SvgRasterizer_Lexer.cpp
                               clipper_aj$(SLASH)clipper.cpp
                               ;
}

SharedLibrary Pt-Gfx : Argb32Format.cpp
                       Brush.cpp
                       ClipPolygon.cpp
                       Color.cpp
                       DrawText.cpp
                       Font.cpp
                       FontMetrics.cpp
                       FreeType.cpp
                       Image.cpp
                       ImageFormat.cpp
                       ImagePainter.cpp
                       JpegReader.cpp
                       Pen.cpp
                       PngReader.cpp
                       Rasterizer.cpp
                       Rgb32Format.cpp
                       Rgb16Format.cpp
                       Yuv12Format.cpp
                       Painter.cpp
                       $(PT_GFX_RASTERIZER2_FILES)
                       ;

LinkSharedLibraries Pt-Gfx : Pt Pt-System ;
MakeLocate Pt-Gfx : $(PT_OUTPUT_TARGET) ;

if $(WITH_BUILTIN_LIBPNG)
{
    LinkLibraries Pt-Gfx : png ;
}
else
{
    LinkFlags Pt-Gfx : $(PNG_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(PNG_LINKLIBS) ;
}

if $(WITH_BUILTIN_LIBJPEG)
{
    LinkLibraries Pt-Gfx : jpeg ;
}
else
{
    LinkFlags Pt-Gfx : $(JPEG_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(JPEG_LINKLIBS) ;
}

if $(WITH_BUILTIN_ZLIB)
{
    LinkLibraries Pt-Gfx : $(ZLIB) ;
}
else
{
    LinkFlags Pt-Gfx : $(ZLIB_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(ZLIB_LINKLIBS) ;
}

if $(WITH_BUILTIN_FREETYPE)
{
    LinkLibraries Pt-Gfx : freetype ;
}
else
{
    LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(FREETYPE_LINKLIBS) ;
}

if $(WITH_RASTERIZER2)
{
    LinkSharedLibraries Pt-Gfx : Pt-Xml ;
}

SubInclude PT_TOP src Pt-Gfx tests ;
