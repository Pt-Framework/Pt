SubDir PT_TOP src Pt-Gfx ;

if $(WITH_BLEND2D)
{
    SubDirHdrs $(BLEND2D_INCLUDES) ;
    SubDirC++Flags $(BLEND2D_C++FLAGS) ;

    PT_GFX_IMPL = blend2d ;
}
else if $(WITH_BUILTIN_SKIA)
{
    SubDirC++Flags [ FDefines SK_SUPPORT_GPU=0 ] ;
    SubDirC++Flags [ FDefines SKSL_STANDALONE  ] ;
    SubDirC++Flags [ FDefines SK_BUILD_NO_OPTS ] ;
    SubDirC++Flags [ FDefines SK_DISABLE_EFFECT_DESERIALIZATION ] ;

    SubDirHdrs $(PT_TOP)/src/skia/include/c ;
    SubDirHdrs $(PT_TOP)/src/skia/include/codec ;
    SubDirHdrs $(PT_TOP)/src/skia/include/config ;
    SubDirHdrs $(PT_TOP)/src/skia/include/core ;
    SubDirHdrs $(PT_TOP)/src/skia/include/effects ;
    SubDirHdrs $(PT_TOP)/src/skia/include/encode ;
    SubDirHdrs $(PT_TOP)/src/skia/include/gpu ;
    SubDirHdrs $(PT_TOP)/src/skia/include/pathops ;
    SubDirHdrs $(PT_TOP)/src/skia/include/ports ;
    SubDirHdrs $(PT_TOP)/src/skia/include/private ;
    SubDirHdrs $(PT_TOP)/src/skia/include/utils ;
    SubDirHdrs $(PT_TOP)/src/skia/src/core ;
    SubDirHdrs $(PT_TOP)/src/skia/src/shaders ;

    PT_GFX_IMPL = skia ;
}
else
{
    PT_GFX_IMPL = raster ;
}

SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-Gfx/$(PT_GFX_IMPL:L) ;
SubDirHdrs $(PT_TOP)/src/Pt-Gfx/freetype ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if [ Package-Includes png ]
{
    SubDirHdrs [ Package-Includes png ] ;
}

if [ Package-Defines png ]
{
    SubDirC++Flags [ Package-Defines png ] ;
}

if [ Package-Includes jpeg ]
{
    SubDirHdrs [ Package-Includes jpeg ] ;
}

if [ Package-Defines jpeg ]
{
    SubDirC++Flags [ Package-Defines jpeg ] ;
}

if [ Package-Includes freetype ]
{
    SubDirHdrs [ Package-Includes freetype ] ;
}

if [ Package-Defines freetype ]
{
    SubDirC++Flags [ Package-Defines freetype ] ;
}

PT_GFX_IMPL_SUBDIR = [ FDirName $(PT_TOP) src Pt-Gfx $(PT_GFX_IMPL:L) ] ;
PT_GFX_IMPL_SOURCES += [ GLOB $(PT_GFX_IMPL_SUBDIR) : *.cpp  ] ;

PT_GFX_FREETYPE_SUBDIR = [ FDirName $(PT_TOP) src Pt-Gfx freetype ] ;
PT_GFX_FREETYPE_SOURCES += [ GLOB $(PT_GFX_FREETYPE_SUBDIR) : *.cpp  ] ;

PT_GFX_FORMAT_SOURCES = Argb32.cpp
                        Rgb32.cpp
                        Rgb16.cpp
                        Yuv12.cpp ;

SharedLibrary Pt-Gfx : $(PT_GFX_IMPL_SOURCES)
                       $(PT_GFX_FREETYPE_SOURCES)
                       $(PT_GFX_FORMAT_SOURCES)
                       Bitmap.cpp
                       Brush.cpp
                       Canvas.cpp
                       Color.cpp
                       Font.cpp
                       FontFace.cpp
                       FontProvider.cpp
                       FontRegistry.cpp
                       FontMetrics.cpp
                       Image.cpp
                       ImageFormat.cpp
                       JpegReader.cpp
                       Paint.cpp
                       Painter.cpp
                       PainterBase.cpp
                       PaintContext.cpp
                       PaintSurface.cpp
                       Path.cpp
                       Pen.cpp
                       PngReader.cpp
                       PngWriter.cpp
                       TextMetrics.cpp
                       Transform.cpp ;

LinkSharedLibraries Pt-Gfx : Pt Pt-System ;
MakeLocate Pt-Gfx : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Gfx : $(PT_INSTALL_LIBDIR) ;

if $(WITH_BUILTIN_SKIA)
{
    LinkLibraries Pt-Gfx : skia ;
}

if $(WITH_BLEND2D_BUILTIN)
{
    LinkLibraries Pt-Gfx : blend2d ;
}

if [ Package-Target png ]
{
    LinkLibraries Pt-Gfx : [ Package-Target png ] ;
}

LinkLibs Pt-Gfx : [ Package-LinkLibs png ] ;
LinkFlags Pt-Gfx : [ FLibPath [ Package-LibDir png ] ]
                   [ Package-LinkFlags png ] ;

if [ Package-Target jpeg ]
{
    LinkLibraries Pt-Gfx : [ Package-Target jpeg ] ;
}

LinkLibs Pt-Gfx : [ Package-LinkLibs jpeg ] ;
LinkFlags Pt-Gfx : [ FLibPath [ Package-LibDir jpeg ] ]
                   [ Package-LinkFlags jpeg ] ;

if [ Package-Target freetype ]
{
    LinkLibraries Pt-Gfx : [ Package-Target freetype ] ;
}

LinkLibs Pt-Gfx : [ Package-LinkLibs freetype ] ;
LinkFlags Pt-Gfx : [ FLibPath [ Package-LibDir freetype ] ]
                   [ Package-LinkFlags freetype ] ;

SubInclude PT_TOP src Pt-Gfx tests ;
