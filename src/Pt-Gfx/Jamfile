SubDir PT_TOP src Pt-Gfx ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if $(FREETYPE_INCLUDES)
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
}

SharedLibrary Pt-Gfx : ARgbColor.cpp
                       ARgbFColor.cpp
                       ARgb8888Color.cpp
                       Rgb888Color.cpp
                       Rgb565Color.cpp
                       Rgb555Color.cpp
                       PlanarImage.cpp
                       InterleavedImage.cpp
                       Pen.cpp
                       Brush.cpp
                       Fill.cpp
                       Font.cpp
                       FontMetrics.cpp
                       ImagePainter.cpp
                       DrawText.cpp
                       DrawThinPolyline.cpp
                       Dash.cpp
                       DrawWideSolidPolyline.cpp
                       DrawWideDashPolyline.cpp
                       DrawWidePolyline.cpp
                       FillPolygon.cpp
                       ClipPolygon.cpp
                       FreeType.cpp
                       Exception.cpp
                       DrawThinEllipse.cpp
                       DrawThickEllipse.cpp
                       FillEllipse.cpp
                       Stroke.cpp
                       ;

LinkSharedLibraries Pt-Gfx : Pt ;
MakeLocate Pt-Gfx : $(PT_OUTPUT_TARGET) ;

if $(FREETYPE_LINKFLAGS)
{
    LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
    LinkLibs Pt-Gfx : $(FREETYPE_LINKLIBS) ;
}
else
{
    LinkLibraries Pt-Gfx : Pt-Gfx-freetype ;
}

if $(GUI)
{
    Main ImagePainterDemo : ImagePainterDemo.cpp ;
    LinkSharedLibraries ImagePainterDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate ImagePainterDemo : $(PT_OUTPUT_TARGET) ;

    Main DrawLineDemo : DrawLineDemo.cpp ;
    LinkSharedLibraries DrawLineDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate DrawLineDemo : $(PT_OUTPUT_TARGET) ;

    Main DrawLineBenchmark : DrawLineBenchmark.cpp ;
    LinkSharedLibraries DrawLineBenchmark : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate DrawLineBenchmark : $(PT_OUTPUT_TARGET) ;

    Main DrawRectDemo : DrawRectDemo.cpp ;
    LinkSharedLibraries DrawRectDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate DrawRectDemo : $(PT_OUTPUT_TARGET) ;

    Main FillPolygonDemo : FillPolygonDemo.cpp ;
    LinkSharedLibraries FillPolygonDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate FillPolygonDemo : $(PT_OUTPUT_TARGET) ;

    Main DrawEllipseDemo : DrawEllipseDemo.cpp ;
    LinkSharedLibraries DrawEllipseDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate DrawEllipseDemo : $(PT_OUTPUT_TARGET) ;

    Main GfxPerf : GfxPerf.cpp ;
    LinkSharedLibraries GfxPerf : Pt Pt-System  Pt-Gfx Pt-Gui ;
    MakeLocate GfxPerf : $(PT_OUTPUT_TARGET) ;
}

Main GreyscaleTest : GreyscaleTest.cpp ;
LinkSharedLibraries GreyscaleTest : Pt Pt-Gfx ;
MakeLocate GreyscaleTest : $(PT_OUTPUT_TARGET) ;

Main BlockscaleTest : BlockscaleTest.cpp ;
LinkSharedLibraries BlockscaleTest : Pt Pt-Gfx ;
MakeLocate BlockscaleTest : $(PT_OUTPUT_TARGET) ;

Main ImagePainterTest : ImagePainterTest.cpp ;
LinkSharedLibraries ImagePainterTest : Pt Pt-Gfx Pt-Unit ;
MakeLocate ImagePainterTest : $(PT_OUTPUT_TARGET) ;
RunUnitTest ImagePainterTest : $(PT_OUTPUT_TEST) ;

Main PlanarImageTest : PlanarImageTest.cpp ;
LinkSharedLibraries PlanarImageTest : Pt Pt-Gfx Pt-Unit ;
MakeLocate PlanarImageTest : $(PT_OUTPUT_TARGET) ;
RunUnitTest PlanarImageTest : $(PT_OUTPUT_TEST) ;

Main MakeFontHeader : MakeFontHeader.cpp ;
MakeLocate MakeFontHeader : $(PT_OUTPUT_TARGET) ;

Main ColorTest : ColorTest.cpp ;
LinkSharedLibraries ColorTest : Pt Pt-Gfx ;
MakeLocate ColorTest : $(PT_OUTPUT_TARGET) ;

Main ImageTest : ImageTest.cpp ;
LinkSharedLibraries ImageTest : Pt Pt-Gfx ;
MakeLocate ImageTest : $(PT_OUTPUT_TARGET) ;

if ! $(FREETYPE_LINKFLAGS)
{
    SubInclude PT_TOP src Pt-Gfx freetype ;
}
