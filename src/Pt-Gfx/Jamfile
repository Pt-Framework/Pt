SubDir TOP src Pt-Gfx ;
SubDirHdrs $(TOP)/include ;
SubDirHdrs $(FREETYPE_INCLUDES) ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Gfx ;

SharedLibrary Pt-Gfx : ARgbColor.cpp
                       ARgbFColor.cpp
                       ARgb8888Color.cpp
                       Rgb888Color.cpp
                       Rgb565Color.cpp
                       Rgb555Color.cpp
                       PlanarImage.cpp
                       InterleavedImage.cpp
                       Pen.cpp
                       Brush.cpp
                       Fill.cpp
                       Font.cpp
                       FontMetrics.cpp
                       ImagePainter.cpp
                       DrawText.cpp
                       DrawThinPolyline.cpp
                       Dash.cpp
                       DrawWideSolidPolyline.cpp
                       DrawWideDashPolyline.cpp
                       DrawWidePolyline.cpp
                       FillPolygon.cpp
                       ClipPolygon.cpp
                       FreeType.cpp
                       Exception.cpp
                       DrawThinEllipse.cpp
                       DrawThickEllipse.cpp
                       FillEllipse.cpp
                       Stroke.cpp
                       ;

LinkSharedLibraries Pt-Gfx : Pt  Pt-System ;
if $(FREETYPE_LINKFLAGS)
{
    LinkFlags Pt-Gfx : $(FREETYPE_LINKFLAGS) ;
}
else
{
    LinkLibraries Pt-Gfx : Pt-Gfx-freetype ;
}
MakeLocate Pt-Gfx : $(OUTPUT_TARGET) ;

Main GreyscaleTest : GreyscaleTest.cpp ;
LinkSharedLibraries GreyscaleTest : Pt Pt-System  Pt-Gfx ;
MakeLocate GreyscaleTest : $(OUTPUT_TARGET) ;

Main BlockscaleTest : BlockscaleTest.cpp ;
LinkSharedLibraries BlockscaleTest : Pt Pt-System  Pt-Gfx ;
MakeLocate BlockscaleTest : $(OUTPUT_TARGET) ;

if $(GUI) != none
{
Main ImagePainterDemo : ImagePainterDemo.cpp ;
LinkSharedLibraries ImagePainterDemo : Pt Pt-System  Pt-Gfx Pt-Gui ;
MakeLocate ImagePainterDemo : $(OUTPUT_TARGET) ;

