SubDir PT_TOP src Pt-Gfx ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_GFX_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Gfx ;

if $(PNG_INCLUDES)
{
    SubDirHdrs $(PNG_INCLUDES) ;
}

if $(JPEG_INCLUDES)
{
    SubDirHdrs $(JPEG_INCLUDES) ;
}

if $(FREETYPE_INCLUDES)
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
}

# Aloysius' personal tester flag
WITH_EXPERIMENTAL_GFX = yes ;

if $(WITH_EXPERIMENTAL_GFX)
{
    rule FGeneric
    { return $(<) ; }

    if $(TARGET_OSPLAT:L) = arm
    {
        CPU_FLAGS = -mfpu=neon ;
        #-O3 -mcpu=cortex-a9 -mfpu=neon-fp16 -mfloat-abi=hard
    }

    if $(TARGET_OSPLAT:L) = x86_64
    {
        CPU_FLAGS = -std=c++11 -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -mno-avx -mno-avx2 -mno-fma -Wno-narrowing ;
    }

    SubDirCcFlags  [ FGeneric $(CPU_FLAGS) ] ;
    SubDirC++Flags [ FGeneric $(CPU_FLAGS) ] ;

    SubDirC++Flags [ FDefines WITH_EXPERIMENTAL_GFX ] ;
    SubDirC++Flags [ FDefines 'lprintf(...)'='fprintf(stderr,__VA_ARGS__)' ] ;
}

