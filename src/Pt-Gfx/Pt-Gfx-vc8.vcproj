	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="..\..\bin"
			IntermediateDirectory="..\..\tmp\nt\x86\le\vc8\$(ConfigurationName)"
			ConfigurationType="0"
			BuildLogFile="$(IntDir)\$(TargetName).htm"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=$(ConfigurationName) $(TargetFileName) -q"
				ReBuildCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=$(ConfigurationName) $(TargetName)  -a"
				CleanCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=$(ConfigurationName) clean"
				Output="$(OutDir)\Pt-Gfxd.dll"
				PreprocessorDefinitions="WIN32;_DEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
		</Configuration>
