SubDir freetype.TOP ;

SubDirHdrs [ Package-Includes freetype ] ;
SubDirCcFlags [ Package-Defines freetype ] ;
SubDirCcFlags [ FDefines FT2_BUILD_LIBRARY ] ;
SubDirCcFlags [ FDefines FT_CONFIG_OPTION_SYSTEM_ZLIB ] ;
SubDirCcFlags [ FDefines _CRT_SECURE_NO_WARNINGS ] ;

if [ Builtin-Get freetype : OUTPUT_OBJECT ]
{
    SubDirObjects [ Builtin-Get freetype : OUTPUT_OBJECT ] freetype ;
}

