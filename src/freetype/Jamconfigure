# Included by Builtin-Configure after freetype.TOP is set.

Package-SetIncludes freetype : [ FDirName [ Builtin-Top freetype ] include ]
                                [ Package-Includes zlib ] ;
Package-SetDefines freetype : [ Package-Defines zlib ] ;
Package-SetTarget freetype : freetype ;
Package-SetLinkLibs freetype : [ Package-LinkLibs zlib ] ;
Package-SetLibDir freetype : [ Package-LibDir zlib ] ;
Package-SetLinkFlags freetype : [ Package-LinkFlags zlib ] ;

if [ Package-Target zlib ]
{
    freetype.TARGET += [ Package-Target zlib ] ;
}
