SharedLibrary_MakeLocate Pt-Gui : bin ;

Main ScribbleClassic : ScribbleClassic.cpp ;
Main_LinkSharedLibraries ScribbleClassic : Pt-Gui Pt-Gfx Pt-System Pt-IO Pt ;
