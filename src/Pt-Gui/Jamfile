SubDir TOP src Pt-Gui ;
SubDirHdrs $(TOP)/include ;
SubDirHdrs $(TOP)/src/Pt-Gui/$(GUI:L) ;
SubDirHdrs $(TOP)/src/Pt-System ;
SubDirC++Flags [ FDefines PT_GUI_API_EXPORT ] ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Gui ;

if $(GUI:L) = x11
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
    SubDirHdrs $(X11_INCLUDES) ;
    SubDirHdrs $(XFT_INCLUDES) ;
}

PT_GUI_SUBDIR = [ FDirName $(TOP) src Pt-Gui $(GUI:L) ] ;
PT_GUI_IMPL += [ GLOB $(PT_GUI_SUBDIR) : *.cpp  ] ;
PT_GUI_IMPL += [ GLOB $(PT_GUI_SUBDIR) : *.mm  ] ;

SharedLibrary Pt-Gui :  Application.cpp
                        Pixmap.cpp
                        Widget.cpp
                        CloseEvent.cpp
                        Button.cpp
                        Event.cpp
                        HorizontalLayout.cpp
                        ImageButton.cpp
                        KeyEvent.cpp
                        Label.cpp
                        LayoutManager.cpp
                        NullLayout.cpp
                        MouseEvent.cpp
                        MouseMoveEvent.cpp
                        MoveEvent.cpp
                        PaintEvent.cpp
                        Painter.cpp
                        Panel.cpp
                        ProgressBar.cpp
                        ResizeEvent.cpp
                        BorderLayout.cpp
                        SimpleGridLayout.cpp
                        VerticalLayout.cpp 
                        $(PT_GUI_IMPL) ;
LinkSharedLibraries Pt-Gui : Pt Pt-System Pt-Gfx  ;
LinkLibs Pt-Gui : $(GUILIBS) ;
MakeLocate Pt-Gui : $(OUTPUT_TARGET) ;

Main WidgetDemo : WidgetDemo.cpp ;
LinkSharedLibraries WidgetDemo : Pt Pt-System Pt-Gfx Pt-Gui  ;
MakeLocate WidgetDemo : $(OUTPUT_TARGET) ;

Main GuiDemo : GuiDemo.cpp ;
LinkSharedLibraries GuiDemo : Pt Pt-System Pt-Gfx Pt-Gui  ;
MakeLocate GuiDemo : $(OUTPUT_TARGET) ;

Main Scribble : Scribble.cpp ;
LinkSharedLibraries Scribble : Pt Pt-System Pt-Gfx Pt-Gui  ;
MakeLocate Scribble : $(OUTPUT_TARGET) ;