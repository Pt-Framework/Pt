SubDir TOP src Pt-Gui ;

SubDirHdrs $(TOP)/include ;
SubDirHdrs $(TOP)/src/Pt-Gui/$(GUI:L) ;

SharedLibrary Pt-Gui :  Application.cpp
                        Pixmap.cpp
                        Widget.cpp
                        CloseEvent.cpp
                        Button.cpp
                        Event.cpp
                        HorizontalLayout.cpp
                        KeyEvent.cpp
                        Label.cpp
                        LayoutManager.cpp
                        NullLayout.cpp
                        MouseEvent.cpp
                        MouseMoveEvent.cpp
                        MoveEvent.cpp
                        PaintEvent.cpp
                        Painter.cpp
                        Panel.cpp
                        ResizeEvent.cpp
                        SimpleGridLayout.cpp
                        VerticalLayout.cpp
                       ;

SharedLibrary_LinkLibraries Pt-Gui : Pt-Gui-$(GUI:L) ;
SharedLibrary_LinkSharedLibraries Pt-Gui : Pt Pt-System Pt-Gfx ;
SharedLibrary_AddLibraries Pt-Gui : $(GUILIBS) ;
SharedLibrary_MakeLocate Pt-Gui : bin ;

Main Scribble : Scribble.cpp ;
Main_LinkSharedLibraries Scribble : Pt Pt-System Pt-IO Pt-Gfx Pt-Gui ;
Main_MakeLocate Scribble : bin ;

SubInclude TOP src Pt-Gui $(GUI:L) ;
