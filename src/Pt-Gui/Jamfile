SubDir TOP src Pt-Gui ;
SubDirHdrs $(TOP)/include ;
SubDirHdrs $(TOP)/src/Pt-Gui/$(GUI:L) ;
SubDirC++Flags [ FDefines PT_GUI_API_EXPORT ] ;

SharedLibrary Pt-Gui :  Application.cpp
                        Pixmap.cpp
                        Widget.cpp
                        CloseEvent.cpp
                        Button.cpp
                        Event.cpp
                        HorizontalLayout.cpp
                        ImageButton.cpp
                        KeyEvent.cpp
                        Label.cpp
                        LayoutManager.cpp
                        NullLayout.cpp
                        MouseEvent.cpp
                        MouseMoveEvent.cpp
                        MoveEvent.cpp
                        PaintEvent.cpp
                        Painter.cpp
                        Panel.cpp
                        ProgressBar.cpp
                        ResizeEvent.cpp
                        BorderLayout.cpp
                        SimpleGridLayout.cpp
                        VerticalLayout.cpp
                       ;
SharedLibrary_LinkLibraries Pt-Gui : Pt-Gui-$(GUI:L) ;
SharedLibrary_LinkSharedLibraries Pt-Gui : Pt Pt-System Pt-Gfx  ;
LINKLIBS on $(PRELIB)Pt-Gui$(SUFDLL) = $(LINKLIBS) $(GUILIBS) ;
SharedLibrary_MakeLocate Pt-Gui : $(OUTPUT_TARGET) ;

Main WidgetDemo : WidgetDemo.cpp ;
Main_LinkSharedLibraries WidgetDemo : Pt Pt-System Pt-Gfx Pt-Gui  ;
Main_MakeLocate WidgetDemo : $(OUTPUT_TARGET) ;

Main Scribble : Scribble.cpp ;
Main_LinkSharedLibraries Scribble : Pt Pt-System Pt-Gfx Pt-Gui  ;
Main_MakeLocate Scribble : $(OUTPUT_TARGET) ;

SubInclude TOP src Pt-Gui $(GUI:L) ;
