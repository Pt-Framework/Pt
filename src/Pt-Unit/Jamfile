SubDir TOP src Pt-Unit ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_UNIT_API_EXPORT ] ;

PT_UNIT_SOURCES = Application.cpp
                  Assertion.cpp
                  RegisterTest.cpp
                  Reporter.cpp
                  Test.cpp
                  TestCase.cpp
                  TestContext.cpp
                  TestProtocol.cpp
                  TextProtocol.cpp
                  TestSuite.cpp
                 ;

SharedLibrary Pt-Unit : $(PT_UNIT_SOURCES) ;
SharedLibrary_LinkSharedLibraries Pt-Unit : Pt Pt-System ;
SharedLibrary_MakeLocate Pt-Unit : $(OUTPUT_TARGET) ;

# Define a pseudo target to call from projects
NOTFILE Pt-Unit-all ;
DEPENDS Pt-Unit-all : Pt-Unit
                      ;
