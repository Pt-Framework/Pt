SubDir PT_TOP src blend2d ;
SubDirObjects $(PT_OUTPUT_OBJECT) blend2d ;
SubDirC++Flags $(BLEND2D_C++FLAGS) ;

BLEND2D_SOURCES_DIR = [ FDirName $(PT_TOP) src blend2d src blend2d ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_SOURCES_DIR) : *.cpp ] ;

BLEND2D_CODEC_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) codec ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_CODEC_DIR) : *.cpp ] ;

BLEND2D_COMPRESS_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) compression ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_COMPRESS_DIR) : *.cpp ] ;

BLEND2D_OPENTYPE_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) opentype ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_OPENTYPE_DIR) : *.cpp ] ;

BLEND2D_PIPELINE_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) pipeline ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_PIPELINE_DIR) : *.cpp ] ;

BLEND2D_PIPELINE_REFERENCE_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) pipeline reference ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_PIPELINE_REFERENCE_DIR) : *.cpp ] ;

BLEND2D_PIXELOPS_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) pixelops ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_PIXELOPS_DIR) : *.cpp ] ;

BLEND2D_RASTER_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) raster ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_RASTER_DIR) : *.cpp ] ;

BLEND2D_SIMD_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) simd ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_SIMD_DIR) : *.cpp ] ;

BLEND2D_SUPPORT_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) support ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_SUPPORT_DIR) : *.cpp ] ;

BLEND2D_TABLES_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) tables ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_TABLES_DIR) : *.cpp ] ;

BLEND2D_THREADING_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) threading ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_THREADING_DIR) : *.cpp ] ;

BLEND2D_UNICODE_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) unicode ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_UNICODE_DIR) : *.cpp ] ;

Library blend2d : $(BLEND2D_SOURCES) ;
MakeLocate blend2d : $(PT_OUTPUT_TARGET) ;
