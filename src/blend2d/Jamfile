BLEND2D_SUPPORT_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) support ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_SUPPORT_DIR) : *.cpp ] ;

BLEND2D_TABLES_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) tables ] ;
BLEND2D_SOURCES += [ GLOB $(BLEND2D_TABLES_DIR) : *.cpp ] ;

BLEND2D_THREADING_DIR = [ FDirName $(BLEND2D_SOURCES_DIR) threading ] ;
