SubDir PT_TOP src Pt-Ssl tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Ssl ;

Main Pt-Ssl-test : Pt-Ssl-test.cpp
                   ContextTest.cpp
                   StreamBufferTest.cpp
                   ;
LinkSharedLibraries Pt-Ssl-test : Pt Pt-Net Pt-Ssl Pt-System Pt-Unit ;
MakeLocate Pt-Ssl-test : $(OUTPUT_TARGET) ;
RunUnitTest Pt-Ssl-test : $(OUTPUT_TEST) ;

Main SSLServerClientTest : SSLServerClientTest.cpp ;
