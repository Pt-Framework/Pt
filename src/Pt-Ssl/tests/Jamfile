SubDir PT_TOP src Pt-Ssl tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Ssl ;

PT_SSL_TEST_SOURCES = Pt-Ssl-test.cpp
                   CertificateStoreTest.cpp
                   ContextTest.cpp
                   StreamBufferTest.cpp ;

Main Pt-Ssl-test : $(PT_SSL_TEST_SOURCES) ;
LinkSharedLibraries Pt-Ssl-test : Pt Pt-Net Pt-Ssl Pt-System Pt-Unit ;
MakeLocate Pt-Ssl-test : $(PT_OUTPUT_TARGET) ;
RunUnitTest Pt-Ssl-test : $(PT_OUTPUT_TEST) ;

Main SslClientDemo : SslClientDemo.cpp ;
LinkSharedLibraries SslClientDemo : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SslClientDemo : $(PT_OUTPUT_TARGET) ;
