SharedLibrary Pt-Ssl : CertificateList.cpp
                       Client.cpp
                       CipherList.cpp
                       Context.cpp
                       PrivateKey.cpp
                       PublicKey.cpp
                       Server.cpp
                       Session.cpp
                       SslError.cpp
                       StreamBuffer.cpp
                       Utils.cpp ;

LinkSharedLibraries Pt-Ssl : Pt Pt-Net Pt-System ;
MakeLocate Pt-Ssl : $(OUTPUT_TARGET) ;

if $(OPENSSL_LINKLIBS)
{
    LinkFlags Pt-Ssl : $(OPENSSL_LINKFLAGS) ;
    LinkLibs Pt-Ssl : $(OPENSSL_LINKLIBS) ;
}
else
{
    LinkLibraries Pt-Ssl : Pt-Ssl-openssl ;
}



Main SSLHTTPServerTest : SSLHTTPServerTest.cpp ;
LinkSharedLibraries SSLHTTPServerTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLHTTPServerTest : $(OUTPUT_TARGET) ;

Main SSLHTTPServerClientTest : SSLHTTPServerClientTest.cpp ;
LinkSharedLibraries SSLHTTPServerClientTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLHTTPServerClientTest : $(OUTPUT_TARGET) ;

File [ FDirName $(OUTPUT_TARGET) ca.pem         ] : cert$(SLASH)ca.pem         ;
File [ FDirName $(OUTPUT_TARGET) client.pem     ] : cert$(SLASH)client.pem     ;
File [ FDirName $(OUTPUT_TARGET) client.key     ] : cert$(SLASH)client.key     ;
File [ FDirName $(OUTPUT_TARGET) server.pem     ] : cert$(SLASH)server.pem     ;
File [ FDirName $(OUTPUT_TARGET) server.key     ] : cert$(SLASH)server.key     ;
File [ FDirName $(OUTPUT_TARGET) dsakey1.pem    ] : cert$(SLASH)dsakey1.pem    ;
File [ FDirName $(OUTPUT_TARGET) dsapubkey1.pem ] : cert$(SLASH)dsapubkey1.pem ;

