SubDir PT_TOP src Pt-Ssl ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-Ssl/openssl/include ;
SubDirC++Flags [ FDefines PT_SSL_API_EXPORT ] ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Ssl ;

SharedLibrary Pt-Ssl : CipherInfo.cpp
                       SSLPublicKey.cpp
                       SSLPrivateKey.cpp
                       SSLCertificateList.cpp
                       SSLContext.cpp
                       SSLStreamBuf.cpp
                       SSLServer.cpp
                       SSLClient.cpp
                       SslError.cpp
                       SSLSession.cpp
                       Utils.cpp ;

LinkSharedLibraries Pt-Ssl : Pt Pt-Net Pt-System ;
LinkLibraries Pt-Ssl : Pt-Ssl-openssl ;
MakeLocate Pt-Ssl : $(OUTPUT_TARGET) ;

Main SSLServerClientTest : SSLServerClientTest.cpp ;
LinkSharedLibraries SSLServerClientTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLServerClientTest : $(OUTPUT_TARGET) ;

Main SSLHTTPClientTest : SSLHTTPClientTest.cpp ;
LinkSharedLibraries SSLHTTPClientTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLHTTPClientTest : $(OUTPUT_TARGET) ;

Main SSLHTTPServerTest : SSLHTTPServerTest.cpp ;
LinkSharedLibraries SSLHTTPServerTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLHTTPServerTest : $(OUTPUT_TARGET) ;

Main SSLHTTPServerClientTest : SSLHTTPServerClientTest.cpp ;
LinkSharedLibraries SSLHTTPServerClientTest : Pt-Ssl Pt-Net Pt-System Pt ;
MakeLocate SSLHTTPServerClientTest : $(OUTPUT_TARGET) ;

if $(TARGET_OS) = "nt"
{
    if $(MINGW) || $(TOOLSET) = "gcc"
    {
        LINKLIBS on $(PRELIB)Pt-Ssl$(SUFDLL) += -luser32 -lgdi32 -ladvapi32 -lws2_32 ;
    }
    else
    {
        LINKLIBS on $(PRELIB)Pt-Ssl$(SUFDLL) += user32.lib gdi32.lib advapi32.lib ws2_32.lib ;
    }
}

File [ FDirName $(OUTPUT_TARGET) ca.pem         ] : cert$(SLASH)ca.pem         ;
File [ FDirName $(OUTPUT_TARGET) client.pem     ] : cert$(SLASH)client.pem     ;
File [ FDirName $(OUTPUT_TARGET) client.key     ] : cert$(SLASH)client.key     ;
File [ FDirName $(OUTPUT_TARGET) server.pem     ] : cert$(SLASH)server.pem     ;
File [ FDirName $(OUTPUT_TARGET) server.key     ] : cert$(SLASH)server.key     ;
File [ FDirName $(OUTPUT_TARGET) dsakey1.pem    ] : cert$(SLASH)dsakey1.pem    ;
File [ FDirName $(OUTPUT_TARGET) dsapubkey1.pem ] : cert$(SLASH)dsapubkey1.pem ;

SubInclude PT_TOP src Pt-Ssl openssl ;
SubInclude PT_TOP src Pt-Ssl tests ;
