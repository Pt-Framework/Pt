SubDir PT_TOP src Pt-Ssl ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines NOCRYPT ] ;
SubDirC++Flags [ FDefines PT_SSL_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Ssl ;

if [ Packages-Includes openssl ]
{
    SubDirHdrs [ Packages-Includes openssl ] ;
}
else if $(SSL_INCLUDES)
{
    SubDirHdrs $(SSL_INCLUDES) ;
}

if [ Packages-Defines openssl ]
{
    SubDirC++Flags [ Packages-Defines openssl ] ;
}

PT_SSL_SUBDIR = [ FDirName $(PT_TOP) src Pt-Ssl $(PT_SSL_IMPL) ] ;
SubDirHdrs $(PT_SSL_SUBDIR) ;

PT_SSL_SOURCES = [ GLOB $(PT_SSL_SUBDIR) : *.cpp  ] ;

SharedLibrary Pt-Ssl : $(PT_SSL_SOURCES)
                       Certificate.cpp
                       CertificateStore.cpp
                       Context.cpp
                       SslError.cpp
                       StreamBuffer.cpp ;

LinkSharedLibraries Pt-Ssl : Pt Pt-Net Pt-System ;
MakeLocate Pt-Ssl : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Ssl : $(PT_INSTALL_LIBDIR) ;

if [ Packages-Target openssl ]
{
    LinkLibraries Pt-Ssl : [ Packages-Target openssl ] ;
}
else if $(WITH_MBEDTLS)
{
    LinkLibraries Pt-Ssl : mbedtls ;
}

LinkLibs Pt-Ssl : [ Packages-LinkLibs openssl ] ;
LinkFlags Pt-Ssl : [ FLibPath [ Packages-LibDir openssl ] ]
                   [ Packages-LinkFlags openssl ] ;

if $(SSL_LINKLIBS)
{
    LinkLibs Pt-Ssl : $(SSL_LINKLIBS) ;
}

if $(SSL_LINKFLAGS)
{
    LinkFlags Pt-Ssl : $(SSL_LINKFLAGS) ;
}

if $(WITH_SSL)
{
    SubInclude PT_TOP src Pt-Ssl tests ;
}
