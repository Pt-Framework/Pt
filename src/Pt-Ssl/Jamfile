SubDir PT_TOP src Pt-Ssl ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines NOCRYPT ] ;
SubDirC++Flags [ FDefines PT_SSL_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Ssl ;

if $(OPENSSL_INCLUDES)
{
    SubDirHdrs $(OPENSSL_INCLUDES) ;
}

SharedLibrary Pt-Ssl : CertificateList.cpp
                       CipherList.cpp
                       Context.cpp
                       IOBuffer.cpp
                       #PrivateKey.cpp
                       #PublicKey.cpp
                       #Session.cpp
                       SslError.cpp
                       StreamBuffer.cpp ;

LinkSharedLibraries Pt-Ssl : Pt Pt-Net Pt-System ;
MakeLocate Pt-Ssl : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Ssl : $(PT_INSTALL_LIBDIR) ;

if $(OPENSSL_LINKLIBS)
{
    LinkFlags Pt-Ssl : $(OPENSSL_LINKFLAGS) ;
    LinkLibs Pt-Ssl : $(OPENSSL_LINKLIBS) ;
}
else
{
    LinkLibraries Pt-Ssl : Pt-Ssl-openssl ;
}

SubInclude PT_TOP src Pt-Ssl tests ;