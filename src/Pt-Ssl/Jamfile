SubDir PT_TOP src Pt-Ssl ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines NOCRYPT ] ;
SubDirC++Flags [ FDefines PT_SSL_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Ssl ;

if $(PT_SSL_IMPL) = openssl
{
    if [ Package-Includes openssl ]
    {
        SubDirHdrs [ Package-Includes openssl ] ;
    }

    if [ Package-Defines openssl ]
    {
        SubDirC++Flags [ Package-Defines openssl ] ;
    }
}
else if $(PT_SSL_IMPL) = mbedtls
{
    if [ Package-Includes mbedtls ]
    {
        SubDirHdrs [ Package-Includes mbedtls ] ;
    }

    if [ Package-Defines mbedtls ]
    {
        SubDirC++Flags [ Package-Defines mbedtls ] ;
    }
}

PT_SSL_SUBDIR = [ FDirName $(PT_TOP) src Pt-Ssl $(PT_SSL_IMPL) ] ;
SubDirHdrs $(PT_SSL_SUBDIR) ;

PT_SSL_SOURCES = [ GLOB $(PT_SSL_SUBDIR) : *.cpp  ] ;

SharedLibrary Pt-Ssl : $(PT_SSL_SOURCES)
                       Certificate.cpp
                       CertificateStore.cpp
                       Context.cpp
                       SslError.cpp
                       StreamBuffer.cpp ;

LinkSharedLibraries Pt-Ssl : Pt Pt-Net Pt-System ;
MakeLocate Pt-Ssl : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Ssl : $(PT_INSTALL_LIBDIR) ;

if $(PT_SSL_IMPL) = openssl
{
    if [ Package-Target openssl ]
    {
        LinkLibraries Pt-Ssl : [ Package-Target openssl ] ;
    }

    LinkLibs Pt-Ssl : [ Package-LinkLibs openssl ] ;
    LinkFlags Pt-Ssl : [ FLibPath [ Package-LibDir openssl ] ]
                       [ Package-LinkFlags openssl ] ;
}
else if $(PT_SSL_IMPL) = mbedtls
{
    if [ Package-Target mbedtls ]
    {
        LinkLibraries Pt-Ssl : [ Package-Target mbedtls ] ;
    }

    LinkLibs Pt-Ssl : [ Package-LinkLibs mbedtls ] ;
    LinkFlags Pt-Ssl : [ FLibPath [ Package-LibDir mbedtls ] ]
                       [ Package-LinkFlags mbedtls ] ;
}

if $(WITH_SSL)
{
    SubInclude PT_TOP src Pt-Ssl tests ;
}
