<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Remote|x64'">
    <MIMode>lldb</MIMode>
    <DebuggerFlavor>LinuxDebugger</DebuggerFlavor>
    <RemoteDebuggerCommand>./build/debug/Pt-test</RemoteDebuggerCommand>
    <RemoteGDBPath>/usr/local/bin/lldb-mi</RemoteGDBPath>
    <RemoteDebuggingMode>gdb</RemoteDebuggingMode>
  </PropertyGroup>
</Project>