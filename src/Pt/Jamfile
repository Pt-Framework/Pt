SubDir PT_TOP src Pt ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_API_EXPORT ] [ FDefines $(PT_ATOMICS_DEFINES) ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt ;

if $(ZLIB_INCLUDES)
{
    SubDirHdrs $(ZLIB_INCLUDES) ;
}

SharedLibrary Pt : Atomicity.cpp
                   Connection.cpp
                   Connectable.cpp
                   ConversionError.cpp
                   Date.cpp
                   DateTime.cpp
                   Deserializer.cpp
                   IOError.cpp
                   PageAllocator.cpp
                   PoolAllocator.cpp
                   Regex.cpp
                   regexp.cpp
                   SerializationError.cpp
                   SerializationInfo.cpp
                   Serializer.cpp
                   SerializationContext.cpp
                   Settings.cpp
                   SettingsReader.cpp
                   SettingsWriter.cpp
                   Signal.cpp
                   String.cpp
                   StringStream.cpp
                   TextBuffer.cpp
                   TextStream.cpp
                   Time.cpp
                   Utf8.cpp
                   Utf8Codec.cpp
                   Utf16Codec.cpp
                   Utf32Codec.cpp
                   Latin1Codec.cpp
                   ZBuffer.cpp
                   #fmt/format.cc    ### EXPERIMENT ###
                   #fmt/ostream.cc   ### EXPERIMENT ###
                   #fmt/posix.cc     ### EXPERIMENT ###
                   #fmt/printf.cc    ### EXPERIMENT ###
                   ;

MakeLocate Pt : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt : $(PT_INSTALL_LIBDIR) ;

if $(WITH_BUILTIN_ZLIB)
{
    LinkLibraries Pt : $(ZLIB) ;
}
else
{
    LinkFlags Pt : $(ZLIB_LINKFLAGS) ;
    LinkLibs Pt : $(ZLIB_LINKLIBS) ;
}

