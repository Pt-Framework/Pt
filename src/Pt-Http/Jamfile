                        ServerImpl.cpp
                        Service.cpp
                        Servlet.cpp
                        Channel.cpp
                        Stream.cpp
                        WebSocket.cpp
                        WebSocketChannel.cpp
                        WebSocketMessage.cpp
                        WebSocketResponder.cpp
                        WebSocketService.cpp
                        WebSocketServlet.cpp
                        WebSocketSession.cpp
                        Sha1.cpp
                        ;

LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net Pt-Ssl ;
MakeLocate Pt-Http : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Http : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Http tests ;
