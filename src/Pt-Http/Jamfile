SubDir PT_TOP src Pt-Http ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_HTTP_API_EXPORT ] ;
SubDirHdrs $(PT_TOP)/src/Pt-Http/$(SYS:L) ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Http ;

if $(WITH_OPENSSL)
{
    SubDirC++Flags [ FDefines PT_HTTP_WITH_SSL ] ;
}

SharedLibrary Pt-Http : Authentication.cpp
                        Authorization.cpp
                        Client.cpp
                        ClientImpl.cpp
                        ChunkedReader.cpp
                        Connection.cpp
                        HttpBuffer.cpp
                        NotFoundResponder.cpp
                        NotFoundService.cpp
                        MessageHeader.cpp
                        Parser.cpp
                        Reply.cpp
                        Request.cpp
                        Responder.cpp
                        Server.cpp
                        Service.cpp
                        ;

if $(WITH_OPENSSL)
{
    LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net Pt-Ssl ;
}
else
{
    LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net ;
}

MakeLocate Pt-Http : $(OUTPUT_TARGET) ;
MakeInstall Pt-Http : $(INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Http tests ;
