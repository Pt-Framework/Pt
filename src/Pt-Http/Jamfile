SubDir TOP src Pt-Http ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_HTTP_API_EXPORT ] ;
SubDirHdrs $(TOP)/src/Pt-Http/$(SYS:L) ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Http ;

SharedLibrary Pt-Http : Client.cpp
                        ClientImpl.cpp
                        ChunkedReader.cpp
                        NotFoundResponder.cpp
                        NotFoundService.cpp
                        NotAuthenticatedResponder.cpp
                        NotAuthenticatedService.cpp
                        MessageHeader.cpp
                        Parser.cpp
                        Responder.cpp
                        Server.cpp
                        Service.cpp
                        ;

LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net ;
MakeLocate Pt-Http : $(OUTPUT_TARGET) ;
MakeInstall Pt-Http : $(INSTALL_LIB) ;

SubInclude TOP src Pt-Http tests ;
