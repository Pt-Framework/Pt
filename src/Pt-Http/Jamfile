SubDir PT_TOP src Pt-Http ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_HTTP_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Http ;

SharedLibrary Pt-Http : Authorizer.cpp
                        Authenticator.cpp
                        Client.cpp
                        ClientImpl.cpp
                        Connection.cpp
                        HttpBuffer.cpp
                        HttpError.cpp
                        Message.cpp
                        Parser.cpp
                        Reply.cpp
                        Request.cpp
                        Responder.cpp
                        Server.cpp
                        ServerImpl.cpp
                        Service.cpp
                        Servlet.cpp
                        IOStream.cpp
                        ;

LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net Pt-Ssl ;
MakeLocate Pt-Http : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Http : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Http tests ;
