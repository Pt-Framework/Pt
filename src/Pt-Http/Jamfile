SubDir PT_TOP src Pt-Http ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_HTTP_API_EXPORT ] ;
SubDirHdrs $(PT_TOP)/src/Pt-Http/$(SYS:L) ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Http ;

if $(WITH_OPENSSL)
{
    SubDirC++Flags [ FDefines PT_HTTP_WITH_SSL ] ;
}

SharedLibrary Pt-Http : Authorizer.cpp
                        Authenticator.cpp
                        Client.cpp
                        ClientImpl.cpp
                        Connection.cpp
                        HttpBuffer.cpp
                        HttpError.cpp
                        Message.cpp
                        Parser.cpp
                        Reply.cpp
                        Request.cpp
                        Responder.cpp
                        Server.cpp
                        ServerImpl.cpp
                        Service.cpp
                        Servlet.cpp
                        ;

if $(WITH_OPENSSL)
{
    LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net Pt-Ssl ;
}
else
{
    LinkSharedLibraries Pt-Http : Pt Pt-System Pt-Net ;
}

MakeLocate Pt-Http : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Http : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Http tests ;
