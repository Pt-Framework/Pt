SubDir PT_TOP src Pt-Http tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-Http ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Http ;

if $(WITH_SSL)
{
    SubDirC++Flags [ FDefines PT_HTTP_WITH_SSL ] ;
}

Main Pt-Http-test : Pt-Http-test.cpp
                    ServerTest.cpp
                    ParserTest.cpp
                    ;

if $(WITH_SSL)
{
    LinkSharedLibraries Pt-Http-test : Pt Pt-Http Pt-Net Pt-Ssl Pt-System Pt-Unit ;
}
else
{
    LinkSharedLibraries Pt-Http-test : Pt Pt-Http Pt-Net Pt-System Pt-Unit ;
}

MakeLocate Pt-Http-test : $(PT_OUTPUT_TARGET) ;
RunUnitTest Pt-Http-test : $(PT_OUTPUT_TEST) ;
