SubDir TOP src ;

SubInclude TOP src Pt ;
SubInclude TOP src Pt-Reflex ;
SubInclude TOP src Pt-System ;
SubInclude TOP src Pt-Cma ;
SubInclude TOP src Pt-Net ;

if $(WITH_HTTP2) = yes
{
    SubInclude TOP src Pt-Http2 ;
}
else
{
    SubInclude TOP src Pt-Http ;
}

SubInclude TOP src Pt-Db ;
SubInclude TOP src Pt-Gfx ;

if $(GUI) != none
{
    SubInclude TOP src Pt-Gui ;
}

SubInclude TOP src Pt-Unit ;
SubInclude TOP src Pt-Xml ;
SubInclude TOP src Pt-XmlRpc ;

if $(WITH_OPENSSL) = yes
{
    SubInclude TOP src Pt-Ssl ;
}
