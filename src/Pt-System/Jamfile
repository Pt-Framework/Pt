SubDir PT_TOP src Pt-System ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System/$(PT_SYSTEM:L) ;
SubDirC++Flags [ FDefines PT_SYSTEM_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-System ;

if $(WITH_MACH_CLOCK)
{
    SubDirC++Flags [ FDefines WITH_MACH_CLOCK ] ;
}

if $(WITH_POSIX_SELECT)
{
    SubDirC++Flags [ FDefines PT_WITH_POSIX_SELECT ] ;
}

if $(WITH_POSIX_POLL)
{
    SubDirC++Flags [ FDefines PT_WITH_POSIX_POLL ] ;
}

if $(WITH_BSD_KQUEUE)
{
    SubDirC++Flags [ FDefines PT_WITH_BSD_KQUEUE ] ;
}

if $(WITH_LINUX_EPOLL)
{
    SubDirC++Flags [ FDefines PT_WITH_LINUX_EPOLL ] ;
}

PT_SYSTEM_IMPL_SUBDIR = [ FDirName $(PT_TOP) src Pt-System $(PT_SYSTEM:L) ] ;
PT_SYSTEM_IMPL += [ GLOB $(PT_SYSTEM_IMPL_SUBDIR) : *.cpp  ] ;

SharedLibrary Pt-System : $(PT_SYSTEM_IMPL)
                          Application.cpp
                          Clock.cpp
                          Condition.cpp
                          Directory.cpp
                          EventSource.cpp
                          EventSink.cpp
                          EventLoop.cpp
                          FileDevice.cpp
                          FileInfo.cpp
                          IOBuffer.cpp
                          IODevice.cpp
                          IONotifier.cpp
                          Library.cpp
                          Logger.cpp
                          LogManager.cpp
                          LogTarget.cpp
                          MainLoop.cpp
                          Mutex.cpp
                          Path.cpp
                          Pipe.cpp
                          Process.cpp
                          Selectable.cpp
                          SerialDevice.cpp
                          Semaphore.cpp
                          SystemError.cpp
                          TarReader.cpp
                          TarWriter.cpp
                          Thread.cpp
                          Timer.cpp
                          Uri.cpp
                          UriQuery.cpp
                          ConsoleChannel.cpp
                          FileChannel.cpp
                          SerialChannel.cpp
                          ;

LinkSharedLibraries Pt-System : Pt ;
LinkLibs Pt-System : $(PT_SYSTEM_LINKLIBS) ;
MakeLocate Pt-System : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-System : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-System tests ;
