SubDir TOP src Pt-System ;

SubDirHdrs $(TOP)/include ;
SubDirHdrs $(TOP)/src/Pt-System/$(SYS:L) ;
SubDirC++Flags [ FDefines PT_SYSTEM_API_EXPORT ] ;

PT_SYSTEM_SUBDIR = [ FDirName $(TOP) src Pt-System $(SYS:L) ] ;
PT_SYSTEM_IMPL += [ GLOB $(PT_SYSTEM_SUBDIR) : *.cpp  ] ;

SharedLibrary Pt-System : $(PT_SYSTEM_IMPL)
                          Application.cpp
                          Clock.cpp
                          Condition.cpp
                          Directory.cpp
                          EventSource.cpp
                          EventSink.cpp
                          EventLoop.cpp
                          File.cpp
                          FileDevice.cpp
                          FileInfo.cpp
                          IODevice.cpp
                          IOError.cpp
                          IOStream.cpp
                          Library.cpp
                          Logger.cpp
                          LogManager.cpp
                          MainLoop.cpp
                          Mutex.cpp
                          Pipe.cpp
                          Plugin.cpp
                          Process.cpp
                          Selectable.cpp
                          SerialDevice.cpp
                          Semaphore.cpp
                          StreamBuffer.cpp
                          SystemError.cpp
                          Thread.cpp
                          Timer.cpp
                          Url.cpp
                          Uri.cpp
                          ConsoleChannel.cpp
                          FileChannel.cpp
                          SerialChannel.cpp
                          ;

LinkSharedLibraries Pt-System : Pt ;
LINKLIBS on $(PRELIB)Pt-System$(SUFDLL) = $(LINKLIBS) $(SYSLIBS) ;
MakeLocate Pt-System : $(OUTPUT_TARGET) ;

SharedLibrary TestPlugin : TestPlugin.cpp ;
SharedLibrary_LinkSharedLibraries TestPlugin : Pt Pt-System ;
SharedLibrary_MakeLocate TestPlugin : $(OUTPUT_TARGET) ;

Main PluginDemo : PluginDemo.cpp ;
Main_LinkSharedLibraries PluginDemo : Pt Pt-System ;
Main_MakeLocate PluginDemo : $(OUTPUT_TARGET) ;

Main EventSinkDemo : EventSinkDemo.cpp ;
Main_LinkSharedLibraries EventSinkDemo : Pt Pt-System  ;
Main_MakeLocate EventSinkDemo : $(OUTPUT_TARGET) ;

Main SerialDeviceDemo : SerialDeviceDemo.cpp ;
Main_LinkSharedLibraries SerialDeviceDemo : Pt Pt-System  ;
Main_MakeLocate SerialDeviceDemo : $(OUTPUT_TARGET) ;

# Main PipeDemo : PipeDemo.cpp ;
# Main_LinkSharedLibraries PipeDemo : Pt Pt-System  ;
# Main_MakeLocate PipeDemo : $(OUTPUT_TARGET) ;

NOTFILE Pt-System-all ;
DEPENDS Pt-System-all : Pt-System ;

SubInclude TOP src Pt-System tests ;

