		<Configuration
			Name="Debug|Pocket PC 2003 (ARMV4)"
			OutputDirectory="..\..\bin"
			IntermediateDirectory="..\..\temp\wince\arm\le\vc8\$(ConfigurationName)"
			ConfigurationType="0"
			BuildLogFile="$(IntDir)\$(TargetName).htm"
			ExcludeBuckets="7"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam/jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug  -sTARGET_OS=wince -sTARGET_OSPLAT=arm $(TargetFileName) -q"
				ReBuildCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam/jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug  -sTARGET_OS=wince -sTARGET_OSPLAT=arm $(TargetName)  -a"
				CleanCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam/jam.exe -sBYTEORDER=LE -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug  -sTARGET_OS=wince -sTARGET_OSPLAT=arm clean"
				Output="$(OutDir)\Pt-Systemd.dll"
				PreprocessorDefinitions="WIN32;_DEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
