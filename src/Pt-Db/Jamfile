SubDir TOP src Pt-Db ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_DB_API_EXPORT ] ;

SharedLibrary Pt-Db : Connection.cpp
                      Exception.cpp
                      Result.cpp
                      ResultImpl.cpp
                      Row.cpp
                      RowImpl.cpp
                      Statement.cpp
                      ValueImpl.cpp
                    ;
SharedLibrary_LinkSharedLibraries Pt-Db : Pt-System Pt ;
SharedLibrary_LinkLibraries Pt-Db : Pt-Db-sqlite ;
SharedLibrary_MakeLocate Pt-Db : $(OUTPUT_TARGET) ;

PT_DB_TESTS = ResultImplTest.cpp
              RowImplTest.cpp
              SqliteTest.cpp
              ValueImplTest.cpp
              ;

PtUnitTest Pt-Db-test : Pt-Db-test.cpp $(PT_DB_TESTS) ;
Main_LinkSharedLibraries Pt-Db-test : Pt Pt-System Pt-Db Pt-Unit ;
PtUnitTest_MakeLocate Pt-Db-test : $(OUTPUT_TARGET) ;


# Define pseudo targets to call from projects
NOTFILE Pt-Db-all ;
DEPENDS Pt-Db-all : Pt Pt-Db-test ;

SubInclude TOP src Pt-Db sqlite ;
