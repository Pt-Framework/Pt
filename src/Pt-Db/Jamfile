SubDir TOP src Pt-Db ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_DB_API_EXPORT ] ;
SubDirCcFlags  [ FDefines PT_DB_API_EXPORT ] ;

if $(TARGET_OS:L) = symbian
{
    SubDirCcFlags [ FDefines __REMOVE_PLATSEC_DIAGNOSTIC_STRINGS__ ] ;
}

# BUG: if a C source file comes first, jam links a C library
PT_DB_SOURCES = [ FDirName sqlite SQLConnection.cpp ]
                [ FDirName sqlite sqlite3.c ]
                [ FDirName sqlite Connector.cpp ]
                [ FDirName sqlite Cursor.cpp ]
                [ FDirName sqlite Error.cpp ]
                [ FDirName sqlite SQLStatement.cpp ]
                [ FDirName sqlite StmtRow.cpp ]
                [ FDirName sqlite StmtValue.cpp ]
                Connection.cpp
                Exception.cpp
                Result.cpp
                ResultImpl.cpp
                Row.cpp
                RowImpl.cpp
                Statement.cpp
                ValueImpl.cpp
                ;

SharedLibrary                     Pt-Db : $(PT_DB_SOURCES) ;
SharedLibrary_LinkSharedLibraries Pt-Db : Pt Pt-System ;
SharedLibrary_MakeLocate          Pt-Db : $(OUTPUT_TARGET) ;

PT_DB_TESTS = ResultImplTest.cpp
              RowImplTest.cpp
              SqliteTest.cpp
              ValueImplTest.cpp
              ;
PtUnitTest               Pt-Db-test : Pt-Db-test.cpp $(PT_DB_TESTS) ;
Main_LinkSharedLibraries Pt-Db-test : Pt-Db Pt-Unit Pt-System Pt ;
PtUnitTest_MakeLocate    Pt-Db-test : $(OUTPUT_TARGET) ;

DeploySharedLibrary $(DEPLOY_LIBDIR) : Pt-Db ;
