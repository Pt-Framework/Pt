SubDir TOP src Pt-Db sqlite ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_DB_API_EXPORT ] ;

# sqlite.org's codebase has a file for the OSm specific code.
# On wince the file is identical to win32 and has lots of ifdefs.
#
if $(TARGET_OS:L) = wince
{
	# only the C++ compiler seemed to define _WIN32_WC, but not the
	# C compiler ??? -marc 
	CCFLAGS += /D_WIN32_WCE ;
	OS_SOURCES = [ FDirName os_win32.c ] ;
}
else
{
	OS_SOURCES = [ FDirName os_$(SYS:L).c ] ;
}

PT_SQLITE_SOURCES = sqlite3.c
                    ;

PT_SQLITE_SOURCES += Connection.cpp 
                     Connector.cpp
                     Cursor.cpp
                     Error.cpp
                     Statement.cpp
                     StmtRow.cpp
                     StmtValue.cpp
                   ;

Library Pt-Db-sqlite : $(PT_SQLITE_SOURCES) ;
Library_MakeLocate Pt-Db-sqlite : $(OUTPUT_TARGET) ;

PtUnitTest SqliteTest : SqliteTest.cpp ;
Main_LinkSharedLibraries SqliteTest : Pt Pt-Db Pt-System Pt-Unit ;
PtUnitTest_MakeLocate SqliteTest : $(OUTPUT_TARGET) ;
