SubDir PT_TOP src Pt-Db sqlite ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_DB_API_EXPORT ] ;

if $(TARGET_OS:L) = wince
{
	# only the C++ compiler seemed to define _WIN32_WCE, but not the
	# C compiler ??? -marc
	CCFLAGS += /D_WIN32_WCE ;
}

PT_SQLITE_SOURCES = sqlite3.c ;

PT_SQLITE_SOURCES += SqliteConnection.cpp
                     SqliteConnector.cpp
                     SqliteCursor.cpp
                     SqliteError.cpp
                     SqliteStatement.cpp
                     StmtRow.cpp
                     StmtValue.cpp
                     ;

Library Pt-Db-sqlite : $(PT_SQLITE_SOURCES) ;
Library_MakeLocate Pt-Db-sqlite : $(PT_OUTPUT_TARGET) ;

PtUnitTest SqliteTest : SqliteTest.cpp ;
Main_LinkSharedLibraries SqliteTest : Pt Pt-Db Pt-System Pt-Unit ;
PtUnitTest_MakeLocate SqliteTest : $(PT_OUTPUT_TARGET) ;
