SubDir PT_TOP src Pt-Hmi demo  ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Hmi-Demo ;

HMI_DEMO_SOURCES = Main.cpp
				   MainWindow.cpp
				   Dialog1.cpp
				   Dialog2.cpp
				   ChildW.cpp
				   ;

Main Pt-Hmi-Demo : $(HMI_DEMO_SOURCES) ;
LinkSharedLibraries Pt-Hmi-Demo : Pt Pt-System Pt-Gfx Pt-Net Pt-Hmi  ;
MakeLocate Pt-Hmi-Demo : $(PT_OUTPUT_TARGET) ;

HMI_PAINTER_DEMO_SOURCES = PainterDemo.cpp ;

#rule FGeneric
#{ return $(<) ; }
#SubDirC++Flags [ FGeneric -std=c++11  ] ;

Main Pt-Hmi-PainterDemo : $(HMI_PAINTER_DEMO_SOURCES) ;
LinkSharedLibraries Pt-Hmi-PainterDemo : Pt Pt-System Pt-Gfx Pt-Hmi ;
MakeLocate Pt-Hmi-PainterDemo : $(PT_OUTPUT_TARGET) ;

PT_DEMO_ICONS_DIR = [ FDirName etc icons ] ;
PT_DEMO_ICONS = [ GLOB $(PT_DEMO_ICONS_DIR) : *.png  ] ;

for local f in $(PT_DEMO_ICONS)
{
    File $(f:BS) : $(f) ;
    MakeLocate $(f:BS)  : [ FDirName $(PT_OUTPUT_TARGET) ] ;
}
