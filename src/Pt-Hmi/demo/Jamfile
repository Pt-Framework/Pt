SubDir PT_TOP src Pt-Hmi demo  ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/skia/include/core ;
SubDirHdrs $(PT_TOP)/src/skia/include/config ;
SubDirHdrs $(PT_TOP)/src/skia/include/gpu ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Hmi-Demo ;

HMI_DEMO_SOURCES = Main.cpp
				           MainWindow.cpp
				           Dialog1.cpp
				           Dialog2.cpp
				           ChildW.cpp
				           ;

Main Pt-Hmi-Demo : $(HMI_DEMO_SOURCES) ;
LinkSharedLibraries Pt-Hmi-Demo : Pt Pt-System Pt-Gfx Pt-Net Pt-Hmi ;

if $(WITH_BUILTIN_SKIA)
{
	LinkLibraries Pt-Hmi-Demo : skia ;
}

MakeLocate Pt-Hmi-Demo : $(PT_OUTPUT_TARGET) ;

