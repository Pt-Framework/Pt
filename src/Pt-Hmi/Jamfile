SubDir PT_TOP src Pt-Hmi ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System ;
SubDirHdrs $(PT_TOP)/src/Pt-Hmi/$(GUI) ;
SubDirC++Flags [ FDefines PT_HMI_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Hmi ;

if $(PT_HMI_IMPL) = x11-core
{
    SubDirC++Flags [ FDefines PT_HMI_X11_CORE ] ;
}

if $(PT_HMI_IMPL) = x11-raster
{
    SubDirC++Flags [ FDefines PT_HMI_X11_RASTER ] ;
}

if $(PT_HMI_IMPL) = win32-gdi
{
    SubDirC++Flags [ FDefines PT_HMI_WIN32_GDI ] ;
}

if $(PT_HMI_IMPL) = win32-raster
{
    SubDirC++Flags [ FDefines PT_HMI_WIN32_RASTER ] ;
}

if $(GUI_INCLUDES)
{
    SubDirHdrs $(GUI_INCLUDES) ;
}

if $(GUI:L) = x11
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
    SubDirHdrs $(X11_INCLUDES) ;
    SubDirHdrs $(XFT_INCLUDES) ;
}

PT_HMI_SUBDIR = [ FDirName $(PT_TOP) src Pt-Hmi $(GUI:L) ] ;

PT_HMI_IMPL_SOURCES += [ GLOB $(PT_HMI_SUBDIR) : *.cpp  ] ;
PT_HMI_IMPL_SOURCES += [ GLOB $(PT_HMI_SUBDIR) : *.mm  ] ;

SharedLibrary Pt-Hmi : Application.cpp
                       Button.cpp
                       CheckBox.cpp
                       ComboBox.cpp
                       Control.cpp
                       Cursor.cpp
                       DockingLayout.cpp
                       FlowLayout.cpp
                       Form.cpp
                       GridLayout.cpp
                       Icon.cpp
                       InputMethod.cpp
                       Layout.cpp
                       LineEdit.cpp
                       LineEditor.cpp
                       ListBox.cpp
                       Label.cpp
                       Menu.cpp
                       MenuBar.cpp
                       MenuItem.cpp
                       MenuBarItem.cpp
                       MenuBase.cpp
                       MenuBaseItem.cpp
                       MenuMenuItem.cpp
                       MenuSubItem.cpp
                       Panel.cpp
                       PixmapSurface.cpp
                       PlatinumStyle.cpp
                       Popup.cpp
                       ProgressBar.cpp
                       PushButton.cpp
                       Screen.cpp 
                       ScrollBar.cpp
                       ScrollView.cpp
                       ScrollLayout.cpp
                       Shell.cpp
                       ShellWM.cpp
                       ShellWindowFrame.cpp
                       Slider.cpp
                       SpinBox.cpp
                       StackLayout.cpp
                       Style.cpp
                       StyleOptions.cpp
                       TableLayout.cpp
                       TabView.cpp
                       TextBlock.cpp
                       Visual.cpp
                       Widget.cpp
                       WindowBase.cpp
                       Window.cpp
                       WindowFrame.cpp
                       WindowManager.cpp
                       $(PT_HMI_IMPL_SOURCES) ;

LinkSharedLibraries Pt-Hmi : Pt Pt-System Pt-Gfx Pt-Reflex ;
LinkLibs Pt-Hmi : $(GUILIBS) ;
MakeLocate Pt-Hmi : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Hmi : $(PT_INSTALL_LIBDIR) ;

if $(GUI:L) = egl-gbm
{
  PT_EGL_TEST_DIR = [ FDirName $(PT_TOP) src Pt-Hmi egl-test ] ;
  Main egl-test : [ GLOB $(PT_EGL_TEST_DIR) : *.cpp  ] ;
  LinkLibs egl-test : $(GUILIBS) ;
  MakeLocate egl-test : $(PT_OUTPUT_TARGET) ;
}

SubInclude PT_TOP src Pt-Hmi demo ;
