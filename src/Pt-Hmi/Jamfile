SubDir PT_TOP src Pt-Hmi ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System ;
SubDirHdrs $(PT_TOP)/src/Pt-Hmi/$(GUI:L) ;
SubDirC++Flags [ FDefines PT_HMI_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Hmi ;

if $(GUI_INCLUDES)
{
    SubDirHdrs $(GUI_INCLUDES) ;
}

if $(GUI:L) = xorg || $(GUI:L) = x11
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
    SubDirHdrs $(X11_INCLUDES) ;
    SubDirHdrs $(XFT_INCLUDES) ;
}

PT_HMI_SUBDIR = [ FDirName $(PT_TOP) src Pt-Hmi $(GUI:L) ] ;
PT_HMI_IMPL += [ GLOB $(PT_HMI_SUBDIR) : *.cpp  ] ;
PT_HMI_IMPL += [ GLOB $(PT_HMI_SUBDIR) : *.mm  ] ;

if $(WITH_BUILTIN_SKIA)
{
    SubDirC++Flags [ FDefines SK_SUPPORT_GPU=0 ] ;
    SubDirC++Flags [ FDefines SKSL_STANDALONE  ] ;
    SubDirC++Flags [ FDefines SK_BUILD_NO_OPTS ] ;
    SubDirC++Flags [ FDefines SK_DISABLE_EFFECT_DESERIALIZATION ] ;

    SubDirHdrs $(PT_TOP)/src/skia/include/c ;
    SubDirHdrs $(PT_TOP)/src/skia/include/codec ;
    SubDirHdrs $(PT_TOP)/src/skia/include/config ;
    SubDirHdrs $(PT_TOP)/src/skia/include/core ;
    SubDirHdrs $(PT_TOP)/src/skia/include/effects ;
    SubDirHdrs $(PT_TOP)/src/skia/include/encode ;
    SubDirHdrs $(PT_TOP)/src/skia/include/gpu ;
    SubDirHdrs $(PT_TOP)/src/skia/include/pathops ;
    SubDirHdrs $(PT_TOP)/src/skia/include/ports ;
    SubDirHdrs $(PT_TOP)/src/skia/include/private ;
    SubDirHdrs $(PT_TOP)/src/skia/include/utils ;
    SubDirHdrs $(PT_TOP)/src/skia/src/core ;
    SubDirHdrs $(PT_TOP)/src/skia/src/shaders ;

    PT_HMI_IMPL += SkiaPainter.cpp SkiaBlitter.cpp ;
}

SharedLibrary Pt-Hmi : $(PT_HMI_IMPL)
                       Application.cpp
                       Button.cpp
                       CheckBox.cpp
                       ComboBox.cpp
                       Control.cpp
                       Cursor.cpp
                       DockingLayout.cpp
                       FlowLayout.cpp
                       GridLayout.cpp
                       Icon.cpp
                       InputMethod.cpp
                       Layout.cpp
                       LineEdit.cpp
                       LineEditor.cpp
                       ListBox.cpp
                       Label.cpp
                       Menu.cpp
                       MenuBar.cpp
                       MenuItem.cpp
                       MenuShell.cpp 
                       PaintSurface.cpp
                       PaintRegion.cpp
                       Painter.cpp
                       Panel.cpp
                       Picture.cpp
                       PixmapSurface.cpp
                       PlatinumStyle.cpp
                       Popup.cpp
                       ProgressBar.cpp
                       PushButton.cpp
                       Screen.cpp 
                       ScrollBar.cpp
                       ScrollView.cpp
                       ScrollLayout.cpp
                       Slider.cpp
                       SpinBox.cpp
                       StackLayout.cpp
                       Style.cpp
                       StyleOptions.cpp
                       TableLayout.cpp
                       TabView.cpp
                       TextBlock.cpp
                       Visual.cpp
                       Widget.cpp
                       WindowBase.cpp
                       Window.cpp
                       WindowFrame.cpp
                       WindowManager.cpp
                       ;

if $(WITH_BUILTIN_SKIA)
{
	LinkLibraries Pt-Hmi : skia ;
}

LinkSharedLibraries Pt-Hmi : Pt Pt-System Pt-Gfx Pt-Reflex ;
LinkLibs Pt-Hmi : $(GUILIBS) ;
MakeLocate Pt-Hmi : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Hmi : $(PT_INSTALL_LIBDIR) ;

if $(GUI:L) = egl-gbm
{
  PT_EGL_TEST_DIR = [ FDirName $(PT_TOP) src Pt-Hmi egl-test ] ;
  Main egl-test : [ GLOB $(PT_EGL_TEST_DIR) : *.cpp  ] ;
  LinkLibs egl-test : $(GUILIBS) ;
  MakeLocate egl-test : $(PT_OUTPUT_TARGET) ;
}

SubInclude PT_TOP src Pt-Hmi demo ;
