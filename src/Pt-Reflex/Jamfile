SubDir PT_TOP src Pt-Reflex ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_REFLEX_API_EXPORT ] ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Reflex ;

SharedLibrary Pt-Reflex : Reflectable.cpp
                          Type.cpp
                          GenericType.cpp
                          TypeManager.cpp ;

LinkSharedLibraries Pt-Reflex : Pt ;
MakeLocate Pt-Reflex : $(OUTPUT_TARGET) ;
MakeInstall Pt-Reflex : $(INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Reflex tests ;
