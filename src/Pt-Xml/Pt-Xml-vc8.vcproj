				ReBuildCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam/jam.exe -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=$(ConfigurationName)  -sTARGET_OS=wince -sTARGET_OSPLAT=arm $(TargetFileName)  -a"
				CleanCommandLine="cd $(SolutionDir) &amp;&amp; $(SolutionDir)jam/jam.exe -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=$(ConfigurationName)  -sTARGET_OS=wince -sTARGET_OSPLAT=arm clean"
				Output="$(OutDir)\Pt-Xmld.dll"
				PreprocessorDefinitions="WIN32;_DEBUG"
