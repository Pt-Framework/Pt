SubDir TOP src Pt-Xml ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_XML_API_EXPORT ] ;

PT_XML_SOURCES = Characters.cpp
                 Comment.cpp
                 DocTypeDeclaration.cpp
                 EntityResolver.cpp
                 EndElement.cpp
                 Namespace.cpp
                 NamespaceContext.cpp
                 ProcessingInstruction.cpp
                 QName.cpp
                 StartElement.cpp
                 XmlDeserializer.cpp
                 XmlError.cpp
                 XmlFormatter.cpp
                 XmlReader.cpp
                 XmlSerializer.cpp
                XmlSerializationContext.cpp
                 XmlWriter.cpp
                 ;

SharedLibrary Pt-Xml : $(PT_XML_SOURCES) ;
SharedLibrary_LinkSharedLibraries Pt-Xml :  Pt ;
SharedLibrary_MakeLocate Pt-Xml : $(OUTPUT_TARGET) ;

PT_XML_TESTS = XmlTest.cpp
               XmlSerializerTest.cpp
               XmlWriterTest.cpp
               ;

PtUnitTest Pt-Xml-test : Pt-Xml-test.cpp $(PT_XML_TESTS) ;
Main_LinkSharedLibraries Pt-Xml-test : Pt-Xml Pt-System Pt-Unit Pt-Log Pt ;
PtUnitTest_MakeLocate Pt-Xml-test : $(OUTPUT_TARGET) ;

Main XmlReaderTest : XmlReaderTest.cpp ;
Main_LinkSharedLibraries XmlReaderTest : Pt-Xml Pt-System Pt ;
Main_MakeLocate XmlReaderTest : $(OUTPUT_TARGET) ;

# Define pseudo targets to call from projects
NOTFILE Pt-Xml-all ;
DEPENDS Pt-Xml-all : Pt-Xml
                     Pt-Xml-test
                     XmlReaderTest
                     ;
