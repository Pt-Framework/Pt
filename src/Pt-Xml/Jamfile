SubDir TOP src Pt-Xml ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_XML_API_EXPORT ] ;
SubDirObjects $(OUTPUT_OBJECT) Pt-Xml ;

PT_XML_SOURCES = Characters.cpp
                 EntityResolver.cpp
                 EndElement.cpp
                 NamespaceContext.cpp
                 QName.cpp
                 StartElement.cpp
                 XmlError.cpp
                 XmlFormatter.cpp
                 XmlReader.cpp
                 XmlSerializationContext.cpp
                 XmlWriter.cpp
                 ;

SharedLibrary Pt-Xml : $(PT_XML_SOURCES) ;
LinkSharedLibraries Pt-Xml :  Pt ;
MakeLocate Pt-Xml : $(OUTPUT_TARGET) ;
MakeInstall Pt-Xml : $(INSTALL_LIBDIR) ;

SubInclude TOP src Pt-Xml tests ;
