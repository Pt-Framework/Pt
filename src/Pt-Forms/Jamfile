                         Icon.cpp
                         InputMethod.cpp
                         Layout.cpp
                         LineEdit.cpp
                         LineEditStyle.cpp
                         LineEditor.cpp
                         ListBox.cpp
                         ListBoxStyle.cpp
                         Label.cpp
                         Menu.cpp
                         MenuBar.cpp
                         MenuItem.cpp
                         MenuBarItem.cpp
                         MenuBase.cpp
                         MenuItemBase.cpp
                         MenuSubItem.cpp
                         PaintContext.cpp
                         Painter.cpp
                         PaintSurface.cpp
                         Panel.cpp
                         Pixmap.cpp
                         PlatinumStyle.cpp
                         Popup.cpp
                         ProgressBar.cpp
                         ProgressBarStyle.cpp
                         PushButton.cpp
                         Responder.cpp
                         Screen.cpp
                         ScrollBar.cpp
                         ScrollBarStyle.cpp
                         ScrollView.cpp
                         ScrollLayout.cpp
                         Slider.cpp
                         SliderStyle.cpp
                         SpinBox.cpp
                         SpinBoxStyle.cpp
                         StackLayout.cpp
                         PanelStyle.cpp
                         Style.cpp
                         StylerBase.cpp
                         StyleOptions.cpp
                         TableLayout.cpp
                         TabView.cpp
                         TabViewStyle.cpp
                         TextBlock.cpp
                         View.cpp
                         Widget.cpp
                         Window.cpp
                         WindowFrame.cpp
                         WindowManager.cpp
                         Workspace.cpp
                         WorkspaceFrame.cpp
                         WorkspaceManager.cpp
                         $(PT_FORMS_IMPL_SOURCES) ;

LinkSharedLibraries Pt-Forms : Pt Pt-System Pt-Gfx ;
LinkLibs Pt-Forms : $(PT_FORMS_LINKLIBS) ;
MakeLocate Pt-Forms : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Forms : $(PT_INSTALL_LIBDIR) ;

if $(PT_FORMS_RENDERER) = nanovg
{
    if $(WITH_BUILTIN_FREETYPE)
    {
        LinkLibraries Pt-Forms : freetype ;
    }
    else
    {
        LinkFlags Pt-Forms : $(FREETYPE_LINKFLAGS) ;
        LinkLibs Pt-Forms : $(FREETYPE_LINKLIBS) ;
    }
}

SubInclude PT_TOP src Pt-Forms demo ;
