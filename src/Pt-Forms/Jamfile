SubDir PT_TOP src Pt-Forms ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System ;
SubDirHdrs $(PT_TOP)/src/Pt-Forms/$(PT_FORMS_IMPL) ;
SubDirC++Flags [ FDefines PT_FORMS_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Forms ;

if $(PT_FORMS_IMPL:L) = win32
{
    switch $(PT_FORMS_RENDERER)
    {
        case direct2d : SubDirC++Flags [ FDefines PT_FORMS_WIN32_DIRECT2D ] ;
        case raster  : SubDirC++Flags [ FDefines PT_FORMS_WIN32_RASTER ] ;
        case gdi     : SubDirC++Flags [ FDefines PT_FORMS_WIN32_GDI ] ;
    }
}

if $(PT_FORMS_C++FLAGS)
{
    SubDirC++Flags $(PT_FORMS_C++FLAGS) ;
}

if $(PT_FORMS_INCLUDES)
{
    SubDirHdrs $(PT_FORMS_INCLUDES) ;
}

PT_FORMS_SUBDIR = [ FDirName $(PT_TOP) src Pt-Forms $(PT_FORMS_IMPL:L) ] ;

PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_SUBDIR) : *.cpp  ] ;
PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_SUBDIR) : *.mm  ] ;

if $(PT_FORMS_IMPL:L) = wayland
{
    PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_SUBDIR) : *.c ] ;
}

if $(PT_FORMS_RENDERER)
{
    PT_FORMS_RENDERER_DIR = [ FDirName $(PT_TOP) src Pt-Forms $(PT_FORMS_RENDERER) ] ;
    SubDirHdrs $(PT_FORMS_RENDERER_DIR) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_RENDERER_DIR) : *.cpp ] ;

    if $(PT_FORMS_RENDERER) = raster && $(PT_FORMS_IMPL:L) = win32
    {
        local _d2ddir = [ FDirName $(PT_TOP) src Pt-Forms direct2d ] ;
        PT_FORMS_IMPL_SOURCES += [ GLOB $(_d2ddir) : D2DDevice.cpp ] ;
    }

    if $(PT_FORMS_RENDERER) = vulkan && $(PT_FORMS_IMPL:L) = linux-drm
    {
        SubDirC++Flags [ FDefines PT_FORMS_DRM_VULKAN ] ;
    }
}

if $(PT_FORMS_IMPL:L) = linux-fb || $(PT_FORMS_IMPL:L) = linux-drm
{
    local _inputdir = [ FDirName $(PT_TOP) src Pt-Forms linux-input ] ;
    SubDirHdrs $(_inputdir) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(_inputdir) : *.cpp ] ;
}


SharedLibrary Pt-Forms : Application.cpp
                         Button.cpp
                         ButtonStyle.cpp
                         CanvasLayout.cpp
                         CheckBox.cpp
                         CheckBoxStyle.cpp
                         ComboBox.cpp
                         ComboBoxStyle.cpp
                         Control.cpp
