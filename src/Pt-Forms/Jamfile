SubDir PT_TOP src Pt-Forms ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System ;
SubDirHdrs $(PT_TOP)/src/Pt-Forms/$(PT_FORMS_IMPL) ;
SubDirHdrs $(PT_TOP)/src/Pt-Forms/generic ;
SubDirC++Flags [ FDefines PT_FORMS_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Forms ;

if $(PT_FORMS_C++FLAGS)
{
    SubDirC++Flags $(PT_FORMS_C++FLAGS) ;
}

if $(PT_FORMS_INCLUDES)
{
    SubDirHdrs $(PT_FORMS_INCLUDES) ;
}

PT_FORMS_IMPL_DIR = [ FDirName $(PT_TOP) src Pt-Forms $(PT_FORMS_IMPL:L) ] ;
PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_IMPL_DIR) : *.cpp  ] ;
PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_IMPL_DIR) : *.mm  ] ;
PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_IMPL_DIR) : *.c ] ;

PT_FORMS_GENERIC_SUBDIR = [ FDirName $(PT_TOP) src Pt-Forms generic ] ;
PT_FORMS_IMPL_SOURCES += [ GLOB $(PT_FORMS_GENERIC_SUBDIR) : *.cpp ] ;

if $(WITH_FORMS_DIRECT2D) || $(PT_FORMS_IMPL:L) = win32
{
    local D2D_DIR = [ FDirName $(PT_TOP) src Pt-Forms direct2d ] ;
    SubDirHdrs $(D2DDIR) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(D2D_DIR) : *.cpp ] ;
}

if $(WITH_FORMS_GDI)
{
    local GDI_DIR = [ FDirName $(PT_TOP) src Pt-Forms gdi ] ;
    SubDirHdrs $(GDI_DIR) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(GDI_DIR) : *.cpp ] ;
}

if $(PT_WITH_VULKAN)
{
    local VULKAN_DIR = [ FDirName $(PT_TOP) src Pt-Forms vulkan ] ;
    SubDirHdrs $(VULKAN_DIR) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(VULKAN_DIR) : *.cpp ] ;
}

if $(WITH_FORMS_NANOVG)
{
    local NANOVG_DIR = [ FDirName $(PT_TOP) src Pt-Forms nanovg ] ;

    SubDirHdrs $(NANOVG_DIR) ;
    SubDirC++Flags [ FDefines NANOVG_GLES2 ] ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(NANOVG_DIR) : *.c ] ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(NANOVG_DIR) : *.cpp ] ;

    SubDirHdrs $(FREETYPE_INCLUDES) ;
    SubDirHdrs [ FDirName $(PT_TOP) src Pt-Gfx freetype ] ;
    SubDirCcFlags [ FDefines FONS_USE_FREETYPE ] ;
}

if $(PT_FORMS_IMPL:L) = linux-fb || $(PT_FORMS_IMPL:L) = linux-drm
{
    local LINUX_INPUT_DIR = [ FDirName $(PT_TOP) src Pt-Forms linux-input ] ;
    SubDirHdrs $(LINUX_INPUT_DIR) ;
    PT_FORMS_IMPL_SOURCES += [ GLOB $(LINUX_INPUT_DIR) : *.cpp ] ;
}

if $(PT_FORMS_IMPL:L) = win32
{
    if $(WITH_FORMS_DIRECT2D)
    {
        SubDirC++Flags [ FDefines PT_FORMS_WIN32_DIRECT2D ] ;
    }

    if $(WITH_FORMS_GDI)
    {
        SubDirC++Flags [ FDefines PT_FORMS_WIN32_GDI ] ;
    }
}

if $(PT_FORMS_IMPL:L) = wayland
{
    if $(WITH_FORMS_NANOVG)
    {
        SubDirC++Flags [ FDefines PT_FORMS_WAYLAND_NANOVG ] ;
    }
}

SharedLibrary Pt-Forms : Application.cpp
                         Button.cpp
