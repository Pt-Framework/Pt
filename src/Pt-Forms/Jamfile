SubDir PT_TOP src Pt-Forms  ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_FORMS_EXPORTS ] ;
SubDirCcFlags [ FDefines PT_FORMS_EXPORTS ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Forms ;

SharedLibrary Pt-Forms : 
					   Window.cpp
					   Dialog.cpp
					   Widget.cpp
					   Panel.cpp
					   Label.cpp
					   Button.cpp
						;

LinkSharedLibraries Pt-Forms : Pt Pt-System Pt-Gfx  Pt-Hmi ;
LinkLibs  Pt-Forms : $(GUILIBS) ;
MakeLocate  Pt-Forms : $(PT_OUTPUT_TARGET) ;
MakeInstall  Pt-Forms : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Forms demo Widget ;
SubInclude PT_TOP src Pt-Forms demo Scribble ;