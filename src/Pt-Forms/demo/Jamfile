PT_DEMO_ICONS_DIR = [ FDirName etc icons ] ;
PT_DEMO_ICONS = [ GLOB $(PT_DEMO_ICONS_DIR) : *.png  ] ;

for local f in $(PT_DEMO_ICONS)
{
    File $(f:BS) : $(f) ;
    MakeLocate $(f:BS)  : [ FDirName $(PT_OUTPUT_TARGET) ] ;
}
