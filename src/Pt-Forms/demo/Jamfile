SubDir PT_TOP src Pt-Forms demo  ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/skia/include/core ;
SubDirHdrs $(PT_TOP)/src/skia/include/config ;
SubDirHdrs $(PT_TOP)/src/skia/include/gpu ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Forms-Demo ;

FORMS_DEMO_SOURCES = Main.cpp
				             MainWindow.cpp
				             Dialog1.cpp
				             Dialog2.cpp
				             ChildW.cpp
				             ;

Main Pt-Forms-Demo : $(FORMS_DEMO_SOURCES) ;
LinkSharedLibraries Pt-Forms-Demo : Pt Pt-System Pt-Gfx Pt-Net Pt-Forms ;

if $(WITH_BUILTIN_SKIA)
{
	LinkLibraries Pt-Forms-Demo : skia ;
}

MakeLocate Pt-Forms-Demo : $(PT_OUTPUT_TARGET) ;

if $(TARGET_OS) = wasm
{
  LinkFlags Pt-Forms-Demo : --preload-file etc/icons@/ ;
}

