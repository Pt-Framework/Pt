SubDir PT_TOP src Pt-XmlRpc tests ;
SubDirHdrs $(PT_TOP)/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-XmlRpc ;

Main Pt-XmlRpc-test : Pt-XmlRpc-test.cpp $(PT_XMLRPC_TESTS) ;
LinkSharedLibraries Pt-XmlRpc-test : Pt-XmlRpc Pt-Http Pt-Net Pt-System Pt-Unit Pt ;
MakeLocate Pt-XmlRpc-test : $(PT_OUTPUT_TARGET) ;
RunUnitTest Pt-XmlRpc-test : $(PT_OUTPUT_TEST) ;

