LinkSharedLibraries Pt-XmlRpc-test : Pt-XmlRpc Pt-Http Pt-Net Pt-System Pt-Unit Pt ;
MakeLocate Pt-XmlRpc-test : $(OUTPUT_TARGET) ;

Main google-weather-demo : google-weather-demo.cpp ;
LinkSharedLibraries google-weather-demo : Pt-Xml Pt-Http Pt-Net Pt-System Pt ;
