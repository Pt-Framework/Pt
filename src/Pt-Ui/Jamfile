SubDir PT_TOP src Pt-Ui ;

SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs  $(PT_TOP)/src/Pt-Ui/libpng ;
SubDirC++Flags [ FDefines PT_UI_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Ui ;


if $(FREETYPE_INCLUDES)
{
    SubDirHdrs $(FREETYPE_INCLUDES) ;
}

SharedLibrary Pt-Ui : Color.cpp                       
                      Image.cpp
                      ImageFormat.cpp
                      ImagePainter.cpp
                      Argb8888Format.cpp
                      Rgb888Format.cpp
                      Rgb565Format.cpp
                      Brush.cpp
                      Pen.cpp
                      Font.cpp
                      FontMetrics.cpp
                      Exception.cpp
                      DrawText.cpp
                      FreeType.cpp
                      ClipPolygon.cpp
                      ImageReader.cpp
                      RenderPath.cpp
                      Rasterizer.cpp
			              ;

LinkSharedLibraries Pt-Ui : Pt  Pt-System ;
MakeLocate Pt-Ui : $(PT_OUTPUT_TARGET) ;

if $(FREETYPE_LINKFLAGS)
{
    LinkFlags Pt-Ui : $(FREETYPE_LINKFLAGS) ;
    LinkLibs Pt-Ui : $(FREETYPE_LINKLIBS) ;
}
else
{
    LinkLibraries Pt-Ui : Pt-Ui-freetype ;
}

LinkLibraries Pt-Ui : png ;

if ! $(FREETYPE_LINKFLAGS)
{
    SubInclude PT_TOP src Pt-Ui freetype ;
}

SubInclude PT_TOP src Pt-Ui libpng ;
