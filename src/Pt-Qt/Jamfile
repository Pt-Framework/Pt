SubDir PT_TOP src Pt-Qt ;
SubDirHdrs $(PT_TOP)/include ;
SubDirHdrs $(PT_TOP)/src/Pt-System ;
SubDirHdrs $(PT_TOP)/src/Pt-Qt/$(PT_SYSTEM:L) ;
SubDirHdrs $(QT_INCLUDES) ;
SubDirC++Flags [ FDefines PT_QT_API_EXPORT ] ;
SubDirC++Flags $(QT_C++FLAGS) ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Qt ;

Moc MainLoopImpl.moc.cpp : [ FDirName $(PT_SYSTEM:L) MainLoopImpl.h ] ;

PT_QT_IMPL_DIR = [ FDirName $(PT_TOP) src Pt-Qt $(PT_SYSTEM:L) ] ;
PT_QT_SOURCES += [ GLOB $(PT_QT_IMPL_DIR) : *.cpp  ] ;
PT_QT_SOURCES += MainLoopImpl.moc.cpp
                 Application.cpp
                 MainLoop.cpp ;

SharedLibrary Pt-Qt : $(PT_QT_SOURCES) ;
LinkSharedLibraries Pt-Qt : Pt Pt-System  ;
LinkLibs Pt-Qt : $(QT_LINKLIBS) ;
LinkFlags Pt-Qt : $(QT_LINKFLAGS) ;
MakeLocate Pt-Qt : $(PT_OUTPUT_TARGET) ;
MakeInstall Pt-Qt : $(PT_INSTALL_LIBDIR) ;

SubInclude PT_TOP src Pt-Qt demo ;
