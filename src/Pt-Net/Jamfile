                       HttpReply.cpp
                       HttpRequest.cpp
                       QueryParams.cpp
                       Socket.cpp
                       TcpSocket.cpp
                       TcpServerSocket.cpp
                       ;

SharedLibrary_LinkSharedLibraries Pt-Net : Pt Pt-System ;
SharedLibrary_AddLibraries Pt-Net : $(NETLIBS) ;
SharedLibrary_MakeLocate Pt-Net : $(OUTPUT_TARGET) ;

PtUnitTest TcpSocketTest : TcpSocketTest.cpp ;
Main_LinkSharedLibraries TcpSocketTest : Pt Pt-Net Pt-System Pt-Unit ;
PtUnitTest_MakeLocate TcpSocketTest : $(OUTPUT_TARGET) ;

# Define pseudo targets to call from projects
NOTFILE Pt-Net-all ;
DEPENDS Pt-Net-all :  Pt-Net
                      TcpSocketTest
                      ;
