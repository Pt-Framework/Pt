SubDir TOP src Pt-Net ;
SubDirHdrs $(TOP)/include ;
SubDirC++Flags [ FDefines PT_NET_API_EXPORT ] ;
SubDirHdrs $(TOP)/src/Pt-Net/$(SYS:L) ;
SubDirHdrs $(TOP)/src/Pt-System/$(SYS:L) ;

PT_NET_SUBDIR = [ FDirName $(TOP) src Pt-Net $(SYS:L) ] ;
PT_NET_IMPL += [ GLOB $(PT_NET_SUBDIR) : *.cpp  ] ;

SharedLibrary Pt-Net : $(PT_NET_IMPL)
                       TcpServer.cpp
                       TcpSocket.cpp ;
SharedLibrary_LinkSharedLibraries Pt-Net : Pt Pt-System ;
SharedLibrary_MakeLocate Pt-Net : $(OUTPUT_TARGET) ;
LINKLIBS on $(PRELIB)Pt-Net$(SUFDLL) = $(LINKLIBS) $(NETLIBS) ;

# Pseudo target to call from projects
NOTFILE Pt-Net-all ;
DEPENDS Pt-Net-all : Pt-Net ;

SubInclude TOP src Pt-Net tests ;
