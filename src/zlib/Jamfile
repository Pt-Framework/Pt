SubDir PT_TOP src zlib ;
SubDirHdrs $(PT_TOP)/src/zlib ;
#SubDirHdrs $(PT_TOP)/src/zlib/include ;
SubDirObjects $(PT_OUTPUT_OBJECT) zlib ;

ZLIB_TARGET = [ Package-Target zlib ] ;

if ! $(ZLIB_TARGET)
{
    ZLIB_TARGET = z ;

    if ! $(PRELIB)
    {
        ZLIB_TARGET = libz ;
    }
}

Library $(ZLIB_TARGET) : adler32.c
                          compress.c
                          crc32.c
                          deflate.c
                          # gzclose.c
                          # gzlib.c
                          # gzread.c
                          # gzwrite.c
                          infback.c
                          inffast.c
                          inflate.c
                          inftrees.c
                          trees.c
                          uncompr.c
                          zutil.c ;

MakeLocate $(ZLIB_TARGET) : $(PT_OUTPUT_TARGET) ;
