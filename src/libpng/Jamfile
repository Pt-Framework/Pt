SubDir png.TOP ;

SubDirHdrs [ Package-Includes png ] ;
SubDirCcFlags [ Package-Defines png ] ;
SubDirCcFlags [ FDefines _CRT_SECURE_NO_WARNINGS ] ;
SubDirCcFlags [ FDefines PNG_ARM_NEON_OPT=0 ] ;

if [ Builtin-Get png : OUTPUT_OBJECT ]
{
    SubDirObjects [ Builtin-Get png : OUTPUT_OBJECT ] png ;
}

Library png : png.c
              pngerror.c
              pngget.c
              pngmem.c
              pngpread.c
              pngread.c
              pngrio.c
              pngrtran.c
              pngrutil.c
              pngset.c
              pngtrans.c
              pngwio.c
              pngwrite.c
              pngwtran.c
              pngwutil.c ;

if [ Builtin-Get png : OUTPUT_TARGET ]
{
    MakeLocate png : [ Builtin-Get png : OUTPUT_TARGET ] ;
}
