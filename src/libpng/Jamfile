SubDir PT_TOP src libpng ;
SubDirHdrs $(PT_TOP)/src/libpng ;
SubDirObjects $(PT_OUTPUT_OBJECT) libpng ;
SubDirCcFlags [ FDefines _CRT_SECURE_NO_WARNINGS ] ;

if [ Package-Includes zlib ]
{
    SubDirHdrs [ Package-Includes zlib ] ;
}

if [ Package-Defines zlib ]
{
    SubDirCcFlags [ Package-Defines zlib ] ;
}
SubDirCcFlags [ FDefines PNG_ARM_NEON_OPT=0 ] ;

Library png : png.c
              pngerror.c
              pngget.c
              pngmem.c
              pngpread.c
              pngread.c
              pngrio.c
              pngrtran.c
              pngrutil.c
              pngset.c
              pngtrans.c
              pngwio.c
              pngwrite.c
              pngwtran.c
              pngwutil.c ;

MakeLocate png : $(PT_OUTPUT_TARGET) ;
