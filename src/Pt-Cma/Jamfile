SubDir PT_TOP src Pt-Cma ;
SubDirHdrs $(PT_TOP)/include ;
SubDirC++Flags [ FDefines PT_CMA_API_EXPORT ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) Pt-Cma ;

PT_CMA_SOURCES = Component.cpp
                 ComponentFactory.cpp
                 ComponentLibrary.cpp
                 IUnknown.cpp
                 ;

SharedLibrary Pt-Cma : $(PT_CMA_SOURCES) ;
LinkSharedLibraries Pt-Cma : Pt Pt-System ;
MakeLocate Pt-Cma : $(PT_OUTPUT_TARGET) ;
