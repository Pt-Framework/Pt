SubDir PT_TOP src mbedtls ;
SubDirHdrs [ Packages-Includes mbedtls ] ;
SubDirObjects $(PT_OUTPUT_OBJECT) mbedtls ;

MBEDTLS_SUBDIR   = [ FDirName $(PT_TOP) src mbedtls library ] ;
MBEDTLS_SOURCES += [ GLOB $(MBEDTLS_SUBDIR) : *.c  ] ;

Library mbedtls : $(MBEDTLS_SOURCES) ;
MakeLocate mbedtls : $(PT_OUTPUT_TARGET) ;
