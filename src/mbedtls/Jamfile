SubDir mbedtls.TOP ;

SubDirHdrs [ Package-Includes mbedtls ] ;

if [ Builtin-Get mbedtls : OUTPUT_OBJECT ]
{
    SubDirObjects [ Builtin-Get mbedtls : OUTPUT_OBJECT ] mbedtls ;
}

MBEDTLS_SUBDIR   = [ FDirName [ Builtin-Top mbedtls ] library ] ;
MBEDTLS_SOURCES += [ GLOB $(MBEDTLS_SUBDIR) : *.c  ] ;

Library mbedtls : $(MBEDTLS_SOURCES) ;

if [ Builtin-Get mbedtls : OUTPUT_TARGET ]
{
    MakeLocate mbedtls : [ Builtin-Get mbedtls : OUTPUT_TARGET ] ;
}
