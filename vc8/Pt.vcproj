	<Configurations>
		<Configuration
			Name="Debug|Pocket PC 2003 (ARMV4)"
			OutputDirectory="..\bin"
			IntermediateDirectory="..\tmp\src\Pt"
			ConfigurationType="0"
			BuildLogFile="$(SolutionDir)\$(TargetName).htm"
			ExcludeBuckets="7"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="cd .. &amp; jam.exe -q -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug -sTARGET_OS=wince -sTARGET_OSPLAT=arm Pt"
				ReBuildCommandLine="cd ..) &amp; jam.exe -qa -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug -sTARGET_OS=wince -sTARGET_OSPLAT=arm Pt"
				CleanCommandLine="cd .. &amp; jam.exe -sTOOLSET=vc8 -sVISUALC=&quot;$(VSInstallDir)\&quot; -sCONFIG=debug -sTARGET_OS=wince -sTARGET_OSPLAT=arm clean"
				Output="$(OutDir)\Ptd.dll"
				PreprocessorDefinitions="WIN32;_DEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
			<Tool
				Name="VCCLCompilerTool"
				ExecutionBucket="7"
			/>
			<Tool
				Name="VCCodeSignTool"
			/>
