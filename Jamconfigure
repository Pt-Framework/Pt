        #BLEND2D_C++FLAGS += [ FDefines BL_TARGET_OPT_BMI2 BL_TARGET_OPT_POPCNT ] ;
        BLEND2D_C++FLAGS += $(CPU_AVX2_C++FLAGS) ;
    }
    else if $(WITH_CPU_AVX1)
    {
        BLEND2D_C++FLAGS += [ FDefines BL_BUILD_OPT_AVX ] ;
        BLEND2D_C++FLAGS += $(CPU_AVX2_C++FLAGS) ;
    }
    else if $(WITH_CPU_NEON)
    {
        BLEND2D_C++FLAGS += [ FDefines BL_BUILD_OPT_ASIMD ] ;
        BLEND2D_C++FLAGS +=  $(CPU_NEON_C++FLAGS) ;
    }

    Configure BLEND2D_INCLUDES ;
    EchoOption BLEND2D_INCLUDES : "Blend2d includes" ;

    Configure BLEND2D_C++FLAGS ;
    EchoOption BLEND2D_C++FLAGS : "Blend2d C++ flags" ;

    Configure BLEND2D_LINKLIBS ;
    EchoOption BLEND2D_LINKLIBS : "Blend2d linklibs" : $(BLEND2D_LINKLIBS:E="none") ;
}

