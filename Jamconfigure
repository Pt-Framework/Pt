Configure GUI ;
EchoOption GUI : "Graphics UI" ;

if $(GUI)
{
    Configure GUILIBS ;
    EchoOption GUILIBS : "Graphics UI lib flags" ;
}


if --with-hmi in $(ARGV)
{
    WITH_HMI = yes ;
    Configure WITH_HMI ;
    EchoOption WITH_HMI : "HMI module" ;
