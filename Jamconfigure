#############################################################################
# Compiler and linker settings
#############################################################################

# configure basic C compiler
ConfigureCc ;

# configure basic C++ compiler
ConfigureC++ ;

# ConfigureDefine test.h : PT_WITH_STD_LOCALE : $(WITH_STD_LOCALE) ;

#############################################################################
# Platform settings
#############################################################################

if ! $(SYS)
{
    WITH_WIN32 = [ CheckBuildC++ "#include <windows.h>"
                                 "int main() { return 0; }" ] ;
    if $(WITH_WIN32)
    {
        SYS = win32 ;
    }
    else
    {
        SYS = posix ;
    }
}

Echo "Checking for subsystem ..." $(SYS) ;
Configure SYS ;

if $(SYS) = "win32"
{
    SYS ?= win32 ;
    GUI ?= gdi ;

    WITH_PSAPI = [ CheckBuildC++ "#include <windows.h>"
                                 "#include <Psapi.h>"
                                 "int main() { PROCESS_MEMORY_COUNTERS pmc;"
                                 "GetProcessMemoryInfo( NULL, &pmc, sizeof(pmc) );"
                                 "return 0; }"
                                 : ""
                                 : Psapi ] ;

    Echo "Checking for psapi library..." $(WITH_PSAPI) ;
    if $(WITH_PSAPI)
    {
        SYSLIBS += Psapi.lib ;
    }


    if ! $(NETLIBS)
    {
        WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                   "#include <windows.h>"
                                   "#include <winsock2.h>"
                                   "int func() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                   "return 0; }"
                                   : ""
                                   : wsock32 ws2_32 ] ;

        if $(WITH_WSA)
        {
            NETLIBS = wsock32.lib ws2_32.lib ;
        }
    }

    if ! $(NETLIBS)
    {
        WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                   "#include <windows.h>"
                                   "#include <winsock2.h>"
                                   "int func() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                   "return 0; }"
                                   : ""
                                   : winsock Ws2 ] ;
        if $(WITH_WSA)
        {
            NETLIBS = winsock.lib Ws2.lib ;
        }
    }

    if ! $(NETLIBS)
    {
        Exit "Checking for wsa library..." FAILED ;
    }
}
else if $(SYS) = "posix"
{
    WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                              "int main() { dlopen(0,0); return 0; }"
                            : ""
                            : c ] ;

    if ! $(WITH_DL)
    {
        WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                                  "int main() { dlopen(0,0); return 0; }"
                                : ""
                                : dl ] ;

        if $(WITH_DL)
        {
            SYSLIBS += -ldl ;
        }
    }

    if ! $(WITH_DL)
    {
        Exit "Checking for dl library..." FAILED ;
    }

    WITH_UNIX_SOCKETS = [ CheckBuildC++ "#include <sys/types.h>"
                                        "#include <sys/socket.h>"
                                        "int main() { return socket(0,0,0); }"
                                      : ""
                                      : "c" ] ;





    WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                    "int main() { pthread_t id; void* p; pthread_join(id, &p); return 0; }"
                                  : ""
                                  : c ] ;

    if ! $(WITH_PTHREADS)
    {
        WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                        "int main() { pthread_t id; void* p; pthread_join(id, &p); return 0; }"
                                      : ""
                                      : pthread ] ;

        if $(WITH_PTHREADS)
        {
            SYSLIBS += -lpthread ;
        }
    }

    if ! $(WITH_PTHREADS)
    {
        Exit "Checking for pthreads library..." FAILED ;
    }





    if ! $(WITH_UNIX_SOCKETS)
    {
        WITH_UNIX_SOCKETS = [ CheckBuildC++ "#include <sys/types.h>"
                                            "#include <sys/socket.h>"
                                            "int main() { return socket(0,0,0); }"
                                          : ""
                                          : socket ] ;

        if $(WITH_UNIX_SOCKETS)
        {
            NETLIBS += -lsocket ;
        }
    }

    if ! $(WITH_UNIX_SOCKETS)
    {
        Exit "Checking for socket library..." FAILED ;
    }


    WITH_NSL = [ CheckBuildC++ "#include <netdb.h>"
                               "int main() { gethostbyname(\"1.2.3.4\"); return 0; }"
                              : ""
                              : "c" ] ;

    if ! $(WITH_NSL)
    {
        # check for nsl library
        WITH_UNIX_NSL = [ CheckBuildC++ "#include <netdb.h>"
                                        "int main() { gethostbyname(\"1.2.3.4\"); return 0; }"
                                      : ""
                                      : nsl ] ;

        if $(WITH_NSL)
        {
            NETLIBS += -lnsl ;
        }
    }
    
    if ! $(WITH_NSL)
    {
        Exit "Checking for nsl library..." FAILED ;
    }  
}

if $(TARGET_OS:L) = "linux"
{
    SYS     ?= posix ;
    GUI     ?= x11 ;
    SYSLIBS += -lrt ;
    #NETLIBS = -lnsl ;
}
if $(TARGET_OS:L) = "macosx"
{
    SYS     ?= posix ;
    GUI     ?= cocoa ;
}
if $(TARGET_OS:L) = "aspen"
{
    SYS     ?= posix ;
    GUI     ?= uikit ;
}
if $(TARGET_OS) = "aix"
{
    SYS      ?= posix ;
    GUI      ?= x11 ;
    SYSLIBS  += -lrt ;
    LINKLIBS += $(SYSLIBS) ;
}
if $(TARGET_OS) = "solaris"
{
    SYS     ?= posix ;
    GUI     ?= x11 ;
    SYSLIBS += -lrt ;
}
if $(TARGET_OS:L) = "qnxnto"
{
    SYS     ?= posix ;
    GUI     ?= photon ;
}

Configure SYSLIBS ;
Echo "Checking for system libraries..." $(SYSLIBS) ;

Configure NETLIBS ;
Echo "Checking for network libraries..." $(NETLIBS) ;

Configure GUI ;
Echo "Checking for graphics UI..." $(GUI) ;


#############################################################################
# OpenSSL libraries and includes
#############################################################################

WITH_OPENSSL ?= "no" ;

for local arg in $(ARGV)
{
    if $(arg) = "--with-openssl"
    {
        WITH_OPENSSL = "yes" ;
    }
}

Configure WITH_OPENSSL ;
Echo "Checking for OpenSSL (--with-openssl)..." $(WITH_OPENSSL) ;


#############################################################################
# HTTP2 libraries and includes
#############################################################################

WITH_HTTP2 ?= "no" ;

for local arg in $(ARGV)
{
    if $(arg) = "--with-http2"
    {
        WITH_HTTP2 = "yes" ;
    }
}

Configure WITH_HTTP2 ;
Echo "Checking for HTTP2 (--with-http2)..." $(WITH_HTTP2) ;


#############################################################################
# Gfx libraries and includes
#############################################################################

Load freetype.jam ;

ConfigureFreetype ;
    
if ! $(FREETYPE_INCLUDES) || ! $(FREETYPE_LINKFLAGS)
{
    FREETYPE_INCLUDES = src/Pt-Gfx/freetype/include ;
    FREETYPE_LINKFLAGS = "" ;

    Configure FREETYPE_INCLUDES ;
    Echo "Using builtin freetype library..." $(FREETYPE_INCLUDES) ;
}


#############################################################################
# GUI libraries and includes
#############################################################################

if $(GUI:L) = "gdi"
{
    if $(TARGET_OS:L) = "nt"
    {
        GUILIBS = gdi32.lib user32.lib ;
    }
    if $(MINGW) || $(TOOLSET) = "gcc"
    {
        GUILIBS = -lgdi32 -luser32 ;
                  #$(MINGW)$(SLASH)lib$(SLASH)libgdi32.a
                  #$(MINGW)$(SLASH)lib$(SLASH)libuser32.a  ;
    }
}
if $(GUI:L) = "x11"
{
    if ! $(GUILIBS) 
    {
        Load x11.jam ;

        ConfigureX11 ;
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            GUILIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) ;
        }
        else
        {   
            GUI = none ;
        }
    }
}
if $(GUI:L) = "photon"
{
    GUILIBS = -lphrender -lph ;
}
if $(GUI:L) = "symbian-eikon"
{
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\apparc.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\cone.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\eikcore.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\avkon.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\commonengine.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\estor.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\hlplch.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bafl.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\charconv.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\ws32.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\fbscli.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bitgdi.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\gdi.dso ;
}
if $(GUI:L) = "cocoa"
{
    GUILIBS = -framework AppKit -framework Foundation ;
}
if $(GUI:L) = "uikit"
{
    GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
}

Echo "Checking whether GUI library should be built..." $(GUI) ;
if $(GUI)
{
    Configure GUILIBS ;
    Echo "Checking for gui libs..." $(GUILIBS) ;
}

