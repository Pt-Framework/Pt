#############################################################################
# Networking libraries and includes
#############################################################################

if $(PT_SYSTEM) = win32
{
    WSA_LINKLIBS ?= ws2_32.lib Iphlpapi.lib ;

    WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                               "#include <windows.h>"
                               "#include <winsock2.h>"
                               "int main() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                               "return 0; }"
                               : ""
                               : $(WSA_LINKLIBS) ] ;

    if ! $(WITH_WSA)
    {
        WSA_LINKLIBS = Ws2.lib Iphlpapi.lib ;

        WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                   "#include <windows.h>"
                                   "#include <winsock2.h>"
                                   "int main() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                   "return 0; }"
                                   : ""
                                   : $(WSA_LINKLIBS) ] ;
    }

    if ! $(WITH_WSA)
    {
        WSA_LINKLIBS =  -lws2_32 -lIphlpapi ;

        WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                   "#include <windows.h>"
                                   "#include <winsock2.h>"
                                   "int main() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                   "return 0; }"
                                   : ""
                                   : $(WSA_LINKLIBS) ] ;
    }

    EchoOption WSA_LINKLIBS : "WSA2 libs" ;

    if ! $(WITH_WSA)
    {
        Exit "Error: windows sockets are required." ;
    }

    NETLIBS += $(WSA_LINKLIBS) ;
}

if $(PT_SYSTEM) = posix
{
    # QNX can link programs without -lsocket, but needs it for libraries

    UNIX_SOCKETS_LINKLIBS ?= -lsocket ;

    WITH_UNIX_SOCKETS = [ CheckBuildC++ "#include <sys/types.h>"
                                        "#include <sys/socket.h>"
                                        "int main() { return socket(0,0,0); }"
                                        : ""
                                        : $(UNIX_SOCKETS_LINKLIBS) ] ;

    if ! $(WITH_UNIX_SOCKETS)
    {
        UNIX_SOCKETS_LINKLIBS = "" ;

        WITH_UNIX_SOCKETS = [ CheckBuildC++ "#include <sys/types.h>"
                                            "#include <sys/socket.h>"
                                            "int main() { return socket(0,0,0); }"
                                            : ""
                                            : -lc ] ;
    }

    EchoOption UNIX_SOCKETS_LINKLIBS : "Unix sockets libs" ;

    if ! $(WITH_UNIX_SOCKETS)
    {
        Exit "Error: unix sockets are required." ;
    }

    WITH_NSL = [ CheckBuildC++ "#include <netdb.h>"
                               "int main() { gethostbyname(\"1.2.3.4\"); return 0; }"
                               : ""
                               : "-lc" ] ;

    if ! $(WITH_NSL)
    {
        NSL_LINKLIBS ?= -lnsl ;

        WITH_NSL = [ CheckBuildC++ "#include <netdb.h>"
                                   "int main() { gethostbyname(\"1.2.3.4\"); return 0; }"
                                   : ""
                                   : $(NSL_LINKLIBS) ] ;
    }

    if ! $(WITH_NSL)
    {
        NSL_LINKLIBS = -lsocket ;

        WITH_NSL = [ CheckBuildC++ "#include <netdb.h>"
                                   "int main() { gethostbyname(\"1.2.3.4\"); return 0; }"
                                   : ""
                                   : $(NSL_LINKLIBS) ] ;
    }

    EchoOption NSL_LINKLIBS : "network services libs" ;

    if ! $(WITH_NSL)
    {
        Exit "Error: NSL is required." ;
    }

    NETLIBS += $(NSL_LINKLIBS) $(UNIX_SOCKETS_LINKLIBS) ;
}

Configure NETLIBS ;
EchoOption NETLIBS : "Network libs" ;

