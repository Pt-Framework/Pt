                             $(QT_LINKLIBS) : $(QT_LIBDIR) : $(QT_LINKFLAGS) ] ;

    if ! $(WITH_QT)
    {
        Exit "Error: Qt headers and libraries not found." ;
    }

    WITH_QT_MOC = [ Qt-ConfigureMoc ] ;

    if ! $(WITH_QT_MOC)
    {
        Exit "Error: Qt moc tool not found." ;
    }

    WITH_QT_RCC = [ Qt-ConfigureRcc ] ;
    WITH_QT_UIC = [ Qt-ConfigureUic ] ;
}

EchoOption --with-qt5 : "Qt support" : $(WITH_QT:E="no") ;

if $(WITH_QT)
{
    Configure WITH_QT ;
    EchoOption QTDIR : "Qt directory" ;

    Configure QT_INCLUDES ;
    EchoOption QT_INCLUDES : "Qt includes" ;

    Configure QT_C++FLAGS ;
    EchoOption QT_C++FLAGS : "Qt C++ flags" ;

    Configure QT_LINKLIBS ;
    EchoOption QT_LINKLIBS : "Qt link libs" ;

    Configure QT_LINKFLAGS ;
    EchoOption QT_LINKFLAGS : "Qt link flags" ;

    Configure QT_MOC ;
    EchoOption QT_MOC : "Qt moc tool" ;

    if $(WITH_QT_RCC)
    {
        Configure QT_RCC ;
        EchoOption QT_RCC : "Qt rcc tool" ;
    }

    if $(WITH_QT_UIC)
    {
        Configure QT_UIC ;
        EchoOption QT_UIC : "Qt uic tool" ;
    }
}

#############################################################################
# Pt-Forms libraries and includes
#############################################################################

PT_FORMS_IMPL = ;
PT_FORMS_RENDERER = ;
PT_FORMS_INCLUDES = ;
PT_FORMS_LINKLIBS = ;
PT_FORMS_GRAPHICS = generic ;

WITH_FORMS_DIRECT2D = ;
WITH_FORMS_GDI = ;
WITH_FORMS_VULKAN = ;
WITH_FORMS_NANOVG = ;

# Platform defaults
 if $(PT_SYSTEM) = win32
{
    PT_FORMS_IMPL = win32 ;
}
else if $(TARGET_OS) = "macosx"
{
    PT_FORMS_IMPL = cocoa ;
}
else if $(TARGET_OS) = "linux"
{
    PT_FORMS_IMPL = linux-fb ;
}
else if $(TARGET_OS) = "emscripten"
{
    PT_FORMS_IMPL = emscripten ;
}

# Platform overrides
if --with-wayland in $(ARGV)
{
    PT_FORMS_IMPL = wayland ;
}
else if --with-x11 in $(ARGV)
{
    PT_FORMS_IMPL = x11 ;
}
else if --with-linux-fb in $(ARGV)
{
    PT_FORMS_IMPL = linux-fb ;
}
else if --with-drm in $(ARGV)
{
    PT_FORMS_IMPL = linux-drm ;
}

# Graphics backend options
if --with-direct2d in $(ARGV)
{
    PT_FORMS_GRAPHICS += direct2d ;
    WITH_FORMS_DIRECT2D = yes ;
}

if --with-gdi in $(ARGV)
{
    PT_FORMS_GRAPHICS += gdi ;
    WITH_FORMS_GDI = yes ;
}

if --with-vulkan in $(ARGV)
{
    PT_FORMS_GRAPHICS += vulkan ;
    WITH_FORMS_VULKAN = vulkan ;
}

if --with-nanovg in $(ARGV)
{
    PT_FORMS_GRAPHICS += nanovg ;
    WITH_FORMS_NANOVG = nanovg ;
}

# Vulkan backend
if $(WITH_FORMS_VULKAN)
{
    local WITH_VULKAN = [ CheckBuildC++ "#include <vulkan/vulkan.h>"
                                        "int main() {"
                                        "return 0; }"
                                        : ""
                                        : "-lvulkan" ] ;
    if $(WITH_VULKAN)
    {
        PT_FORMS_LINKLIBS += -lvulkan ;
        PT_FORMS_C++FLAGS += [ FDefines PT_FORMS_WAYLAND_VULKAN ] ;
    }
    else
    {
        Exit "Failed: Vulkan not found." ;
    }
}

# NanoVG backend
if $(WITH_FORMS_NANOVG)
{
    # TODO: $(EGL_LIBS) && $(GLESV2_LIBS)
}

# Direct2D backend
if $(WITH_FORMS_DIRECT2D)
{
    PT_FORMS_LINKLIBS += "d2d1.lib" "d3d11.lib" "dxgi.lib" "dwrite.lib" "dxguid.lib" "windowscodecs.lib" ;
}

# GDI backend
if $(WITH_FORMS_GDI)
{
    Load winui.jam ;
    ConfigureGdi ;

    if $(WITH_GDI)
    {
        PT_FORMS_LINKLIBS += $(GDI_LIBS) ;
    }
    else
    {
        Exit "Failed: windows GDI not found." ;
    }
}

if $(PT_FORMS_IMPL:L) = "win32"
{
    Load winui.jam ;
    ConfigureWinUI ;

    if $(WITH_WINUI)
    {
        PT_FORMS_LINKLIBS += $(WINUI_LIBS) ;

        # Direct2d always needed buffer disapply
        if ! $(WITH_FORMS_DIRECT2D)
        {
            PT_FORMS_LINKLIBS += "d2d1.lib" "d3d11.lib" "dxgi.lib" "dwrite.lib" "dxguid.lib" ;
        }

        # gdi32 always needed for win32 (cursor handling)
        if ! $(WITH_FORMS_GDI)
        {
            PT_FORMS_LINKLIBS += "gdi32.lib" ;
        }

        WITH_FORMS = yes ;
    }
    else
    {
        Exit "Failed: windows user32 not found." ;
    }
}
else if $(PT_FORMS_IMPL:L) = "x11"
{
    Load x11.jam ;

    ConfigureX11 ;

    if $(X11_LIBS)
    {
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            PT_FORMS_INCLUDES = [ Package-Includes freetype ] $(X11_INCLUDES) $(XFT_INCLUDES) ;
            PT_FORMS_LINKLIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) ;
            WITH_FORMS = yes ;
        }
        else
        {
            Exit "Failed: Xext/Xft not found." ;
        }
    }
    else
    {
        Exit "Failed: X11 core not found." ;
    }
}
else if $(PT_FORMS_IMPL:L) = "cocoa"
{
    PT_FORMS_RENDERER = ;

    WITH_COCOA = [ CheckBuildC++ "#include <CoreFoundation/CFRunLoop.h>"
                                 "int main() {"
                                 "CFRunLoopRef l = CFRunLoopGetMain();"
                                 "return 0; }"
                               : ""
                               : -framework AppKit -framework Foundation ] ;

    if $(WITH_COCOA)
    {
        PT_FORMS_LINKLIBS = -framework AppKit -framework Foundation ;
        WITH_FORMS = yes ;
    }
    else
    {
        Exit "Failed: Cocoa not found." ;
    }
}
else if $(PT_FORMS_IMPL:L) = "linux-fb"
{
    WITH_LINUX_FB = [ CheckBuildC++ "#include <linux/fb.h>"
                                    "int main() {"
                                    "struct fb_var_screeninfo si;"
                                    "return 0; }"
                                   : "" : "" ] ;
    if $(WITH_LINUX_FB)
    {
        WITH_FORMS = yes ;

        Load simd.jam ;

        if $(WITH_CPU_NEON)
        {
            PT_FORMS_C++FLAGS += [ FDefines PT_FORMS_WITH_CPU_NEON ] ;
            PT_FORMS_C++FLAGS += $(CPU_NEON_C++FLAGS) ;
        }
    }
    else
    {
        Exit "Failed: linux-fb not found." ;
    }
}
else if $(PT_FORMS_IMPL:L) = "linux-drm"
{
    WITH_DRM = [ CheckBuildC++ "#include <xf86drm.h>"
                               "#include <xf86drmMode.h>"
                               "int main() {"
                               "return 0; }"
                             : "-I=/usr/include/libdrm"
                             : "-ldrm" ] ;

    if $(WITH_DRM)
    {
        PT_FORMS_C++FLAGS += "-I=/usr/include/libdrm" ;
        PT_FORMS_LINKLIBS = -ldrm ;
        WITH_FORMS = yes ;
    }
    else
    {
        Exit "Failed: DRM/KMS not found." ;
    }
}
else if $(PT_FORMS_IMPL:L) = "wayland"
{
    Load wayland.jam ;
    ConfigureWayland ;

    if $(WAYLAND_LIBS) && $(XKBCOMMON_LIBS)
    {
        PT_FORMS_LINKLIBS = $(WAYLAND_LIBS) $(WAYLAND_CURSOR_LIBS) $(XKBCOMMON_LIBS) ;
        WITH_FORMS = yes ;
    }
    else
    {
        Exit "Failed: wayland nor found." ;
    }

    if $(WITH_FORMS_NANOVG)
    {
        ConfigureWaylandEgl ;

        if $(WAYLAND_EGL_LIBS) && $(EGL_LIBS) && $(GLESV2_LIBS)
        {
            PT_FORMS_LINKLIBS += $(EGL_LIBS) $(GLESV2_LIBS) $(WAYLAND_EGL_LIBS) $(M_LINKLIBS) ;
            PT_FORMS_INCLUDES += [ Package-Includes freetype ] ;
            PT_FORMS_C++FLAGS += [ FDefines PT_FORMS_WAYLAND_NANOVG ] ;
        }
        else
        {
            Exit "Failed: EGL, GLESv2 and wayland-egl not found." ;
        }
    }
}
else if $(PT_FORMS_IMPL:L) = "emscripten"
{
    WITH_FORMS = yes ;
}

Configure WITH_FORMS ;
EchoOption WITH_FORMS : "Forms module" : $(WITH_FORMS:E="no") ;

if $(WITH_FORMS)
{
    Configure PT_FORMS_IMPL ;
    EchoOption --with-<wayland|x11|linux-fb|drm> : "Forms platform" : $(PT_FORMS_IMPL) ;

    Configure WITH_FORMS_DIRECT2D ;
    Configure WITH_FORMS_GDI ;
    Configure WITH_FORMS_NANOVG ;
    EchoOption --with-<direct2d|gdi|nanovg> : "Forms graphics" : $(PT_FORMS_GRAPHICS) ;

    Configure PT_FORMS_INCLUDES ;
    EchoOption PT_FORMS_INCLUDES : "Forms platform includes" ;

    Configure PT_FORMS_LINKLIBS ;
    EchoOption PT_FORMS_LINKLIBS : "Forms platform linklibs" ;

    Configure PT_FORMS_C++FLAGS ;
    EchoOption PT_FORMS_C++FLAGS : "Forms platform C++ flags" ;
}
