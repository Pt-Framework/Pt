SubDir PT_TOP ;

#############################################################################
# Compiler and linker settings
#############################################################################

if --nlog in $(ARGV)
{
    CCFLAGS += [ FDefines NLOG ] ;
    C++FLAGS += [ FDefines NLOG ] ;
}

# configure basic C compiler
ConfigureCc ;

# configure basic C++ compiler
ConfigureC++ ;

#############################################################################
# Output directories used by MakeLocate and SubDirObjects
#############################################################################
PT_OUTPUT_TARGET ?= [ FDirName $(PT_TOP) build $(CONFIG) ] ;
EchoOption PT_OUTPUT_TARGET : "Pt Binary Output Dir" ;
Configure PT_OUTPUT_TARGET ;

PT_OUTPUT_OBJECT ?= [ FDirName $(PT_TOP) tmp $(CONFIG) ] ;
EchoOption PT_OUTPUT_OBJECT : "Pt Object Output Dir" ;
Configure PT_OUTPUT_OBJECT ;

PT_OUTPUT_TEST ?= $(PT_OUTPUT_TARGET) ;
EchoOption PT_OUTPUT_TEST : "Pt Testing Output Dir" ;
Configure PT_OUTPUT_TEST ;

#############################################################################
# Installation directories
#############################################################################
PT_INSTALL_DIR ?= [ FDirName $(PT_TOP) deploy $(CONFIG) ] ;

PT_INSTALL_BINDIR ?= [ FDirName $(PT_INSTALL_DIR) bin ] ; 
EchoOption PT_INSTALL_BINDIR : "Pt Binary Install Dir" ;
Configure PT_INSTALL_BINDIR ;

PT_INSTALL_INCLUDEDIR ?= [ FDirName $(PT_INSTALL_DIR) include ] ; 
EchoOption PT_INSTALL_INCLUDEDIR : "Pt Include Install Dir" ;
Configure PT_INSTALL_INCLUDEDIR ;

PT_INSTALL_LIBDIR ?= [ FDirName $(PT_INSTALL_DIR) lib ] ;
EchoOption PT_INSTALL_LIBDIR : "Pt Library Install Dir" ; 
Configure PT_INSTALL_LIBDIR ;

#############################################################################
# Atomic operations
#############################################################################

if ! $(WITH_ATOMICS)
{
    WITH_ATOMICS = [ CheckBuildC++ "int main() {"
                                   "int n = 0, m = 0;"
                                   "__atomic_load(&n, &m, __ATOMIC_SEQ_CST);"
                                   "return 0; }"
                                 : ""
                                 : "" ] ;

    if $(WITH_ATOMICS)
    {
        PT_ATOMICS_DEFINES = PT_ATOMICS_GNU_BUILTIN ;

        Configure PT_ATOMICS_DEFINES ;
        EchoOption PT_ATOMICS_DEFINES : "Atomicity support" ;
    }
}

#############################################################################
# System libraries and includes
#############################################################################

if $(TARGET_OS:L) = winrt
{
    SYS = winrt ;
}

if ! $(SYS)
{
    WITH_WIN32 = [ CheckBuildC++ "#include <windows.h>"
                                 "int main() { return 0; }" ] ;
    if $(WITH_WIN32)
    {
        Load win32.jam ;
    
        ConfigurePsapi ;
    
        if $(WITH_PSAPI)
        {
            SYSLIBS += $(PSAPI_LIBS) ;
        }
    
        ConfigureWsa ;
    
        if ! $(WITH_WSA)
        {
            Exit "ERROR: WSA is required." ;
        }
    
        NETLIBS = $(WSA_LIBS) ;
        SYS = win32 ;
    }
}

if ! $(SYS)
{
    Load posix.jam ;

    ConfigureDl ;

    if ! $(WITH_DL)
    {
        Exit "ERROR: dl is required." ;
    }

    ConfigurePThread ;

    if ! $(WITH_PTHREADS)
    {
        Exit "ERROR: pthread is required." ;
    }

    SYSLIBS += $(DL_LIBS) $(PTHREAD_LIBS) ;

    ConfigureUnixSockets ;

    if ! $(WITH_UNIX_SOCKETS)
    {
        Exit "ERROR: unix sockets are required." ;
    }

    ConfigureNsl ;
    
    if ! $(WITH_NSL)
    {
        Exit "ERROR: nsl is required." ;
    }

    NETLIBS = $(UNIX_SOCKET_LIBS) $(NSL_LIBS) ;
    SYS = posix ;
}

if $(TARGET_OS) = "aix"
{
    LINKLIBS += $(SYSLIBS) ;
}

EchoOption SYS : "Using subsystem" ;
Configure SYS ;

Configure SYSLIBS ;
EchoOption SYSLIBS : "System lib flags" ;

Configure NETLIBS ;
EchoOption NETLIBS : "Network lib flags" ;

#############################################################################
# SSL libraries and includes
#############################################################################

if --with-openssl in $(ARGV)
{   
    include [ FDirName src openssl Jamconfigure ] ;

    WITH_OPENSSL = "yes" ;
    Configure WITH_OPENSSL ;

    WITH_SSL = yes ;
    PT_SSL_IMPL = "openssl" ;
    SSL_INCLUDES = [ FDirName $(PT_TOP) src openssl include ] ;
}

if ! $(WITH_SSL)
{
    WITH_SSL = [ CheckBuildC++ "#include <Security/Security.h>"
                               "int main() {"
                               "SSLContextRef context;"
                               "SSLNewContext(false, &context);"
                               "return 0; }"
                               : ""
                               : "-framework Foundation" "-framework Security" ] ;

    if $(WITH_SSL)
    {
        PT_SSL_IMPL = "applessl" ;
        SSL_LINKLIBS = "-framework Foundation" "-framework Security" ;
    }
}

if ! $(WITH_SSL)
{
    WITH_SSL = [ CheckBuildC++ "#include <openssl/ssl.h>"
                               "int main() {"
                               "SSL_library_init();"
                                "return 0; }"
                               : [ FIncludes $(SSL_INCLUDES) ]
                               : -lssl -lcrypto ] ;

    if $(WITH_SSL)
    {
        PT_SSL_IMPL = "openssl" ;
        SSL_LINKLIBS = -lssl -lcrypto ;
    }
}

if ! $(WITH_SSL)
{
    PT_SSL_IMPL = "nossl" ;
}

Configure WITH_SSL ;
EchoOption WITH_SSL : "SSL support" : $(WITH_SSL:E="no")  ;

Configure PT_SSL_IMPL ;
EchoOption PT_SSL_IMPL : "SSL implementation" ;

EchoOption --with-openssl : "Builtin OpenSSL library" : $(WITH_OPENSSL:E="no") ;

Configure SSL_INCLUDES ;
EchoOption SSL_INCLUDES : "SSL includes" ;

Configure SSL_LINKLIBS ;
EchoOption SSL_LINKLIBS : "SSL libs" ;

#############################################################################
# Gfx libraries and includes
#############################################################################

Load freetype.jam ;

ConfigureFreetype ;
    
if ! $(FREETYPE_INCLUDES) || ! $(FREETYPE_LINKFLAGS)
{
    FREETYPE_INCLUDES = [ FDirName $(PT_TOP) src Pt-Gfx freetype include ] ;
    FREETYPE_LINKFLAGS = "" ;

    Configure FREETYPE_INCLUDES ;
    EchoOption FREETYPE_INCLUDES : "Builtin freetype library" ;
}

#############################################################################
# MFC Support
#############################################################################
if --with-mfc in $(ARGV)
{
    WITH_MFC = yes ;
    EchoOption WITH_MFC : "MFC Support" ;
    Configure WITH_MFC ;

    if ! $(VISUALC)
    {
        Exit "ERROR: MFC not supported on " $(TOOLSET) ;
    }

    MFC_INCLUDES = \"$(VISUALC)\\VC\\atlmfc\\include\" ;
    EchoOption MFC_INCLUDES : "MFC Include Directory" ;
    Configure MFC_INCLUDES ;

    if $(TARGET_OSPLAT:L) = "x86_64"
    {
        MFC_LIBDIR = \"$(VISUALC)\\VC\\atlmfc\\lib\\amd64\" ;
    }
    else if $(TARGET_OSPLAT:L) = "x86"
    {
        MFC_LIBDIR = \"$(VISUALC)\\VC\\atlmfc\\lib\" ;
    }
    else
    {
        Exit "ERROR: MFC not supported on " $(TARGET_OSPLAT) ;
    }

    MFC_LINKFLAGS = /LIBPATH:$(MFC_LIBDIR) ;
    EchoOption MFC_LINKFLAGS : "MFC Linker Flags" ;
    Configure MFC_LINKFLAGS ;
}


#############################################################################
# Wx Widgets Support
#############################################################################

if --with-wxwidgets in $(ARGV)
{
    WITH_WXWIDGETS = yes ;
    EchoOption WITH_WXWIDGETS : "Wx Widgets Support" ;
    Configure WITH_WXWIDGETS ;

    WXCONFIG ?= wxconfig ;
    EchoOption WXCONFIG : "Using wxconfig tool" ;

    WXCONFIG_CXXFLAGS = $(WXCONFIG) --cxxflags ;
    WXCONFIG_LIBS = $(WXCONFIG) --libs ;

    WXCONFIG_RESULT = [ EXEC $(WXCONFIG_CXXFLAGS:J=" ") ] ;
    if $(WXCONFIG_RESULT[1]) != 0
    {
        Exit "ERROR:" $(WXCONFIG) "does not work" ;
    }

    WX_C++FLAGS = $(WXCONFIG_RESULT[2-]) ;
    EchoOption WX_C++FLAGS : "wx Widgets C++ flags" ;
    Configure WX_C++FLAGS ;

    WXCONFIG_RESULT = [ EXEC $(WXCONFIG_LIBS:J=" ") ] ;
    if $(WXCONFIG_RESULT[1]) != 0
    {
        Exit "ERROR:" $(WXCONFIG) "does not work" ;
    }
    
    WX_LINKFLAGS = $(WXCONFIG_RESULT[2-]) ;
    EchoOption WX_LINKFLAGS : "wx Widgets link flags" ;
    Configure WX_LINKFLAGS ;
}

#############################################################################
# Qt Support
#############################################################################

if --with-qt5 in $(ARGV)
{
    Load qt.jam ;

    QT_INCLUDES ?= [ FDirName $(QTDIR) include ] ;
    EchoOption QT_INCLUDES : "Qt Include Directory" ;
    Configure QT_INCLUDES ;

    QT_LIBDIR ?= [ FDirName $(QTDIR) lib ] ;
    EchoOption QT_LIBDIR : "Qt Library Directory" ;
    Configure QT_LIBDIR ;

    #
    # Windows
    #
    if ! $(WITH_QT)
    {
        if $(WITH_DEBUG)
        {
            QT_TRY_LIBS = Qt5Cored.lib Qt5Widgetsd.lib Qt5Guid.lib ;
        }
        else
        {
            QT_TRY_LIBS = Qt5Core.lib Qt5Widgets.lib Qt5Gui.lib ;
        }

        WITH_QT = [ CheckBuildC++ "#include <QtWidgets/QPushButton>"
                                  "int main() { QPushButton button; return 0; }"
                                 : [ FIncludes $(QT_INCLUDES) ]
                                 : $(QT_TRY_LIBS)
                                 : $(QT_LIBDIR) ] ;

        if $(WITH_QT)
        {
            if $(WITH_DEBUG)
            {
                QT_CORE_LIBS = Qt5Cored.lib ;
                QT_WIDGETS_LIBS = Qt5Widgetsd.lib ;
                QT_LINKFLAGS = /LIBPATH:$(QTDIR)\\lib ;
            }
            else
            {
                QT_CORE_LIBS = Qt5Core.lib ;
                QT_WIDGETS_LIBS = Qt5Widgets.lib ;
                QT_LINKFLAGS = /LIBPATH:$(QTDIR)\\lib ;
            }
        }
    }

    #
    # Unix
    #
    if ! $(WITH_QT)
    {
        WITH_QT = [ CheckBuildC++ "#include <QtWidgets/QPushButton>"
                                  "int main() { QPushButton button; return 0; }"
                                 : [ FIncludes $(QT_INCLUDES) ]
                                 : -lQt5Core -lQt5Widgets -lQt5Gui
                                 : $(QT_LIBDIR) ] ;

        if $(WITH_QT)
        {
            QT_CORE_LIBS = -lQt5Core ;
            QT_WIDGETS_LIBS = -lQt5Widgets -lQt5Gui ;
        }
    }
    
    #
    # Mac OS-X
    #
    if ! $(WITH_QT)
    {
        WITH_QT = [ CheckBuildC++ "#include <QtWidgets/QPushButton>"
                                  "int main() { QPushButton button; return 0; }"
                                 : [ FIncludes $(QT_INCLUDES) ] -F$(QT_LIBDIR)
                                 : -framework QtCore -framework QtWidgets 
                                 : $(QT_LIBDIR) ] ;
                                 
        if $(WITH_QT)
        {
            C++FLAGS += -F$(QT_LIBDIR) ;
            QT_CORE_LIBS =  -framework QtCore ;
            QT_WIDGETS_LIBS = -framework QtWidgets -framework QtGui ;
            QT_LINKFLAGS = -F$(QT_LIBDIR) ;
        }
    }

    #
    # Linaro
    #
    if ! $(WITH_QT)
    {
        QT_LIBDIR_PRIVATE = [ FDirName $(TOOLSET_ROOT:D) .. lib ] ;
        QT_LIBDIR_PRIVATE += [ FDirName $(TOOLSET_ROOT:D) .. lib arm-linux-gnueabihf ] ;

        WITH_QT = [ CheckBuildC++ "#include <QtWidgets/QPushButton>"
                                  "int main() { QPushButton button; return 0; }"
                                 : [ FIncludes $(QT_INCLUDES) ]
                                 : -lQt5Core -lQt5Widgets -lQt5Gui -lGLESv2 -lPVRScopeServices -lIMGegl -lsrv_um -ldrm -ldrm_omap -lwayland-server -lffi 
                                 : $(QT_LIBDIR) $(QT_LIBDIR_PRIVATE) ] ;

        if $(WITH_QT)
        {
            QT_CORE_LIBS = -lQt5Core ;
            QT_WIDGETS_LIBS = -lQt5Widgets -lQt5Gui -lGLESv2 -lPVRScopeServices -lIMGegl -lsrv_um -ldrm -ldrm_omap -lwayland-server -lffi ;
            QT_LINKFLAGS = -L$(QT_LIBDIR) -L$(QT_LIBDIR_PRIVATE) ;
        }
    }

    EchoOption WITH_QT : "Qt Support" ;
    Configure WITH_QT ;

    if $(WITH_QT)
    {
        EchoOption QT_CORE_LIBS : "Qt Core Libraries" ;
        Configure QT_CORE_LIBS ;

        EchoOption QT_WIDGETS_LIBS : "Qt Widgets Libraries" ;
        Configure QT_WIDGETS_LIBS ;

        EchoOption QT_LINKFLAGS : "Qt Linker Flags" ;
        Configure QT_LINKFLAGS ;

        QT_LIBS = $(QT_CORE_LIBS) $(QT_WIDGETS_LIBS) ;
        EchoOption QT_LIBS : "Qt Link Libraries" ;
        Configure QT_LIBS ;
    }
    else
    {
        Exit "ERROR: Qt headers and libraries not found." ;
    }

    ConfigureMoc ;

    if ! $(WITH_QT_MOC)
    {
        Exit "ERROR: Qt moc tool not found." ;
    }
}

#############################################################################
# GUI libraries and includes
#############################################################################

if ! $(GUI) || GUI = "gdi"
{
    Load winui.jam ;

    ConfigureWinUI ;
    ConfigureGdi ;

    if $(WITH_GDI) && $(WITH_WINUI)
    {
        GUI = gdi ;
        GUILIBS = $(GDI_LIBS) $(WINUI_LIBS) ;
    }
}

if ! $(GUI) || GUI = "cocoa"
{
    WITH_GUI = [ CheckBuildC++ "#include <CoreFoundation/CFRunLoop.h>"
                               "int main() {"
                               "CFRunLoopRef l = CFRunLoopGetMain();"
                               "return 0; }"
                             : ""
                             : -framework AppKit -framework Foundation ] ;

    if $(WITH_GUI)
    {
        GUI = cocoa ;
        GUILIBS = -framework AppKit -framework Foundation ;
    }

    # iOS aspen:
    #GUI     ?= uikit ;
    #GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
}

if ! $(GUI)  || GUI = "x11"
{
    Load x11.jam ;

    ConfigureX11 ;
    if $(X11_LIBS)
    {
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            GUI = x11 ;
            GUILIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) ;
        }
    }
}

