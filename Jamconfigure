		}
		else if $(TARGET_OSPLAT:L) = "x86"
		{		
			MFC_LIBDIR = [ GLOB $(VISUALC)\\VC\\atlmfc : lib  ] ;
		}
	}
	
	if ! $(MFC_LIBDIR)
	{
		if $(TARGET_OSPLAT:L) = "x86_64"
		{	
			MFC_LIBDIR = [ GLOB $(VISUALC)\\atlmfc\\lib : x64  ] ;
		}
		else if $(TARGET_OSPLAT:L) = "x86"
		{		
			MFC_LIBDIR = [ GLOB $(VISUALC)\\atlmfc\\lib : x86  ] ;
		}
	}

	if ! $(MFC_LIBDIR)
	{
		Exit "Error: MFC libraries not found." ;
	}

    MFC_LINKFLAGS = /LIBPATH:\"$(MFC_LIBDIR)\" ;
    EchoOption MFC_LINKFLAGS : "MFC Linker Flags" ;
    Configure MFC_LINKFLAGS ;
}

#############################################################################
# Wx Widgets Support
#############################################################################

if --with-wxwidgets in $(ARGV)
{
    WITH_WXWIDGETS = yes ;
    EchoOption WITH_WXWIDGETS : "Wx Widgets Support" ;
    Configure WITH_WXWIDGETS ;

    WXCONFIG ?= wx-config ;
    EchoOption WXCONFIG : "Using wxconfig tool" ;

    WXCONFIG_CXXFLAGS = $(WXCONFIG) --cxxflags ;
    WXCONFIG_LIBS = $(WXCONFIG) --libs all ;

    WXCONFIG_RESULT = [ EXEC $(WXCONFIG_CXXFLAGS:J=" ") ] ;
    if $(WXCONFIG_RESULT[1]) != 0
    {
        Exit "Error:" $(WXCONFIG) "does not work" ;
    }

    WX_C++FLAGS = $(WXCONFIG_RESULT[2-]) ;
    EchoOption WX_C++FLAGS : "wx Widgets C++ flags" ;
    Configure WX_C++FLAGS ;

    WXCONFIG_RESULT = [ EXEC $(WXCONFIG_LIBS:J=" ") ] ;
    if $(WXCONFIG_RESULT[1]) != 0
    {
        Exit "Error:" $(WXCONFIG) "does not work" ;
    }

    WX_LINKLIBS = $(WXCONFIG_RESULT[2-]) ;
    EchoOption WX_LINKLIBS : "wx Widgets link flags" ;
    Configure WX_LINKLIBS ;
}

#############################################################################
# Qt Support
#############################################################################

if --with-qt5 in $(ARGV)
{
    QT5_SUPPORT = yes ;
}

if $(QT5_SUPPORT)
{
	QT5_LIBS = Qt5Core Qt5Widgets Qt5Gui ;
	QT_LIBS = QtCore QtWidgets QtGui ;

	if $(QTDIR)
	{
		QT_INCLUDES ?= [ FDirName $(QTDIR) include ] ;
		QT_LIBDIR ?= [ FDirName $(QTDIR) lib ] ;
	}

	QT_LINKLIBS ?= -l$(QT5_LIBS) ;
	QT_LINKFLAGS ?= -L$(QT_LIBDIR) ;

	WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
							  "int main() { QString qs; return 0; }"
							: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
							: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;

	if ! $(WITH_QT)
	{
		QT_C++FLAGS = -F$(QT_LIBDIR) ;
		QT_LINKLIBS = "-framework "$(QT_LIBS) ;
		QT_LINKFLAGS = -F$(QT_LIBDIR) ;

		WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
								  "int main() { QString qs; return 0; }"
								: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
								: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;
	}

	if ! $(WITH_QT)
	{
		if $(WITH_DEBUG) && ! $(WITH_OPTIM)
		{
			QT_SUFLIB = d.lib ;
		}

		QT_C++FLAGS = ;
		QT_LINKLIBS = $(QT5_LIBS:S=$(QT_SUFLIB:E=".lib")) ;
		QT_LINKFLAGS = /LIBPATH:$(QT_LIBDIR) ;

		WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
								  "int main() { QString qs; return 0; }"
								: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
								: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;
	}
}

EchoOption --with-qt5 : "Qt support" : $(QT5_SUPPORT:E="no") ;

if $(QT5_SUPPORT)
{
    EchoOption QTDIR : "Qt directory" ;
    Configure WITH_QT ;

	EchoOption QT_INCLUDES : "Qt includes" ;
	Configure QT_INCLUDES ;

	EchoOption QT_C++FLAGS : "Qt C++ flags" ;
	Configure QT_C++FLAGS ;

	EchoOption QT_LINKLIBS : "Qt link libs" ;
	Configure QT_LINKLIBS ;

	EchoOption QT_LINKFLAGS : "Qt link flags" ;
	Configure QT_LINKFLAGS ;

	if ! $(WITH_QT)
	{
		Exit "Error: Qt headers and libraries not found." ;
	}
}

#############################################################################
# Qt meta object compiler
#############################################################################

if $(WITH_QT)
{
    QT_MOC ?= moc ;

    WITH_QT_MOC = [ CheckBuild $(QT_MOC) check.h -o check.moc.cpp
                             : "#include <QtCore/QObject>"
                               "class moctest : public QObject{ Q_OBJECT };"
                             : check.h
                             : check.moc.cpp ] ;

    if ! $(WITH_QT_MOC)
    {
        QT_MOC = [ FDirName $(QTDIR) bin $(QT_MOC) ] ;

        WITH_QT_MOC = [ CheckBuild $(QT_MOC) check.h -o check.moc.cpp
                                  : "#include <QtCore/QObject>"
                                    "class moctest : public QObject{ Q_OBJECT };"
                                  : check.h
                                  : check.moc.cpp ] ;
    }

    EchoOption QT_MOC : "Qt moc tool" : $(QT_MOC) ;
    Configure QT_MOC : $(QT_MOC) ;

    if ! $(WITH_QT_MOC)
    {
        Exit "Error: Qt moc tool not found." ;
    }
}

#############################################################################
# GUI libraries and includes
#############################################################################

if --with-x11 in $(ARGV)
{
    GUI ?= x11 ;
}
if --with-x11-raster in $(ARGV)
{
    GUI ?= x11 ;
}
else if --with-x11-core in $(ARGV)
{
    GUI ?= x11 ;
}
else if --with-win32-gdi in $(ARGV)
{
    GUI ?= win32 ;
}
else if --with-win32-raster in $(ARGV)
{
    GUI ?= win32 ;
}
else if --with-sdl-raster in $(ARGV)
{
    GUI ?= sdl ;
}
else if --with-photon in $(ARGV)
{
    GUI ?= photon ;
}

if ! $(GUI) || $(GUI:L) = "win32"
{
    Load winui.jam ;

    ConfigureWinUI ;
    ConfigureGdi ;

    if $(WITH_GDI) && $(WITH_WINUI)
    {
        GUI ?= win32 ;
        GUILIBS = $(GDI_LIBS) $(WINUI_LIBS) ;
    }
    
    if $(GUI)
    {
        if --with-win32-raster in $(ARGV)
        {
            PT_FORMS_IMPL = win32-raster ;
        }
        else
        {
            PT_FORMS_IMPL = win32-gdi ;
        }
    }
}

if ! $(GUI) || $(GUI):L = "cocoa"
{
    WITH_GUI = [ CheckBuildC++ "#include <CoreFoundation/CFRunLoop.h>"
                               "int main() {"
                               "CFRunLoopRef l = CFRunLoopGetMain();"
                               "return 0; }"
                             : ""
                             : -framework AppKit -framework Foundation ] ;

    if $(WITH_GUI)
    {
        GUI = cocoa ;
        GUILIBS = -framework AppKit -framework Foundation ;
    }

    # iOS aspen:
    #GUI     ?= uikit ;
    #GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
    
    if $(GUI)
    {
        PT_FORMS_IMPL = cocoa ;
    }
}

if ! $(GUI) || $(GUI:L) = "linux-fb"
{
    WITH_GUI = [ CheckBuildC++ "#include <linux/fb.h>"
                               "int main() {"
                               "struct fb_var_screeninfo si;"
                               "return 0; }"
                             : ""
                             : "" ] ;

    if $(WITH_GUI)
    {
        GUI = linux-fb ;
    }
    
    if $(GUI)
    {
        PT_FORMS_IMPL = linux-fb ;

        Load simd.jam ;
        
        if $(WITH_CPU_NEON)
        {
            PT_FORMS_C++FLAGS += [ FDefines PT_FORMS_WITH_CPU_NEON ] ;
            PT_FORMS_C++FLAGS += $(CPU_NEON_C++FLAGS) ;
        }
    }
}

if ! $(GUI) || $(GUI:L) = "x11"
{
    Load x11.jam ;

    ConfigureX11 ;

    if $(X11_LIBS)
    {
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            GUI ?= x11 ;
            GUILIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) ;
        }
    }

    if $(GUI)
    {
        if --with-x11-core in $(ARGV)
        {
            PT_FORMS_IMPL = x11-core ;
        }
        else
        {
            PT_FORMS_IMPL = x11-raster ;
        }
    }
}

if $(GUI:L) = "sdl"
{
    PT_FORMS_IMPL = sdl ;
}

if $(GUI:L) = "photon"
{
    PT_FORMS_IMPL = photon ;
    GUILIBS = -lphrender -lph ;
}

Configure GUI ;
EchoOption GUI : "UI platform" : $(GUI:E="none") ;

if $(GUI)
{
    Configure PT_FORMS_IMPL ;
    EchoOption PT_FORMS_IMPL : "UI implementation" ;

    Configure GUILIBS ;
    EchoOption GUILIBS : "UI platform linklibs" ;

    Configure PT_FORMS_C++FLAGS ;
    EchoOption PT_FORMS_C++FLAGS : "UI platform C++ flags" ;
}
