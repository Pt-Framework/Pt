    PT_SYSTEM_LINKLIBS += $(PSAPI_LINKLIBS) ;
}

#
# Configuration for POSIX systems
#

if $(PT_SYSTEM) = posix
{
    #
    # System realtime clock
    #

    # Linux can link programs without -lrt, but needs it to run

    POSIX_CLOCK_LINKLIBS ?= -lrt ;

    WITH_POSIX_CLOCK = [ CheckBuildC++ "#include <time.h>"
                                       "#include <sys/time.h>"
                                       "int main() { timespec tp;"
                                       "clock_gettime(CLOCK_MONOTONIC, &tp);"
                                       "return 0; }"
                                       : ""
                                       : $(POSIX_CLOCK_LINKLIBS) ] ;

    if ! $(WITH_POSIX_CLOCK)
    {
        POSIX_CLOCK_LINKLIBS = "" ;

        WITH_POSIX_CLOCK = [ CheckBuildC++ "#include <time.h>"
                                           "#include <sys/time.h>"
                                           "int main() { timespec tp;"
                                           "clock_gettime(CLOCK_MONOTONIC, &tp);"
                                           "return 0; }"
                                           : ""
                                           : -lc ] ;
    }

    if ! $(WITH_POSIX_CLOCK)
    {
        POSIX_CLOCK_LINKLIBS = "" ;

        WITH_MACH_CLOCK = [ CheckBuildC++ "#include <mach/mach_time.h>"
                                          "int main() { mach_absolute_time(); return 0; }"
                                          : ""
                                          : "" ] ;
    }

    EchoOption POSIX_CLOCK_LINKLIBS : "Realtime clock libs" ;

    if $(WITH_MACH_CLOCK)
    {
        EchoOption WITH_MACH_CLOCK : "Mach clock" : $(WITH_MACH_CLOCK:E="no") ;
        Configure WITH_MACH_CLOCK ;
    }
    else if $(WITH_POSIX_CLOCK)
    {
        EchoOption WITH_POSIX_CLOCK : "POSIX clock" : $(WITH_POSIX_CLOCK:E="no") ;
        Configure WITH_POSIX_CLOCK ;
    }
    else
    {
        Exit "Error: clocks are required." ;
    }

    #
    # dynamic library loader
    #

    WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                              "int main() { dlopen(0,0); return 0; }"
                              : ""
                              : -lc ] ;

    if ! $(WITH_DL)
    {
        DL_LINKLIBS = -ldl ;

        WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                                  "int main() { dlopen(0,0); return 0; }"
                                  : ""
                                  : $(DL_LINKLIBS) ] ;
    }

    EchoOption DL_LINKLIBS : "Dl libs" ;

    if ! $(WITH_DL)
    {
        Exit "Error: dl is required." ;
    }

    #
    # POSIX threads
    #

    WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                    "int main() { pthread_t id; void* p;"
                                    "pthread_join(id, &p); return 0; }"
                                    : ""
                                    : -lc ] ;

    if ! $(WITH_PTHREADS)
    {
        PTHREAD_LINKLIBS = -lpthread ;

        WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                        "int main() { pthread_t id; void* p;"
                                        "pthread_join(id, &p); return 0; }"
                                        : ""
                                        : $(PTHREAD_LINKLIBS) ] ;
    }

    EchoOption PTHREAD_LINKLIBS : "Pthread libs" ;

    if ! $(WITH_PTHREADS)
    {
        Exit "Error: pthread is required." ;
    }

    #
    # POSIX math
    #

    WITH_M = [ CheckBuildC++ "#include <math.h>"
                             "int main() { return (int) sin(42); }"
                             : "" : -lc ] ;
    if ! $(WITH_M)
    {
        M_LINKLIBS = -lm ;

        WITH_M = [ CheckBuildC++ "#include <math.h>"
                                 "int main() { return (int) sin(42); }"
                                 : "" : $(M_LINKLIBS) ] ;
    }

    EchoOption M_LINKLIBS : "Math libs" ;

    PT_SYSTEM_LINKLIBS +=  $(POSIX_CLOCK_LINKLIBS) $(PTHREAD_LINKLIBS) $(DL_LINKLIBS) ;
}

if $(TARGET_OS) = "aix"
{
    LINKLIBS += $(PT_SYSTEM_LINKLIBS) ;
}

EchoOption PT_SYSTEM : "System abstraction" ;
Configure PT_SYSTEM ;

Configure PT_SYSTEM_LINKLIBS ;
