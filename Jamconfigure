SubDir PT_TOP ;

#############################################################################
# Compiler and linker settings
#############################################################################

if $(WITH_DEBUG) 
{ 
    CONFIG ?= debug ; 
}
else 
{ 
    CONFIG ?= release ; 
}

if --nlog in $(ARGV)
{
    CCFLAGS += [ FDefines NLOG ] ;
    C++FLAGS += [ FDefines NLOG ] ;
}

# configure basic C compiler
ConfigureCc ;

# configure basic C++ compiler
ConfigureC++ ;

#############################################################################
# output directories used by MakeLocate and SubDirObjects
#############################################################################
PT_OUTPUT_TARGET ?= [ FDirName $(PT_TOP) build $(CONFIG) ] ;
EchoOption PT_OUTPUT_TARGET : "Pt Binary Output Dir" ;
Configure PT_OUTPUT_TARGET ;

PT_OUTPUT_OBJECT ?= [ FDirName $(PT_TOP) tmp $(CONFIG) ] ;
EchoOption PT_OUTPUT_OBJECT : "Pt Object Output Dir" ;
Configure PT_OUTPUT_OBJECT ;

PT_OUTPUT_TEST ?= $(PT_OUTPUT_TARGET) ;
EchoOption PT_OUTPUT_TEST : "Pt Testing Output Dir" ;
Configure PT_OUTPUT_TEST ;

#############################################################################
# installation directories
#############################################################################
PT_INSTALL_DIR ?= [ FDirName $(PT_TOP) deploy $(CONFIG) ] ;

PT_INSTALL_BINDIR ?= [ FDirName $(PT_INSTALL_DIR) bin ] ; 
EchoOption PT_INSTALL_BINDIR : "Pt Binary Install Dir" ;
Configure PT_INSTALL_BINDIR ;

PT_INSTALL_INCLUDEDIR ?= [ FDirName $(PT_INSTALL_DIR) include ] ; 
EchoOption PT_INSTALL_INCLUDEDIR : "Pt Include Install Dir" ;
Configure PT_INSTALL_INCLUDEDIR ;

PT_INSTALL_LIBDIR ?= [ FDirName $(PT_INSTALL_DIR) lib ] ;
EchoOption PT_INSTALL_LIBDIR : "Pt Library Install Dir" ; 
Configure PT_INSTALL_LIBDIR ;

#############################################################################
# Platform settings
#############################################################################
if $(TARGET_OS:L) = winrt
{
    SYS = winrt ;
}

if ! $(SYS)
{
    WITH_WIN32 = [ CheckBuildC++ "#include <windows.h>"
                                 "int main() { return 0; }" ] ;
    if $(WITH_WIN32)
    {
        Load win32.jam ;
    
        ConfigurePsapi ;
    
        if $(WITH_PSAPI)
        {
            SYSLIBS += $(PSAPI_LIBS) ;
        }
    
        ConfigureWsa ;
    
        if ! $(WITH_WSA)
        {
            Exit "ERROR: WSA is required." ;
        }
    
        NETLIBS = $(WSA_LIBS) ;
        SYS = win32 ;
    }
}

if ! $(SYS)
{
    Load posix.jam ;

    ConfigureDl ;

    if ! $(WITH_DL)
    {
        Exit "ERROR: dl is required." ;
    }

    ConfigurePThread ;

    if ! $(WITH_PTHREADS)
    {
        Exit "ERROR: pthread is required." ;
    }

    SYSLIBS = $(DL_LIBS) $(PTHREAD_LIBS) ;

    ConfigureUnixSockets ;

    if ! $(WITH_UNIX_SOCKETS)
    {
        Exit "ERROR: unix sockets are required." ;
    }

    ConfigureNsl ;
    
    if ! $(WITH_NSL)
    {
        Exit "ERROR: nsl is required." ;
    }  

    NETLIBS = $(UNIX_SOCKET_LIBS) $(NSL_LIBS) ;
    SYS = posix ;
}

if $(TARGET_OS) = "aix"
{
    LINKLIBS += $(SYSLIBS) ;
}

EchoOption SYS : "Using subsystem" ;
Configure SYS ;

Configure SYSLIBS ;
EchoOption SYSLIBS : "System lib flags" ;

Configure NETLIBS ;
EchoOption NETLIBS : "Network lib flags" ;


#############################################################################
# OpenSSL libraries and includes
#############################################################################

if --with-builtin-openssl in $(ARGV)
{   
    WITH_OPENSSL = yes ;
    OPENSSL_INCLUDES = [ FDirName $(PT_TOP) src Pt-Ssl openssl include ] ;

    # find matching openssl configuration file first for SYS, then for TARGET_OS
    local opensslconf_target = [ FDirName $(PT_TOP) src Pt-Ssl openssl opensslconf-$(SYS:L)-$(TARGET_OSPLAT:L).h ] ;
    if ! [ CHECK_IF_FILE $(opensslconf_target) ]
    {
        opensslconf_target = [ FDirName $(PT_TOP) src Pt-Ssl openssl opensslconf-$(TARGET_OS:L)-$(TARGET_OSPLAT:L).h ] ;
        
        if ! [ CHECK_IF_FILE $(opensslconf_target) ]
        {
            Exit "ERROR: Could not configure builtin OpenSSL for selected target." ;
        }
    }

    # generate opensslconf.h file
    local opensslconf = [ FDirName $(PT_TOP) src Pt-Ssl openssl crypto opensslconf.h ] ;
    local r = [ TryCommand $(CP) $(opensslconf_target) $(opensslconf) ] ;
    if ! $(r)
    {
        Exit "ERROR: Could not copy opensslconf.h." ;
    }

    opensslconf = [ FDirName $(PT_TOP) src Pt-Ssl openssl include openssl opensslconf.h ] ;
    r = [ TryCommand $(CP) $(opensslconf_target) $(opensslconf) ] ;
    if ! $(r)
    {
        Exit "ERROR: Could not copy opensslconf.h." ;
    }
}

if ! $(WITH_OPENSSL)
{
    WITH_OPENSSL = [ CheckBuildC++ "#include <openssl/ssl.h>"
                                    "int main() {"
                                    "SSL_library_init();"
                                    "return 0; }"
                                    : [ FIncludes $(OPENSSL_INCLUDES) ]
                                    : -lssl -lcrypto ] ;

    if $(WITH_OPENSSL)
    {
        OPENSSL_LINKLIBS = -lssl -lcrypto ;
    }
}

EchoOption WITH_OPENSSL : "OpenSSL support" ;

if $(WITH_OPENSSL)
{
    Configure WITH_OPENSSL ;

    Configure OPENSSL_INCLUDES ;
    EchoOption OPENSSL_INCLUDES : "OpenSSL includes" ;

    if $(TARGET_OS:L) = "macosx"
    {
        OPENSSL_LINKLIBS += "-framework Foundation" "-framework Security" ;
    }

    Configure OPENSSL_LINKLIBS ;
    EchoOption OPENSSL_LINKLIBS : "OpenSSL library" ;
}


#############################################################################
# Gfx libraries and includes
#############################################################################

Load freetype.jam ;

ConfigureFreetype ;
    
if ! $(FREETYPE_INCLUDES) || ! $(FREETYPE_LINKFLAGS)
{
    FREETYPE_INCLUDES = [ FDirName $(PT_TOP) src Pt-Gfx freetype include ] ;
    FREETYPE_LINKFLAGS = "" ;

    Configure FREETYPE_INCLUDES ;
    EchoOption FREETYPE_INCLUDES : "Builtin freetype library" ;
}


#############################################################################
# GUI libraries and includes
#############################################################################

if ! $(GUI) || GUI = "gdi"
{
    Load winui.jam ;

    ConfigureWinUI ;
    ConfigureGdi ;

    if $(WITH_GDI) && $(WITH_WINUI)
    {
        GUI = gdi ;
        GUILIBS = $(GDI_LIBS) $(WINUI_LIBS) ;
    }
}

if ! $(GUI) || GUI = "cocoa"
{
    WITH_GUI = [ CheckBuildC++ "#include <CoreFoundation/CFRunLoop.h>"
                               "int main() {"
                               "CFRunLoopRef l = CFRunLoopGetMain();"
                               "return 0; }"
                             : ""
                             : -framework AppKit -framework Foundation ] ;

    if $(WITH_GUI)
    {
        GUI = cocoa ;
        GUILIBS = -framework AppKit -framework Foundation ;
    }

    # iOS aspen:
    #GUI     ?= uikit ;
    #GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
}

if ! $(GUI)  || GUI = "x11"
{
    Load x11.jam ;

    ConfigureX11 ;
    if $(X11_LIBS)
    {
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            GUI = x11 ;
            GUILIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) ;
        }
    }
}

if $(GUI:L) = "photon"
{
    GUI     ?= photon ;
    GUILIBS = -lphrender -lph ;
}

if $(GUI:L) = "symbian-eikon"
{
    GUI = symbian-eikon ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\apparc.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\cone.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\eikcore.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\avkon.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\commonengine.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\estor.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\hlplch.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bafl.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\charconv.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\ws32.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\fbscli.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\bitgdi.dso ;
    GUILIBS    += $(EPOCROOT)\\EPOC32\\RELEASE\\ARMV5\\LIB\\gdi.dso ;
}


Configure GUI ;
EchoOption GUI : "Graphics UI" ;

if $(GUI)
{
    Configure GUILIBS ;
    EchoOption GUILIBS : "Graphics UI lib flags" ;
}


if --with-hmi in $(ARGV)
{
	WITH_HMI = yes ;
    Configure WITH_HMI ;
    EchoOption WITH_HMI : "HMI module" ;
}
