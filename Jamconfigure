Load prebuilt.jam ;
Load builtin.jam ;

PT_WITH_PREBUILT = [ HasOption --with-prebuilt ] ;
PT_PREBUILT_ID ?= [ GetOption --with-prebuilt ] ;
PT_PREBUILT_LOCAL = [ HasOption --prebuilt-local ] ;
PT_PREBUILT_RELEASE ?= prebuilt-1 ;

EchoOption --prebuilt-local : "Local prebuilt" : $(PT_PREBUILT_LOCAL:E="no") ;
EchoOption --with-prebuilt=<id> : "Enable prebuilt" : $(PT_WITH_PREBUILT:E="no") ;

if $(PT_WITH_PREBUILT)
{
    local abi ;
    if $(TARGET_OS:L) in nt win32 windows
    {
        abi = md ;
        if $(WITH_DEBUG) && ! $(WITH_OPTIM)
        {
            abi = mdd ;
        }
    }

    PT_PREBUILT_ID ?= [ Prebuilt-Id $(abi) ] ;
    PT_PREBUILT_ROOT = [ FDirName $(PT_TOP) prebuilt $(PT_PREBUILT_ID) ] ;
    EchoOption PT_PREBUILT_ID : "Using prebuilt" ;

    if ! $(PT_PREBUILT_LOCAL)
    {
        local base = "https://github.com/Pt-Framework/Pt/releases/download/$(PT_PREBUILT_RELEASE)" ;
        local url = [ FDirName $(base) $(PT_PREBUILT_ID:S=.zip) ] ;
        Prebuilt-Fetch $(url) : $(PT_PREBUILT_ROOT) ;
        EchoOption PT_PREBUILT_RELEASE : "Fetched prebuilt" ;
    }

    Configure PT_PREBUILT_ROOT ;

    Prebuilt-Load $(PT_PREBUILT_ROOT) ;
    local packages = [ Prebuilt-Packages ] ;
    PT_PREBUILT_BIN_FILES = [ Prebuilt-Bin $(packages) ] ;
    PT_PREBUILT_LIB_FILES = [ Prebuilt-Lib $(packages) ] ;
    Configure PT_PREBUILT_BIN_FILES ;
    Configure PT_PREBUILT_LIB_FILES ;
}

