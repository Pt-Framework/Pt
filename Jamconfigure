#############################################################################
# Precompiled dependencies
#############################################################################

if --fetch-deps in $(ARGV)
{
    Load fetch.jam ;
    Load vcpkg.jam ;

    Fetch-Configure ;

    DEPS_DIR ?= deps ;
    DEPS_VERSION ?= deps-1 ;

    local targetTriple  = [ Vcpkg-Triplet ] ;
    local archiveName   = pt-deps-$(targetTriple).zip ;
    local manifestName  = $(archiveName).manifest ;
    local baseUrl       = "https://github.com/Pt-Framework/Pt/releases/download/$(DEPS_VERSION)" ;
    local targetDir      = [ FDirName $(DEPS_DIR) $(targetTriple) ] ;
    local manifestLocal = [ FDirName $(targetDir) $(manifestName) ] ;
    local manifestTmp   = [ FDirName $(DEPS_DIR) $(manifestName).tmp ] ;
    local archiveTmp    = [ FDirName $(DEPS_DIR) $(archiveName).tmp ] ;
    local fetched       = ;

    Fetch-Url "$(baseUrl)/$(manifestName)" : $(manifestTmp) ;
    local remoteContent = [ FILE_GET_CONTENTS $(manifestTmp) ] ;

    local localContent = ;
    if [ CHECK_IF_FILE $(manifestLocal) ]
    {
        localContent = [ FILE_GET_CONTENTS $(manifestLocal) ] ;
    }

    if $(remoteContent) != $(localContent)
    {
        Fetch-Url   "$(baseUrl)/$(archiveName)" : $(archiveTmp) ;
        Fetch-RmDir $(targetDir) ;
        Fetch-Unzip $(archiveTmp) : $(DEPS_DIR) ;
        FILE_RENAME $(manifestTmp) : $(manifestLocal) ;
        fetched = $(archiveName) ;
    }

    FILE_REMOVE $(manifestTmp) ;
    FILE_REMOVE $(archiveTmp) ;

    EchoOption $(targetTriple) : "Fetch dependencies" : $(fetched:E="up to date") ;

    local depsRoot = [ FDirName $(DEPS_DIR) $(targetTriple) ] ;
    local depsIncludes = [ FDirName $(depsRoot) include ] ;
    local depsLibDir = [ FDirName $(depsRoot) lib ] ;

    if $(WITH_DEBUG) && ! $(WITH_OPTIM)
    {
        depsLibDir = [ FDirName $(depsRoot) debug lib ] ;
    }

    SetDependencyPath $(depsRoot) : $(depsIncludes) : $(depsLibDir) ;
}

