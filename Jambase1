##########################################################################
# Jam Environment
##########################################################################

JAMDIR ?= jam2 ;

rule JamInclude
{
    # local _s = "" ; # = $(DOT) ;
    # _s = $(JAMDIR:R=$(_s)) ;
    # _s = $(<:R=$(_s)) ;
    # include $(_s) ;

    local _s = $(<:R=$(JAMDIR)) ;
    include $(_s) ;
}

# TODO: it should be possible that the jamdir is anywhere on the system

##########################################################################
# Include base rules
##########################################################################

JamInclude Jamrules.base ;

##########################################################################
# Set configuration
#
# Can be set with 'jam -s CONFIG=debug' or 'jam -s CONFIG=release'.
##########################################################################

CONFIG ?= debug ;
CONFIG = $(CONFIG:L) ;

##########################################################################
# Configure
##########################################################################

JamInclude configure.jam ;

for _arg in $(ARGV)
{
    if $(_arg) = configure
    {
        CONFIGURE = 1 ;
    }
}

if $(CONFIGURE)
{
    TryCommand "rm -f config.jam" ;
    TryCommand "del /f/q config.jam" ;

    Echo "Checking for host platform..." $(OS:L) ;

    ConfigureRm ;
    ConfigureMv ;
    ConfigureCp ;
    ConfigureMkDir ;
    ConfigureChMod ;
    ConfigureLn ;
    ConfigureDotSlash ;

    ##########################################################################
    # Include target platform specifics
    #
    # This adds/sets platform specific rules and variables. May override base
    # rules and variables.
    ##########################################################################

    TARGET_OS ?= $(OS:L) ;
    Echo "Checking for target OS..." $(TARGET_OS:L) ;
    Configure TARGET_OS : $(TARGET_OS) ;

    JamInclude $(TARGET_OS:L).jam ;

    TARGET_OSPLAT ?= $(OSPLAT:L) ;
    Echo "Checking for target platform..." $(TARGET_OSPLAT:L) ;
    Configure TARGET_OSPLAT : $(TARGET_OSPLAT) ;

    Echo "Checking for object file suffix... " $(SUFOBJ) ;
    Configure SUFOBJ : $(SUFOBJ) ;

    Echo "Checking for library prefix..." $(PRELIB) ;
    Configure PRELIB : $(PRELIB) ;

    Echo "Checking for library suffix..." $(SUFLIB) ;
    Configure SUFLIB : $(SUFLIB) ;

    Echo "Checking for executable suffix..." $(SUFEXE) ;
    Configure SUFEXE : $(SUFEXE) ;

    Echo "Checking for shared library suffix..." $(SUFDLL) ;
    Configure SUFDLL : $(SUFDLL) ;

    ##########################################################################
    # Include toolset specifics
    #
    # This adds/sets toolset specific rules and variables. May override platform
    # specific rules and variables.
    ##########################################################################

    if ! $(TOOLSET)
    {
        Exit "Checking for toolset... FAILED! (Please set the TOOLSET variable)" ;
    }

    Echo "Checking for toolset..."$(TOOLSET:L) ;
    Configure TOOLSET : $(TOOLSET) ;
    JamInclude $(TOOLSET:L).jam ;
    ConfigureInclude $(TOOLSET:L).jam ;

    ##########################################################################
    # Project specific configuration
    ##########################################################################

    include Jamconfig ;

    for local _var in $(CONFIGURED_VARIABLES)
    {
        local _value ;
        for _v in $($(_var))
        {
            local _valtmp = [ Escape $(_v) ] ;
            _value += "\"$(_valtmp)\"" ;
        }
    
        WriteFile config.jam : $(_var)" ?= "$(_value:J=" ")" ;" ;
    }

    for local _var in $(CONFIGURED_INCLUDES)
    {  
        WriteFile config.jam : JamInclude" "$(_var)" ;" ;
    }

    Exit "Configuration successful." ;
}

if ! [ CHECK_IF_FILE config.jam ]
{
    Exit "Build not configured." ;
}

include config.jam ;
include Jamfile ;

