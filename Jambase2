CheckC++ WITH_STDC++_LOCALE : "#include <locale>"
                              "int main() { return 0; }" ;

CheckCc WITH_UNIX_SOCKETS : "#include <sys/types.h>"
                            "#include <sys/socket.h>"
                            "int main() { return socket(0,0,0); }"
                          : ""
                          : socket ;

CheckC++ WITH_UNIX_NSL : "#include <sys/types.h>"
                         "#include <sys/socket.h>"
                         "int main() { return socket(0,0,0); }" 
                       : ""
                       : nsl ;

CheckC++ WITH_WINMM : "#include <windows.h>"
                      "#include <mmsystem.h>"
                      "int main() { return timeGetTime(); }" 
                    : ""
                    : winmm.lib ;

CheckC++ WITH_MMTIMER : "#include <windows.h>"
                        "#include <mmsystem.h>"
                        "int main() { return timeGetTime(); }" 
                      : ""
                      : mmtimer.lib ;

