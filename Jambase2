#
# OS specific string for current directory
#
DOT = . ;
JAMDIR ?= jam ;

#
# Includes a jam package
#
rule JamInclude
{
    local _s = $(DOT) ;
    _s = $(JAMDIR:R=$(_s)) ;
    _s = $(<:R=$(_s)) ;
    include $(_s) ;
}

#
# Set target OS/platform to host OS/platform if unset
#
TARGET_OS     ?= $(OS:L) ;
TARGET_OSPLAT ?= $(OSPLAT:L) ;

#
# Set configuration, use debug if not set
#
CONFIG ?= debug ;
CONFIG = $(CONFIG:L) ;

#
# Include base rules
#
JamInclude Jamrules.base ;
JamInclude $(TARGET_OS:LS=".jam") ;


###############################################################################
# Auto configuration rules and actions
###############################################################################

rule TryCommand
{
    local _var = $(1) ;
    local _val = $(2) ;
    local _cmd = $(3) ;

    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    if $(_result[2]) = 0
    {
        $(_var) = $(_val) ;
        WriteFile Jamconfig :  $(_var)" = "$(_val)" ;" ;
        return 1 ;
    }
}


rule CheckCommand
{
    if $(CONFIGURE)
    {
        TryCommand $(1) : $(2) : $(3) ;

        if $($(1))
        {
            Echo "Checking for "$(1)"... yes" ;
            return 1 ;
        }
        else
        {
            Echo "Checking for "$(1)"... no" ;
        }
    }
}


rule CheckCc
{
    if $(CONFIGURE)
    {
        TryCc $(1) : $(2) : $(3) : $(4) ;

        if $($(1))
        {
            Echo "Checking for "$(1)"... yes" ;
            return 1 ;
        }
        else
        {
            Echo "Checking for "$(1)"... no" ;
        }
    }
}


rule CheckC++
{
    if $(CONFIGURE)
    {
        TryC++ $(1) : $(2) : $(3) : $(4) ;

        if $($(1))
        {
            Echo "Checking for "$(1)"... yes" ;
            return 1 ;
        }
        else
        {
            Echo "Checking for "$(1)"... no" ;
        }
    }
}


rule ConfigureDefine
{
    local _line = "#ifndef" $(2) ;
    WriteFile $(1) : $(_line:J=" ") ;

    _line = "#define" $(2) "=" $(3) ;
    WriteFile $(1) : $(_line:J=" ") ;

    WriteFile $(1) : "#endif" ;
}


###############################################################################
# Detect compile and link configuration
###############################################################################

JAM_JAMCONFIG = [ CHECK_IF_FILE Jamconfig ] ;

if ! $(JAM_JAMCONFIG)
{
    if ! $(CONFIGURE)
    {
        Exit "Run 'jam configure' to configure the build first." ;
    }
}


if $(CONFIGURE)
{
    local _cmd = $(RM) Jamconfig ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    #
    # TODO: host configuration
    #
    if $(NT)
    {
        MV = move /y ;
        CP = copy ;
        RM = del /f/q ;
        RMDIR = rmdir /s/q ;
        SLASH = \\ ;
    }
    else
    {
        CHMOD = chmod ;
        CHGRP = chgrp ;
        CHOWN = chown ;
    }

    #
    # Toolset configuration
    #
    if ! $(TOOLSET)
    {
        local _cmd ;

        WriteFile check.cpp : "#include <string.h>" ;
        WriteFile check.cpp : "int main() { return 0; } " ;

        if [ TryCommand CC : "gcc" : "gcc -o check check.cpp" ]
        {
            Echo "Checking for C compiler... gcc" ;
            _cmd = $(RM) "check" ;
            COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
            TOOLSET = "gcc" ;
        }
        else if [ TryCommand CC : "cc" : "cc -o check check.cpp" ]
        {
            Echo "Checking for C compiler... cc" ;
            _cmd = $(RM) "check" ;
            COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
            TOOLSET = "sunpro" ;
        }

        _cmd = $(RM) "check.cpp" ;
        COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
    }

    if ! $(TOOLSET)
    {
        Exit "Checking for C compiler... FAILED !!!" ;
    }

    WriteFile Jamconfig : "TOOLSET = "$(TOOLSET)" ;" ;
}

include Jamconfig ;

JamInclude $(TOOLSET:LS=".jam") ;


