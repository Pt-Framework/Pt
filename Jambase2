#
# OS specific string for current directory
#
DOT = . ;
JAMDIR ?= jam ;

#
# Includes a jam package
#
rule JamInclude
{
    local _s = $(DOT) ;
    _s = $(JAMDIR:R=$(_s)) ;
    _s = $(<:R=$(_s)) ;

    include $(_s) ;
}

#
# Set target OS/platform to host OS/platform if unset
#
TARGET_OS     ?= $(OS:L) ;
TARGET_OSPLAT ?= $(OSPLAT:L) ;

#
# Set configuration, use debug if not set
#
CONFIG ?= debug ;
CONFIG = $(CONFIG:L) ;

#
# Include base rules
#
JamInclude Jamrules.base ;
JamInclude $(TARGET_OS:LS=".jam") ;


###############################################################################
# Auto configuration rules and actions
###############################################################################

rule Slashify
{
    local _s = $(1) ;
    local _r ;
    while $(_s:B)
    {
        if $(_r)
        {
            _r = $(_s:B)"\\\\"$(_r) ;
        }
        else 
        {
            _r = $(_s:B) ;
        }

        _s = $(_s:D) ;
    }

    if $(_s:D)
    {
        _r = $(_s:D)"\\"$(_r) ;
    }

    return $(_r) ;
}


rule ConfigureEcho
{
    if $(CONFIGURE)
    {
        if $(2)
        {
            if $(3)
            {
                Echo "Checking for "$(1)" ..."$(3) ;
                $(1) = $(3) ;
                local _s = $(3) ; #[ Slashify $(3) ] ;
                WriteFile config.jam : $(1)" ?= "\"$(_s)\"" ;"  ;
            }
            else
            {
                Echo "Checking for "$(1)"... yes" ;
                $(1) = $(2) ;
                WriteFile config.jam : $(1)" ?= "$(2)" ;"  ;
            }
        }
        else if $(4)
        {
            Echo "Checking for "$(1)"..." $(4) ;
        }
    }
}


rule Configure
{
    if $(CONFIGURE)
    {
        $(1) = $(2) ;
        WriteFile config.jam : $(1)" ?= "\"$(2)\"" ;"  ;
   }
}


rule ConfigureDefine
{
    if $(CONFIGURE)
    {
        local _line = "#ifndef" $(2) ;
        WriteFile $(1) : $(_line:J=" ") ;

        _line = "#define" $(2) "=" $(3) ;
        WriteFile $(1) : $(_line:J=" ") ;

        WriteFile $(1) : "#endif" ;
    }
}


rule TryCommand
{
    local _cmd  = $(1) " 2>&1 > check.out" ;
    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    if [ CHECK_IF_FILE check.out ] && $(RM)
    {
        _cmd = $(RM) check.out ;
        COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
    }

    if $(_result[2]) = 0
    {
        return 1 ;
    }
}


rule CheckCommand
{
    if $(CONFIGURE) && ! $($(1))
    {
        local _r = [ TryCommand $(3) ] ;
        ConfigureEcho $(1) : $(_r) : $(2) ;
        return $(_r) ;
    }
}


rule CheckCommand2
{
    local _r = [ TryCommand $(3) ] ;
    if $(_r)
    {
        $(1) = $(2) ;
        #Configure $(1) : $(2) ;
    }
    return $(_r) ;
}


rule CheckDefault
{
    if $(CONFIGURE)
    {
        local _val = $($(1)) ;
        if $(_val)
        {
            ConfigureEcho $(1) : 1 : [ Slashify $(_val:J=" ") ] ;
        }
    }
}


rule CheckVariable
{
    if $(CONFIGURE)
    {
        if ! $($(1))
        {
            if $($(2))
            {
                ConfigureEcho $(1) : 1 : $(3) ;
            }
        }
    }
}


rule CheckFile
{
    if $(CONFIGURE)
    {
        if ! $($(1))
        {
            if $(2)
            {
                if [ CHECK_IF_FILE $(2:J=" ") ]
                {
                    ConfigureEcho $(1) : 1 : $(3) : "no" ;
                }
            }
        }
    }
}


rule CheckCc
{
    local _out = check ;

    if $(CONFIGURE)
    {
        TryCommand $(RM) "check.c" ;

        local _line ;
        for _line in $(2)
        {
            WriteFile check.c : $(_line) ;
        }

        local _r = [ TryCc $(1) : check.c : $(3) : $(4) : $(5) ] ;
        ConfigureEcho $(1) : $(_r) : "yes" : "no" ;

        TryCommand $(RM) "check.c" ;
        TryCommand $(RM) $(_out:S=$(SUFEXE)) ;
        TryCommand $(RM) $(_out:S=$(SUFOBJ)) ;
    }
}


rule CheckC++
{
    local _out = check ;

    if $(CONFIGURE)
    {
        TryCommand $(RM) "check.cpp" ;

        local _line ;
        for _line in $(2)
        {
            WriteFile check.cpp : $(_line) ;
        }

        local _r = [ TryC++ $(1) : check.cpp : $(3) : $(4) : $(5) ] ;
        ConfigureEcho $(1) : $(_r) : "yes" : "no" ;

        TryCommand $(RM) "check.cpp" ;
        TryCommand $(RM) $(_out:S=$(SUFEXE)) ;
        TryCommand $(RM) $(_out:S=$(SUFOBJ)) ;
    }
}


rule Require
{
    if ! $($(1))
    {
        Echo "Checking for "$(1)" ...FAILED !!!" ;
    }
}


rule Erase
{
    local _f ;
    for _f in $(1)
    {
        TryCommand $(RM) $(_f) ;
    }
}


for _arg in $(ARGV)
{
    if $(_arg) = configure
    {
        CONFIGURE = 1 ;
    }
}

JAM_JAMCONFIG = [ CHECK_IF_FILE config.jam ] ;

if ! $(JAM_JAMCONFIG)
{
    if ! $(CONFIGURE)
    {
        Exit "Run 'jam configure' to configure the build first." ;
    }
}


#
# TODO: host configuration
#
rule CheckHost
{
    Echo "Checking for host platform ..."$(OS:L) ;

    #
    # Check for a shell command to remove files
    #
    RM = ;
    WriteFile check_rm.in : "This file is a leftover of the jam configure process and can be deleted." ;
    CheckDefault RM ;
    CheckCommand RM : "del /f/q" : "del /f/q check_rm.in" ;
    CheckCommand RM : "rm -f" : "rm -f check_rm.in" ;
    Require RM ;

    #
    # Check for a shell command to move files
    #
    MV = ;
    WriteFile check_mv.in : "This file is a leftover of the jam configure process and can be deleted." ;
    CheckDefault MV ;
    CheckCommand MV : "move /y" : "move /y check_mv.in check_mv.out" ;
    CheckCommand MV : "mv -f" : "mv -f check_mv.in check_mv.out" ;
    Erase "check_mv.in" "check_mv.out" ;
    Require MV ;

    #
    # Check for a shell command to copy files
    # 
    CP = ;
    WriteFile check_cp.in : "This file is a leftover of the jam configure process and can be deleted." ;
    CheckDefault CP ;
    CheckCommand CP : "copy" : "copy check_cp.in check_cp.out" ;
    CheckCommand CP : "cp -f" : "cp -f check_cp.in check_cp.out" ;
    Erase "check_cp.in" "check_cp.out" ;
    Require CP ;

    #
    # Check for a shell command to create directories
    # 
    MKDIR = ;
    CheckDefault MKDIR ;
    CheckCommand MKDIR : "mkdir" : "mkdir check_dir" ;
    Require MKDIR ;

    #
    # Check for a shell command to remove directories
    #
    RMDIR = ;
    CheckDefault RMDIR ;
    CheckCommand RMDIR : "rmdir /s/q" : "rmdir /s/q check_dir" ;
    CheckCommand RMDIR : "rmdir" : "rmdir check_dir" ;
    CheckCommand RMDIR : "rm -rf" : "rm -rf check_dir" ;
    Require RMDIR ;

    #
    # Check for a shell command to set access rights
    # 
    CHMOD = ;
    WriteFile check_chmod.in : "This file is a leftover of the jam configure process and can be deleted." ;
    CheckDefault CHMOD ;
    CheckCommand CHMOD : "chmod" : "chmod 777 check_chmod.in" ;
    Erase "check_chmod.in" ;
    if $(CHMOD)
    {
        ConfigureEcho CHGRP : 1 : chgrp ;
        ConfigureEcho CHGRP : 1 : chown ;
    }

    LN = ;
    WriteFile check_ln.in : "delete me" ;
    if $(LN) 
       || [ CheckCommand2 LN : "ln" : "ln check_ln.in check_ln.out" ]
    {
        Configure LN : $(LN) ;
        Echo "Checking for link command..." $(LN) ;
    }
    Erase "check_ln.in" "check_ln.out" ;
 
    if ! $(LN)
    {
        Exit "Checking for link command... FAILED!" ;
    }

    DOT = ;
    if $(DOT) 
       || [ CheckCommand2 DOT : "." : "cd ." ]
    {
        Configure DOT : $(DOT) ;
        Echo "Checking for directory dot..." $(DOT) ;
    }
    else
    {
        Exit "Checking for directory dot... FAILED!" ;
    }

    DOTDOT = ;
    if $(DOTDOT) 
       || [ CheckCommand2 DOTDOT : ".." : "cd .." ]
    {
        Configure DOTDOT : $(DOTDOT) ;
        Echo "Checking for directory dotdot..." $(DOTDOT) ;
    }
    else
    {
        Exit "Checking for directory dotdot... FAILED!" ;
    }
    
    SLASH = ;   
    if $(SLASH)
       || [ CheckCommand2 SLASH : "\\\\" : "cd .\\" ]
       || [ CheckCommand2 SLASH : "/"  : "cd ./" ]
    {
        Configure SLASH : $(SLASH) ;
        if $(SLASH) = "\\\\"
        {
            SLASH = \\ ;
        }
        Echo "Checking for directory separator..." $(SLASH) ;
    }
    else
    {
        Exit "Checking for directory separator... FAILED!" ;
    }
}


#
# Toolset configuration (cl KCC CC cxx cc++ xlC aCC c++ g++ egcs gcc)
#
rule CheckToolset
{
    if $(CONFIGURE)
    {
        if ! $(TOOLSET)
        {
            local _cmd ;
            local _out = check$(SUFEXE) ;
            local _obj = check$(SUFOBJ) ;

            TryCommand $(RM) "check.c" ;

            WriteFile check.c : "#include <string.h>" ;
            WriteFile check.c : "int main() { return 0; } " ;

            if [ TryCommand "cl /Fo$(_obj) /Fe$(_out) check.c" ]
            {
                WriteFile config.jam : "TOOLSET = msvc ;"  ;
                TOOLSET = msvc ;
                Echo "Checking for toolset ...msvc" ;
            }
            else if [ TryCommand "xlC -o "$(_out)" check.c" ]
            {
                WriteFile config.jam : "TOOLSET = xlc ;"  ;
                TOOLSET = xlc ;
                Echo "Checking for toolset ...xlc" ;
                Exit "NOT IMPLEMENTED" ;
            }
            else if [ TryCommand "CC -o "$(_out)" check.c" ]
            {
                WriteFile config.jam : "TOOLSET = sunpro ;"  ;
                TOOLSET = sunpro ;
                Echo "Checking for toolset ...sunpro" ;
            }
            else if [ TryCommand "gcc -o "$(_out)" check.c" ]
            {
                WriteFile config.jam : "TOOLSET = gcc ;"  ;
                TOOLSET = gcc ;
                Echo "Checking for toolset ...gcc" ;
            }
            else if [ TryCommand "cc -o "$(_out)" check.c" ]
            {
                WriteFile config.jam : "TOOLSET = cc ;"  ;
                TOOLSET = cc ;
                Echo "Checking for toolset ...cc" ;
            }
            else
            {
                Exit "Checking for toolset ... failed" ;
            }

            TryCommand $(RM) "check.c" ;
            TryCommand $(RM) $(_out) ;
            TryCommand $(RM) $(_obj) ;
        }
        else
        {
            Echo "Using toolset "$(TOOLSET) ;
            WriteFile config.jam : TOOLSET" = "$(TOOLSET)" ;"  ;
        }
    }

    if ! $(TOOLSET)
    {
        Exit "Checking for TOOLSET ...FAILED !!!" ;
    }

    JamInclude $(TOOLSET:LS=".jam") ;
}

