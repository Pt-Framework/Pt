###############################################################################
# Include main Jamfile and Jamconf
###############################################################################

if $(CONFIGURE)
{
    TryCommand "rm -f config.jam" ;
    TryCommand "del /f/q config.jam" ;

    CheckHost ;
    CheckToolset ;

    include Jamconf ;

    Exit "Run jam now to build targets." ;
}

include config.jam ;

JamInclude $(TOOLSET:LS=".jam") ;

include Jamfile ;
