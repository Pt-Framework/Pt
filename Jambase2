#
# OS specific string for current directory
#
DOT = . ;
JAMDIR ?= jam ;

#
# Includes a jam package
#
rule JamInclude
{
    local _s = $(DOT) ;
    _s = $(JAMDIR:R=$(_s)) ;
    _s = $(<:R=$(_s)) ;
    include $(_s) ;
}

#
# Set target OS/platform to host OS/platform if unset
#
TARGET_OS     ?= $(OS:L) ;
TARGET_OSPLAT ?= $(OSPLAT:L) ;

#
# Set configuration, use debug if not set
#
CONFIG ?= debug ;
CONFIG = $(CONFIG:L) ;

#
# Include base rules
#
JamInclude Jamrules.base ;


#############################################################################
# Auto configuration rules and actions
#############################################################################

rule CheckC++
{
    local _line ;
    for _line in $(2)
    {
        WriteFile $(1).cpp : $(_line) ;
    }

    local _cmd = $(C++) -o $(1:S=$(SUFEXE)) $(1).cpp ;
    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    _cmd = $(RM) $(1).cpp ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    _cmd = $(RM) $(1:S=$(SUFEXE)) ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    if $(_result[2]) = 0
    {
    	$(1) = 1 ;
        WriteFile Jamconfig : $(1)" = 1 ;"  ;
    }
}


rule ConfigureDefine
{
    local _line = "#ifndef" $(2) ;
    WriteFile $(1) : $(_line:J=" ") ;

    _line = "#define" $(2) "=" $(3) ;
    WriteFile $(1) : $(_line:J=" ") ;

    WriteFile $(1) : "#endif" ;
}


rule ConfigureCommand
{
    local _var = $(1) ;
    local _val = $(2) ;
    local _cmd = $(3) ;

    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    if $(_result[2]) = 0
    {
        $(_var) = $(_val) ;
        WriteFile Jamconfig :  $(_var)" = "$(_val)" ;" ;
        return 1 ;
    }
}


rule ConfigureC++
{
    if $(CONFIGURE)
    {
        if ! $(TOOLSET)
        {
            local _cmd ;

            WriteFile check.cpp : "#include <string.h>" ;
            WriteFile check.cpp : "int main() { return 0; } " ;

            if [ ConfigureCommand C++ : "gcc" : "gcc -o check check.cpp" ]
            {
                Echo "Checking for C++ toolset... gcc" ;
                _cmd = $(RM) "check" ;
                COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
                TOOLSET = "gcc" ;
            }
            else if [ ConfigureCommand C++ : "CC" : "CC -o check check.cpp" ]
            {
                Echo "Checking for C++ toolset... CC" ;
                _cmd = $(RM) "check" ;
                COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
                TOOLSET = "sunpro" ;
            }

            _cmd = $(RM) "check.cpp" ;
            COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
        }

        if ! $(TOOLSET)
        {
            Exit "Checking for C++ toolset... NOT FOUND" ;
        }

        WriteFile Jamconfig :  "TOOLSET = "$(TOOLSET)" ;" ;
    }

    JamInclude $(TOOLSET:LS=".jam") ;
}


