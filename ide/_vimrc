" General options
set nocompatible
set hidden
set noerrorbells
set novisualbell
set showmode
set nobackup
set noswapfile
winpos 0 0
set lines=999 columns=180
set guioptions-=L
set guioptions-=T
set mouse=a
set bs=2
set backspace=indent,eol,start
filetype on
set number
set ruler
set cursorline
set showmatch
set incsearch
set nofoldenable
set wrap
set wrapscan
set ignorecase
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4
set autoindent
set virtualedit=block
syntax on
colors pt
set guifont=Monaco:h10,Consolas:h9,Courier\ New:h10
set sessionoptions=buffers

" %= = sep. betweeen l/r-aligned      %n = buffer number
" %F = full path to file              %y = type of file
" %m = modified                       %r = readonly
" %b = value of byte                  %B = value of byte in HEX
set statusline=[%n]\ %F%y%m%r\ %=\ %b\ 0x%B\ \ \ %c,%l/%L\ \ %P

