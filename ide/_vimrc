" Switch to insert mode
:noremap <Esc> :startinsert<CR>
:noremap! <Esc> <C-o>:startinsert<CR>

" Switch to normal mode
:noremap <C-e> <Esc>
:noremap! <C-e> <Esc>

" Window commands for insert mode
:inoremap <C-w>q <C-o><C-w>q

" backspace in Visual mode deletes selection
vnoremap <BS> d

" Open File something like :e %:p:h
let s:OpenWindow = 0

function ToggleOpenWindow()
    if s:OpenWindow == 0
        :CMiniBufExplorer
        :NERDTreeFind
        let s:OpenWindow = 1
    else
        :NERDTreeClose
        :MiniBufExplorer
        let s:OpenWindow = 0
    endif
endfunction

:noremap <C-o> :ToggleOpenWindow<CR>
:noremap! <C-o> <C-o>:ToggleOpenWindow<CR>

" Save current file
:noremap <C-s> :w<CR>
:noremap! <C-s> <C-o>:w<CR>

" Undo
:noremap <C-z> u<CR>
:inoremap <C-z> <C-o>u

" Redo
:noremap <C-y> <C-r><CR>
:noremap! <C-y> <C-o><C-r>

" Copy text
:noremap <C-c> "+y<CR>
:inoremap <C-c> <C-o>"+y

" Cut text
:noremap <C-x> "+x<CR>
:noremap! <C-x> <C-o>"+x

" Paste text
:noremap <C-v> "+gP<CR>
:noremap! <C-v> <C-o>"+gP

" Enter block mode
:noremap <C-b> <C-v><CR>
:noremap! <C-b> <C-o><C-v>

" Find selected text
:vnoremap <C-f> "fy/<C-r>f<CR>
:inoremap <C-f> <C-o>/<C-r>f<CR>
:nnoremap <C-f> /<C-r>f<CR>

" Replace selected text
:noremap <C-h> "fh<C-o>:%s/<C-r>f

" Jump to tag
:noremap <C-t> g<C-]>
:noremap! <C-t> <C-o>g<C-]>

" Jump to last tag
:noremap <C-r> <C-T>
:noremap! <C-r> <C-o><C-T>

" MiniBufExplorer
let g:miniBufExplSortBy = "name"
let g:miniBufExplVSplit = 30
let g:miniBufExplSplitBelow = 0
let g:miniBufExplorerMoreThanOne=1

" Taglist
let g:Tlist_Auto_Open = 0
let g:Tlist_Show_One_File = 1
let g:Tlist_WinWidth = 40
let Tlist_Use_Right_Window = 1
set tags=c:\Pt\ide\tags

:noremap <C-l> :TlistToggle<CR>
:noremap! <C-l> <C-o>:TlistToggle<CR>

