" General
winpos 0 0
set lines=999 columns=180
set guioptions -=L
set mouse=a
set bs=2
filetype on
set number
set ruler
syntax enable
colors pt
set guifont=Consolas:h9
set sessionoptions=buffers

" Undo
:noremap <C-z> u<CR>
:noremap! <C-z> <C-o>u
:noremap <C-u> u<CR>
:noremap! <C-u> <C-o>u

" Redo
:noremap <C-r> <C-r><CR>
:noremap! <C-r> <C-o><C-r>

" Copy text
:noremap <C-y> "+y<CR>
:noremap! <C-y> <C-o>"+y

" Cut text
:noremap <C-x> "+x<CR>
:noremap! <C-x> <C-o>"+x

" Paste text
:noremap <C-v> "+gP<CR>
:noremap! <C-v> <C-o>"+gP
:noremap <C-p> "+gP<CR>
:noremap! <C-p> <C-o>"+gP

" Enter block mode
:noremap <C-b> <C-v><CR>
:noremap! <C-b> <C-o><C-v>

" Find selected text
:vnoremap <C-f> "fy/<C-r>f<CR>
:inoremap <C-f> <C-o>/<C-r>f<CR>
:nnoremap <C-f> /<C-r>f<CR>

" Replace selected text
:noremap <C-h> "fh<C-o>:%s/<C-r>f

" Jump to tag
:noremap <C-s>. g<C-]>
:noremap! <C-s>. <C-o>g<C-]>

" Jump to last tag
:noremap <C-s>, <C-T>
:noremap! <C-s>, <C-o><C-T>

" Open File
:noremap <C-e> :e %:p:h<CR>
:noremap! <C-e> <C-o>:e %:p:h<CR>

" Save current file
:noremap <C-w> :w<CR>
:noremap! <C-w> <C-o>:w

" MiniBufExplorer
let g:miniBufExplSortBy = "name"
let g:miniBufExplVSplit = 30
let g:miniBufExplSplitBelow = 0

:map <F2> :TMiniBufExplorer<CR>
:map! <F2> <C-o>:TMiniBufExplorer<CR>

" Taglist
let g:Tlist_Auto_Open = 0
let g:Tlist_Show_One_File = 1
let g:Tlist_WinWidth = 40
set tags=c:\Pt\ide\tags

:map <F3> :TlistToggle<CR>
:map! <F3> <C-o>:TlistToggle<CR>

function LM()
  if bufname('%') == '-MiniBufExplorer-'
    execute "normal \<2-leftmouse>"
  else
    execute "normal \<2-leftmouse>" 
  endif
endfunction

noremap! <2-LEFTMOUSE> <C-o>:call LM()<CR>

"
" Build command
"
let s:makeprg_line="jam.bat -q $*"
let &makeprg=s:makeprg_line

let g:make_target=''
let g:build_root='c:\Pt'

" See also (very nice!!!) http://blog.vicshih.com/2011/03/fast-make-for-vim.html
function BuildMake(make_args)
  " close QuickFix window (content is now outdated due to new build run)
  cclose

  " Force write
  sil write!

  " http://vim.1045645.n5.nabble.com/Working-directory-for-make-td1172840.html
  " http://stackoverflow.com/questions/1043432/omit-pattern-not-found-error-message-in-vim-script
  let cmd_cd='sil lcd ' . g:build_root
  exe cmd_cd
  
  " pwd
  " need to use "exe" to get variables evaluated properly:
  " http://stackoverflow.com/questions/4596932/vim-cd-to-path-stored-in-variable
  " and we should _not_ run exe on the raw line directly, since this will execute _output_
  " results given by make!
  let cmd_make="make" . a:make_args
  exe cmd_make
  
  " open quickfix win if there are errors
  cw

  "copen
  "cc 1 " this does not appear to be necessary since opening the window will jump to first issue anyway
  sil lcd -
endfunction

:noremap <F5> :call BuildMake(g:make_target)<CR>
:noremap! <F5> <C-o>:call BuildMake(g:make_target)

