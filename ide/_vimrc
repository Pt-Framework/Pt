" MiniBufExplorer
let g:miniBufExplSortBy = "name"
let g:miniBufExplVSplit = 30
let g:miniBufExplSplitBelow = 0
let g:miniBufExplorerMoreThanOne=1

" Taglist
let g:Tlist_Auto_Open = 0
let g:Tlist_Show_One_File = 1
let g:Tlist_WinWidth = 40
let Tlist_Use_Right_Window = 1
" let g:Tlist_Ctags_Cmd = 

:noremap <C-l> :TlistToggle<CR>
:noremap! <C-l> <C-o>:TlistToggle<CR>

" Jump to tag
:noremap <C-t> g<C-]>
:noremap! <C-t> <C-o>g<C-]>

" Jump to last tag
:noremap <C-r> <C-T>
:noremap! <C-r> <C-o><C-T>

" Open file (something like :e %:p:h)
let s:OpenWindow = 0

function ToggleOpenWindow()
    if s:OpenWindow == 0
        :CMiniBufExplorer
        :NERDTreeFind
        let s:OpenWindow = 1
    else
        :NERDTreeClose
        :MiniBufExplorer
        let s:OpenWindow = 0
    endif
endfunction

" Toggle open buffer sidebar
:noremap <C-o> :call ToggleOpenWindow()<CR>
:noremap! <C-o> <C-o>:call ToggleOpenWindow()<CR>

" Save current file
:noremap <C-s> :w<CR>
:noremap! <C-s> <C-o>:w<CR>

" Window commands also for insert mode
:inoremap <C-w>q <C-o><C-w>q

" backspace in Visual mode deletes selection
vnoremap <BS> d

" Undo changes
:noremap <C-z> u<CR>
:inoremap <C-z> <C-o>u

" Redo changes
:noremap <C-y> <C-r><CR>
:noremap! <C-y> <C-o><C-r>

" Copy text
:noremap <C-c> "+y<CR>
:inoremap <C-c> <C-o>"+y

" Cut text
:noremap <C-x> "+x<CR>
:noremap! <C-x> <C-o>"+x

" Paste text
:noremap <C-v> "+gP<CR>
:noremap! <C-v> <C-o>"+gP

" Enter block mode
:noremap <C-b> <C-v><CR>
:noremap! <C-b> <C-o><C-v>

" Find selected text
:vnoremap <C-f> "fy/<C-r>f<CR>
:inoremap <C-f> <ESC>/
:nnoremap <C-f> /

" Replace selected text
:noremap <C-h> "fh<C-o>:%s/<C-r>f

