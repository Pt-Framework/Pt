
if ! $(TNTNET_JAM) {
TNTNET_JAM = true ;

#############################################################################
# TNT-net rules and actions
#############################################################################
#if $(SYS) = "posix"
#{
  TNTNETLIBS = -ltntnet ;
#}
#else
#{
#  Echo "*** TNT-net requires a posix compliant operating system" ;
#}


rule TntnetLibrary
{
  local _source = $(<:S=.cpp) ;
  local _sourceGristed = [ FGristFiles $(_source) ] ;

  MakeLocate $(_source) : $(LOCATE_TARGET) ;
  SEARCH on $(>) = $(SEARCH_SOURCE) ;
  Clean clean : $(_source) ;

  Depends $(_sourceGristed) : $(>) ;
  Depends $(_source) : $(>) ;

  SharedLibrary $(<) : $(_source) ;
  LINKFLAGS on $(PRELIB)$(<:S=$(SUFDLL)) += $(TNTNETLIBS) ;

  Ecppc $(_source) : $(>) ;
}

actions Ecppc
{
    ecppc -o $(<) -n $(<:B) $(>)
}

} # TNTNET_JAM
