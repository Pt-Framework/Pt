##########################################################################
# Jam Environment
#
# TODO:
# http://www.boost.org/boost-build2/doc/html/jam/language.html
#
##########################################################################

JAMDIR ?= jam2 ;

rule Load
{
    local _s = $(<:R=$(JAMDIR)) ;
    include $(_s) ;
}

rule JamInclude
{
    local _s = $(<:R=$(JAMDIR)) ;
    include $(_s) ;
}

##########################################################################
# Configure Step
##########################################################################

for _arg in $(ARGV)
{
    if $(_arg) = configure
    {
        CONFIGURE = 1 ;
    }
}

if $(CONFIGURE)
{
    Load configure.jam ;

    TryCommand "rm -f config.jam" ;
    TryCommand "del /f/q config.jam" ;

    TryCommand "rm -f config.log" ;
    TryCommand "del /f/q config.log" ;

    Echo "Checking for host platform..." $(OS:L) ;

    ConfigureLog "[ Configure ]" ;

    ConfigureRm ;
    ConfigureMv ;
    ConfigureCp ;
    ConfigureMkDir ;
    ConfigureChMod ;
    ConfigureLn ;
    ConfigureDotSlash ;
    ConfigureTarget ;
    ConfigureToolset ;

    # Project specific configuration
    ConfigureLog "\n[ Jamconfigure ]" ;
    include Jamconfigure ;

    ConfigureExit ;
}

if ! [ CHECK_IF_FILE config.jam ]
{
    Exit "Build not configured. Run jam configure first." ;
}

include config.jam ;

##########################################################################
# Build Step
##########################################################################

# Basic variables and rules
Load base.jam ;

# Toolset specific variables and rules
CONFIG ?= debug ;
CONFIG = $(CONFIG:L) ;
Load $(TOOLSET:L).jam ;

# Project root Jamfile
include Jamfile ;

