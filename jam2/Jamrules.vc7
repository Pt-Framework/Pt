# contains common rules for all vc-compilers
#
JamInclude Jamrules.vc ;

# Set path to Visual Studio installation using environment variable VSINSTALLDIR 
# if it was not passed to jam using -sVISUALC=<path> 
if $(VISUALC) 
{
  VISUALC = $(VISUALC:J=" ") ;
} 
else
{
  VISUALC ?= $(VCINSTALLDIR:J=" ") ;
}
if ! $(VISUALC)
{
  Exit "No Visual Studio installation path defined. 
Use either -sVISUALC=<path_to_VS> or set the environment variable VSINSTALLDIR" ;
}

if $(TARGET_OS:L) != nt 
{
  exit "This target-os is not supported on this toolset" ;
}

if $(TARGET_OSPLAT:L) != x86
{
  exit "This target-platform is not supported on this toolset" ;
}


# Path to VC/C++ module of visual studio installation 
#
VCDIR = $(VISUALC)\\vc7 ;


PLATFORMSDK ?= $(VISUALC)\\vc7\\PlatformSDK ;


if $(CONFIG:L) = debug 
{
    LINKFLAGS += /DEBUG ;
    CCFLAGS   += /MDd /Zi ;
    OPTIM     ?= /Od ;
}
else if $(CONFIG:L) = release 
{
    CCFLAGS += /MD /D "NDEBUG" ;
    OPTIM   ?= /O1 /Oy ;
}
else if $(CONFIG:L) = aqtime
{
    CCFLAGS += /MD /Zi /D "NDEBUG" ;
    OPTIM   ?= /O1 /Oy ;
    LINKFLAGS += /DEBUG ;
}


AR    = $(VISUALC)\\vc7\\bin\\lib ;
AS    = masm386 ;
CC    = $(VISUALC)\\vc7\\bin\\cl /nologo ;
C++   = $(CC) ;
LINK  = $(VISUALC)\\vc7\\bin\\link /nologo ;
RC    = $(VISUALC)\\vc7\\bin\\rc ;

C++FLAGS  += $(CCFLAGS) /EHsc /GR /DWIN32 /Zc:wchar_t ;
LINKFLAGS += "/INCREMENTAL:NO" ;
LINKFLAGS += /LIBPATH:"\"$(PLATFORMSDK)\\lib"\" ;
STDHDRS    = \"$(VISUALC)\\vc7\\include\" 
             \"$(PLATFORMSDK)\\include\" ;
UNDEFFLAG  = "/u _" ;
WARN      ?= /W3 ;


rule EmbedManifest
{
# no manifest files on VC7
}
