# Toolset commands
#
CC   = $(VISUALC)\\VC\\ce\\bin\\x86_mips\\cl /nologo ;
C++  = $(CC) ;
LINK = $(VISUALC)\\VC\\ce\\bin\\x86_mips\\link /nologo ;


# Flags and options
#
LINKFLAGS += /LIBPATH:"\"$(VISUALC)\\SmartDevices\\SDK\\PocketPC2003\\Lib\\mips"\" ;
LINKFLAGS += /LIBPATH:"\"$(VISUALC)\\VC\\ce\\lib\\mips"\" ;
LINKFLAGS += /machine:MIPS ;
C++FLAGS +=  /D "MIPS" /D "_MIPS_" ;


LINKLIBS += coredll.lib
	    corelibc.lib
            ole32.lib
	    oleaut32.lib
	    uuid.lib
            commctrl.lib
            ccrtrtti.lib ;
            
