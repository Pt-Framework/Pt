# contains common rules for all vc-compilers
#
JamInclude Jamrules.vc ;

# Set path to Visual Studio installation using environment variable VSINSTALLDIR 
# if it was not passed to jam using -sVISUALC=<path> 
if $(VISUALC) 
{
  VISUALC = $(VISUALC:J=" ") ;
} 
else
{
  VISUALC ?= $(VSINSTALLDIR:J=" ") ;
}
if ! $(VISUALC)
{
  Exit "No Visual Studio installation path defined. 
Use either -sVISUALC=<path_to_VS> or set the environment variable VSINSTALLDIR" ;
}

# Path to VC/C++ module of visual studio installation 
#
VCDIR ?= $(VISUALC)\\vc ;

PLATFORMSDK ?= $(VISUALC)\\vc\\PlatformSDK ;
PLATFORMSDK = $(PLATFORMSDK:J=" ") ;

AR          = $(VISUALC)\\vc\\bin\\lib ;
AS          = masm386 ;
CC          = $(VISUALC)\\vc\\bin\\cl /nologo ;
RC          = $(VISUALC)\\vc\\bin\\rc ;
MT          = $(VISUALC)\\vc\\bin\\mt -nologo ;
CCFLAGS    ?= /D_CRT_SECURE_NO_DEPRECATE ;
C++         = $(CC) ;
#C++FLAGS  += $(CCFLAGS) /Zc:wchar_t- ;
C++FLAGS   += $(CCFLAGS) ;
LINK        = $(VISUALC)\\vc\\bin\\link /nologo ;
LINKFLAGS  += /MANIFEST ;
LINKLIBS   ?= "" ;
UNDEFFLAG   = "/u _" ;

rule EmbedManifest
{
    # not required for VC9
}

# Include rules for selected target OS
#
JamInclude Jamrules.vc8.$(TARGET_OS:L) ;
