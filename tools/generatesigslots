			 ? ','.${arg_tmpl_types}
			 : '');
print "//comma_arg_tmpl_types=$comma_arg_tmpl_types\n";
# $arg_tmpl_decl_main_inst: class A1 = Void, ... class AN = Void
$arg_tmpl_decl_main_inst = '';
for( $i = 1; $i <= $max_types; ++$i ) {
  $comma = (($argc!=$i) ?', ':'');
  $arg_tmpl_decl_main_inst .= 'class A'.$i.' = Void'.$comma;
}
print "//arg_tmpl_decl_main_inst=$arg_tmpl_decl_main_inst\n";

@typelist = @decl_typenames;
for( $i=$argc; $i < $max_types; ++$i ) {
