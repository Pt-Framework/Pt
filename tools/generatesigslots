}

# $arg_tmpl_decl_1toN: typename A1, ... typename AN
$arg_tmpl_decl_1toN = '';
# $arg_tmpl_spec_1toN: A1, ... AN
$arg_tmpl_spec_1toN = '';
if( $argc ) {
