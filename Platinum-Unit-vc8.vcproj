<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8,00"
	Name="Pt-Unit"
	ProjectGUID="{D2F46A27-55B0-40C6-AEC8-C1763B05CB70}"
	Keyword="MakeFileProj"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)"
			ConfigurationType="0"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=debug -q"
				ReBuildCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=debug -a -q"
				CleanCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=debug clean"
				Output="bin\FileStreamTest.exe"
				PreprocessorDefinitions="WIN32;_DEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)"
			ConfigurationType="0"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=release"
				ReBuildCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=release -a"
				CleanCommandLine="call &quot;%VS80COMNTOOLS%vsvars32.bat&quot; &amp;&amp; .\jam\jam.exe -sTOOLSET=vc8 -sCONFIG=release clean"
				Output="test.exe"
				PreprocessorDefinitions="WIN32;NDEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
		</Configuration>
	</Configurations>
