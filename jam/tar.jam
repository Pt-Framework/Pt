if ! $(JAMBASE_TAR_JAM_INCLUDED) {
JAMBASE_TAR_JAM_INCLUDED = true ;

TAR ?= tar ;

# Tar <archive> : <files> : <archive-dir>
#
# Add files to archive. archive-dir is optional and becomes the
# directory of every added member. Members default to mode 0666.
# Adds archive to package and package-clean.
#
rule Tar
{
  local _tar = $(1) ;
  local _files = $(2) ;
  local _tmpdir = $(1:B)-tar ;

  $(<)_type = "Tar" ;

  Clean package-clean : $(_tar) ;

  Depends package : $(_tar) ;

  for local f in $(_files)
  {
    local _member = $(f:BSG=$(_tar)) ;

    Depends $(_tar) : $(_member) ;
    Depends $(_member) : $(f) ;
    Depends $(_member) : $(_tmpdir) ;
    MkDir $(_tmpdir) ;

    ARCHIVE_RIGHTS on $(_member) = 0666 ;
    ARCHIVE_OWNER on $(_member) = ;
    ARCHIVE_GROUP on $(_member) = ;
    ARCHIVE_NAME on $(_member) = $(_tar) ;
    ARCHIVE_DIR on $(_member) = "" ;

    if $(3)
    {
      ARCHIVE_DIR on $(_member) = [ FDirName $(3) ] ;
    }

    TarFile $(_member) : $(f) ;
  }
}


# Tar-MakeLocate <archive> : <directory>
#
# Locate archive and its temporary staging directory below directory.
# Called by MakeLocate for targets created by Tar.
#
rule Tar-MakeLocate
{
  local _tmpdir = $(1:B)-tar ;

  _MakeLocate $(_tmpdir) : $(2) ;
  _MakeLocate $(1) : $(2) ;
}


# TarMode <archive> : <files> : <mode>
#
# Set the archive mode for members added from files. Each file must
# already have been declared for archive with Tar.
#
rule TarMode
{
  local _tar = $(1) ;
  local _files = $(2) ;
  local _rights = $(3) ;

  for local f in $(_files)
  {
    local _member = $(f:BSG=$(_tar)) ;
    ARCHIVE_RIGHTS on $(_member) = $(_rights) ;
  }
}


# TarOwner <archive> : <files> : <owner>
#
# Set the archive owner name for members added from files. Each file
# must already have been declared for archive with Tar. The selected
# tar implementation must support the owner name.
#
rule TarOwner
{
  local _tar = $(1) ;
  local _files = $(2) ;
  local _owner = $(3) ;

  for local f in $(_files)
  {
    local _member = $(f:BSG=$(_tar)) ;
    ARCHIVE_OWNER on $(_member) = --owner=$(_owner) ;
  }
}


# TarGroup <archive> : <files> : <group>
#
# Set the archive group name for members added from files. Each file
# must already have been declared for archive with Tar. The selected
# tar implementation must support the group name.
#
rule TarGroup
{
  local _tar = $(1) ;
  local _files = $(2) ;
  local _group = $(3) ;

  for local f in $(_files)
  {
    local _member = $(f:BSG=$(_tar)) ;
    ARCHIVE_GROUP on $(_member) = --group=$(_group) ;
  }
}


if $(OS:L) = nt
{
  actions TarFile bind ARCHIVE_NAME
  {
    set TMP_DIR=$(ARCHIVE_NAME:DB)-tar
    set FILE_DIR=%TMP_DIR%\$(ARCHIVE_DIR)
    set FILE_DIR=%FILE_DIR:/=\%

    if not exist "%FILE_DIR%" (
      mkdir "%FILE_DIR%"
    )

    if exist "$(>)\\" (
      xcopy "$(>)" "%FILE_DIR%\\$(>:BS)" /E /I /Y > NUL
    ) else (
      copy "$(>)" "%FILE_DIR%" > NUL
    )

    cd "%TMP_DIR%"

    set FILE=$(>:BSD=$(ARCHIVE_DIR))
    set FILE=%FILE:\=/%%

    set ARCHIVE=../$(ARCHIVE_NAME:BS)
    set ARCHIVE=%ARCHIVE:\=/%%

    if exist "%ARCHIVE%" (
      $(TAR) rf "%ARCHIVE%" "%FILE%" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
    ) else (
      $(TAR) cf "%ARCHIVE%" "%FILE%" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
    )

    if ERRORLEVEL 1 (
      echo REPEATING $(2:BS) $(ARCHIVE_NAME:BS)
      timeout /t 1 /nobreak > NUL

      if exist "%ARCHIVE%" (
        $(TAR) rf "%ARCHIVE%" "%FILE%" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
      ) else (
        $(TAR) cf "%ARCHIVE%" "%FILE%" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
      )
    )
  }
}

if $(OS:L) != nt
{
  actions TarFile bind ARCHIVE_NAME
  {
    set -e

    TMP_DIR="$(ARCHIVE_NAME:DB)-tar"
    FILE_DIR="$TMP_DIR/$(ARCHIVE_DIR)"
    mkdir -p "$FILE_DIR"
    if test -d "$(>)"; then
      cp -R "$(>)" "$FILE_DIR"
    else
      cp "$(>)" "$FILE_DIR"
    fi

    CURRENT_DIR="$PWD"
    cd "$TMP_DIR"

    FILE="$(>:BSD=$(ARCHIVE_DIR))"
    ARCHIVE="$CURRENT_DIR/$(ARCHIVE_NAME)"

    if test -e "$ARCHIVE"; then
      $(TAR) rf "$ARCHIVE" "$FILE" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
    else
      $(TAR) cf "$ARCHIVE" "$FILE" --mode=$(ARCHIVE_RIGHTS) $(ARCHIVE_OWNER) $(ARCHIVE_GROUP)
    fi
  }
}

if $(OS:L) = nt
{
  actions together Tar
  {
    set TMP_DIR=$(1:DB)-tar
    REM echo REMOVE %TMP_DIR%

    if exist "%TMP_DIR%" (
      rd /s/q "%TMP_DIR%"
    )
  }
}
else
{
  actions together Tar
  {
    rm -rf "$(1:DB)-tar"
  }
}

} # JAMBASE_TAR_JAM_INCLUDED
