if ! $(JAMBASE_LIBJPEG_JAM_INCLUDED) {
JAMBASE_LIBJPEG_JAM_INCLUDED = true ;

LIBJPEG_CHECK_CODE = "#include <stdio.h>"
                     "#include <jpeglib.h>"
                     "int main() {"
                     "struct jpeg_decompress_struct dinfo;"
                     "jpeg_create_decompress(&dinfo);"
                     "return 0; }" ;

rule Jpeg-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(LIBJPEG_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule Jpeg-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;
    local candidate ;

    local is_debug ;
    if $(WITH_DEBUG) && ! $(WITH_OPTIM) { is_debug = true ; }

    if ! $(used) && $(linklibs)
    {
        if [ Jpeg-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used) && $(is_debug)
    {
        candidate = [ FLinkLibs jpegd ] ;
        if [ Jpeg-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs jpeg ] ;
        if [ Jpeg-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs turbojpeg ] ;
        if [ Jpeg-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# Jpeg-Configure pkg
#
# Reads pkg.* as hints. Probes for a system libjpeg installation by trying
# pkg-config first (if no hints have been provided), then falling back
# to compile-probes with toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Package-Set*,
# persists them with Package-Configure, and returns pkg. On failure
# returns empty and leaves the variables unchanged. Does not set
# pkg.TARGET.

rule Jpeg-Configure ( pkg )
{
    local result ;
    local includes  = [ Package-Includes $(pkg) ] ;
    local defines   = [ Package-Defines $(pkg) ] ;
    local linklibs  = [ Package-LinkLibs $(pkg) ] ;
    local libdir    = [ Package-LibDir $(pkg) ] ;
    local linkflags = [ Package-LinkFlags $(pkg) ] ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists libjpeg ]
        {
            includes  = [ PkgConfig-Includes libjpeg ] ;
            defines   = [ PkgConfig-CFlags libjpeg ] ;
            linklibs  = [ PkgConfig-LinkLibs libjpeg ] ;
            linkflags = [ PkgConfig-LinkFlags libjpeg ] ;

            if [ Jpeg-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = $(pkg) ;
            }
        }
    }

    if ! $(result)
    {
        if [ Jpeg-Probe $(includes) : $(defines) ]
        {
            local used = [ Jpeg-ConfigureLink $(includes) : $(defines)
                                            : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = $(pkg) ;
            }
        }
    }

    if $(result)
    {
        Package-SetIncludes $(pkg) : $(includes) ;
        Package-SetDefines $(pkg) : $(defines) ;
        Package-SetLinkLibs $(pkg) : $(linklibs) ;
        Package-SetLibDir $(pkg) : $(libdir) ;
        Package-SetLinkFlags $(pkg) : $(linkflags) ;
        Package-Configure $(pkg) ;
    }

    return $(result) ;
}

} # JAMBASE_LIBJPEG_JAM_INCLUDED
