if ! $(JAMBASE_ZLIB_JAM_INCLUDED) {
JAMBASE_ZLIB_JAM_INCLUDED = true ;

ZLIB_CHECK_CODE = "#include <zlib.h>"
                  "int main() {"
                  "z_stream zstream;"
                  "return deflateInit(&zstream, Z_DEFAULT_COMPRESSION); }" ;

rule ZLib-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(ZLIB_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule ZLib-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;

    local is_debug ;
    if $(WITH_DEBUG) && ! $(WITH_OPTIM) { is_debug = true ; }

    if ! $(used) && $(linklibs)
    {
        if [ ZLib-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used) && $(is_debug)
    {
        local candidate = [ FLinkLibs zlibd ] ;
        if [ ZLib-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        local candidate = [ FLinkLibs zlib ] ;
        if [ ZLib-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        local candidate = [ FLinkLibs zlib1 ] ;
        if [ ZLib-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        local candidate = [ FLinkLibs z ] ;
        if [ ZLib-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# ZLib-Configure INCLUDES : DEFINES : LINKLIBS : LIBDIR : LINKFLAGS
#
# Probes for a system zlib installation by trying pkg-config first (if no
# hints have been provided), then falling back to compile-probes with
# toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Packages-Set*
# and returns zlib. On failure returns empty and leaves the variables
# unchanged.

rule ZLib-Configure ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local result ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists zlib ]
        {
            includes  = [ PkgConfig-Includes zlib ] ;
            defines   = [ PkgConfig-CFlags zlib ] ;
            linklibs  = [ PkgConfig-LinkLibs zlib ] ;
            linkflags = [ PkgConfig-LinkFlags zlib ] ;

            if [ ZLib-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = zlib ;
            }
        }
    }

    if ! $(result)
    {
        if [ ZLib-Probe $(includes) : $(defines) ]
        {
            local used = [ ZLib-ConfigureLink $(includes) : $(defines)
                                            : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = zlib ;
            }
        }
    }

    if $(result)
    {
        Packages-SetIncludes zlib : $(includes) ;
        Packages-SetDefines zlib : $(defines) ;
        Packages-SetLinkLibs zlib : $(linklibs) ;
        Packages-SetLibDir zlib : $(libdir) ;
        Packages-SetLinkFlags zlib : $(linkflags) ;
    }

    return $(result) ;
}

} # JAMBASE_ZLIB_JAM_INCLUDED
