if ! $(JAMBASE_PNG_JAM_INCLUDED) {
JAMBASE_PNG_JAM_INCLUDED = true ;

LIBPNG_CHECK_CODE = "#include <png.h>"
                    "int main() {"
                    "png_structp p = png_create_read_struct("
                    "PNG_LIBPNG_VER_STRING, 0, 0, 0);"
                    "return 0; }" ;

rule Png-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(LIBPNG_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule Png-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;
    local candidate ;

    local is_debug ;
    if $(WITH_DEBUG) && ! $(WITH_OPTIM)
    {
        is_debug = true ;
    }

    if ! $(used) && $(linklibs)
    {
        if [ Png-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used) && $(is_debug)
    {
        candidate = [ FLinkLibs libpng16d ] ;
        if [ Png-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs libpng16 ] ;
        if [ Png-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs png ] ;
        if [ Png-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# Png-Configure pkg
#
# Reads pkg.* as hints. Probes for a system libpng installation by trying
# pkg-config first (if no hints have been provided), then falling back
# to compile-probes with toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Package-Set*,
# persists them with Package-Configure, and returns pkg. On failure
# returns empty and leaves the variables unchanged. Does not set
# pkg.TARGET.

rule Png-Configure ( pkg )
{
    local result ;
    local includes  = [ Package-Includes $(pkg) ] ;
    local defines   = [ Package-Defines $(pkg) ] ;
    local linklibs  = [ Package-LinkLibs $(pkg) ] ;
    local libdir    = [ Package-LibDir $(pkg) ] ;
    local linkflags = [ Package-LinkFlags $(pkg) ] ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists libpng ]
        {
            includes  = [ PkgConfig-Includes libpng ] ;
            defines   = [ PkgConfig-CFlags libpng ] ;
            linklibs  = [ PkgConfig-LinkLibs libpng ] ;
            linkflags = [ PkgConfig-LinkFlags libpng ] ;

            if [ Png-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = $(pkg) ;
            }
        }
    }

    if ! $(result)
    {
        if [ Png-Probe $(includes) : $(defines) ]
        {
            local used = [ Png-ConfigureLink $(includes) : $(defines)
                                           : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = $(pkg) ;
            }
        }
    }

    if $(result)
    {
        Package-SetIncludes $(pkg) : $(includes) ;
        Package-SetDefines $(pkg) : $(defines) ;
        Package-SetLinkLibs $(pkg) : $(linklibs) ;
        Package-SetLibDir $(pkg) : $(libdir) ;
        Package-SetLinkFlags $(pkg) : $(linkflags) ;
        Package-Configure $(pkg) ;
    }

    return $(result) ;
}

} # JAMBASE_PNG_JAM_INCLUDED
