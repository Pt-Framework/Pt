if ! $(JAMBASE_PACKAGE_JAM_INCLUDED) {
JAMBASE_PACKAGE_JAM_INCLUDED = true ;

# package.jam
#
# Common variable interface for source and prebuilt packages. A package
# name pkg exposes six dotted variables: pkg.INCLUDES, pkg.DEFINES,
# pkg.LINKLIBS, pkg.LIBDIR, pkg.LINKFLAGS and pkg.TARGET. This module
# knows nothing about prebuilt bundles, source package roots, configure
# options, or resolution order.
#
# pkg.INCLUDES is raw include directories. pkg.DEFINES is formatted
# compiler flags (-DFOO=1 / /DFOO=1), the result of FDefines.
# pkg.LINKLIBS is link-library flags. pkg.LIBDIR is raw library search
# directories. pkg.LINKFLAGS is extra linker flags. pkg.TARGET is the
# Jam target name of a source-built library. Consumers call
# LinkLibraries with that name when it is set. They also apply
# LINKLIBS, FLibPath of LIBDIR, and LINKFLAGS. Empty lists are omitted.
#
# Direct assignment to the dotted names remains valid. The accessors
# are the preferred form so callers do not spell the names by hand.

# Package-Includes <pkg>
#
# Returns pkg.INCLUDES, the raw include directories of the package.
# Empty if unset.
#
rule Package-Includes ( pkg )
{
    local name = $(pkg).INCLUDES ;
    return $($(name)) ;
}

# Package-Defines <pkg>
#
# Returns pkg.DEFINES, the formatted compiler flags of the package
# (the result of FDefines). Empty if unset.
#
rule Package-Defines ( pkg )
{
    local name = $(pkg).DEFINES ;
    return $($(name)) ;
}

# Package-LinkLibs <pkg>
#
# Returns pkg.LINKLIBS, the link-library flags of the package. Empty
# if unset.
#
rule Package-LinkLibs ( pkg )
{
    local name = $(pkg).LINKLIBS ;
    return $($(name)) ;
}

# Package-LibDir <pkg>
#
# Returns pkg.LIBDIR, the raw library search directories of the
# package. Empty if unset. The caller applies FLibPath when passing
# the result to LinkFlags.
#
rule Package-LibDir ( pkg )
{
    local name = $(pkg).LIBDIR ;
    return $($(name)) ;
}

# Package-LinkFlags <pkg>
#
# Returns pkg.LINKFLAGS, the extra linker flags of the package. Empty
# if unset.
#
rule Package-LinkFlags ( pkg )
{
    local name = $(pkg).LINKFLAGS ;
    return $($(name)) ;
}

# Package-Target <pkg>
#
# Returns pkg.TARGET, the Jam target name of a source-built library.
# Empty if the package is prebuilt or system. A non-empty value is
# how consumers detect a builtin package.
#
rule Package-Target ( pkg )
{
    local name = $(pkg).TARGET ;
    return $($(name)) ;
}

# Package-SetIncludes <pkg> : <values>
#
# Replaces pkg.INCLUDES with values. values are raw include
# directories.
#
rule Package-SetIncludes ( pkg : values * )
{
    local name = $(pkg).INCLUDES ;
    $(name) = $(values) ;
}

# Package-SetDefines <pkg> : <values>
#
# Replaces pkg.DEFINES with values. values are formatted compiler
# flags (the result of FDefines), not raw preprocessor tokens.
#
rule Package-SetDefines ( pkg : values * )
{
    local name = $(pkg).DEFINES ;
    $(name) = $(values) ;
}

# Package-SetLinkLibs <pkg> : <values>
#
# Replaces pkg.LINKLIBS with values. values are link-library flags.
#
rule Package-SetLinkLibs ( pkg : values * )
{
    local name = $(pkg).LINKLIBS ;
    $(name) = $(values) ;
}

# Package-SetLibDir <pkg> : <values>
#
# Replaces pkg.LIBDIR with values. values are raw library search
# directories, not the result of FLibPath.
#
rule Package-SetLibDir ( pkg : values * )
{
    local name = $(pkg).LIBDIR ;
    $(name) = $(values) ;
}

# Package-SetLinkFlags <pkg> : <values>
#
# Replaces pkg.LINKFLAGS with values. values are extra linker flags.
#
rule Package-SetLinkFlags ( pkg : values * )
{
    local name = $(pkg).LINKFLAGS ;
    $(name) = $(values) ;
}

# Package-SetTarget <pkg> : <value>
#
# Replaces pkg.TARGET with value. value is the Jam target name of a
# source-built library. Only a builtin package Jamconfigure sets this.
#
rule Package-SetTarget ( pkg : value )
{
    local name = $(pkg).TARGET ;
    $(name) = $(value) ;
}

# Package-Echo <pkg>
#
# Prints whether the package was found, then the six common variables
# via EchoOption, including empty lists. The found line is yes after
# Package-Configure, otherwise no. The bracket names the package, not
# pkg.FOUND. Operates only on the common names plus the found flag.
# Does not decide whether the package was found.
#
rule Package-Echo ( pkg )
{
    EchoOption "---"            : "$(pkg) found" : $($(pkg).FOUND:E="no") ;
    EchoOption $(pkg).INCLUDES  : "$(pkg) includes" ;
    EchoOption $(pkg).DEFINES   : "$(pkg) defines" ;
    EchoOption $(pkg).LINKLIBS  : "$(pkg) libs" ;
    EchoOption $(pkg).LIBDIR    : "$(pkg) library dir" ;
    EchoOption $(pkg).LINKFLAGS : "$(pkg) link flags" ;
    EchoOption $(pkg).TARGET    : "$(pkg) target" ;
}

# Package-Configure <pkg>
#
# Persists the six common variables via Configure, including empty
# lists, and sets pkg.FOUND to yes. Does not persist pkg.FOUND.
# pkg.FOUND is configure reporting. It is not a usage variable, and
# setting it does not select the package. Operates only on the common
# names plus the found flag. Does not probe and does not decide
# success. The caller invokes this only when the package was found.
#
rule Package-Configure ( pkg )
{
    Configure $(pkg).INCLUDES ;
    Configure $(pkg).DEFINES ;
    Configure $(pkg).LINKLIBS ;
    Configure $(pkg).LIBDIR ;
    Configure $(pkg).LINKFLAGS ;
    Configure $(pkg).TARGET ;

    local found = $(pkg).FOUND ;
    $(found) = yes ;
}

} # JAMBASE_PACKAGE_JAM_INCLUDED
