if ! $(JAMBASE_OPENSSL_JAM_INCLUDED) {
JAMBASE_OPENSSL_JAM_INCLUDED = true ;

OPENSSL_CHECK_CODE = "#include <openssl/ssl.h>"
                     "int main() {"
                     "OPENSSL_init_ssl(0, 0);"
                     "return 0; }" ;

rule OpenSsl-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(OPENSSL_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule OpenSsl-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;
    local candidate ;

    if ! $(used) && $(linklibs)
    {
        if [ OpenSsl-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs ssl crypto ] ;
        if [ OpenSsl-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs libssl libcrypto ] ;
        if [ OpenSsl-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# OpenSsl-Configure INCLUDES : DEFINES : LINKLIBS : LIBDIR : LINKFLAGS
#
# Probes for a system OpenSSL installation by trying pkg-config first (if
# no hints have been provided), then falling back to compile-probes with
# toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Packages-Set*
# and returns openssl. On failure returns empty and leaves the variables
# unchanged.

rule OpenSsl-Configure ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local result ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists openssl ]
        {
            includes  = [ PkgConfig-Includes openssl ] ;
            defines   = [ PkgConfig-CFlags openssl ] ;
            linklibs  = [ PkgConfig-LinkLibs openssl ] ;
            linkflags = [ PkgConfig-LinkFlags openssl ] ;

            if [ OpenSsl-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = openssl ;
            }
        }
    }

    if ! $(result)
    {
        if [ OpenSsl-Probe $(includes) : $(defines) ]
        {
            local used = [ OpenSsl-ConfigureLink $(includes) : $(defines)
                                               : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = openssl ;
            }
        }
    }

    if $(result)
    {
        Packages-SetIncludes openssl : $(includes) ;
        Packages-SetDefines openssl : $(defines) ;
        Packages-SetLinkLibs openssl : $(linklibs) ;
        Packages-SetLibDir openssl : $(libdir) ;
        Packages-SetLinkFlags openssl : $(linkflags) ;
    }

    return $(result) ;
}

} # JAMBASE_OPENSSL_JAM_INCLUDED
