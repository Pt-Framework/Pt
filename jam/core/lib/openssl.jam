if ! $(JAMBASE_OPENSSL_JAM_INCLUDED) {
JAMBASE_OPENSSL_JAM_INCLUDED = true ;

OPENSSL_CHECK_CODE = "#include <openssl/ssl.h>"
                     "int main() {"
                     "OPENSSL_init_ssl(0, 0);"
                     "return 0; }" ;

rule OpenSsl-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(OPENSSL_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule OpenSsl-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;
    local candidate ;

    if ! $(used) && $(linklibs)
    {
        if [ OpenSsl-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs ssl crypto ] ;
        if [ OpenSsl-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs libssl libcrypto ] ;
        if [ OpenSsl-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# OpenSsl-Configure pkg
#
# Reads pkg.* as hints. Probes for a system OpenSSL installation by
# trying pkg-config first (if no hints have been provided), then falling
# back to compile-probes with toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Package-Set*,
# persists them with Package-Configure, and returns pkg. On failure
# returns empty and leaves the variables unchanged. Does not set
# pkg.TARGET.

rule OpenSsl-Configure ( pkg )
{
    local result ;
    local includes  = [ Package-Includes $(pkg) ] ;
    local defines   = [ Package-Defines $(pkg) ] ;
    local linklibs  = [ Package-LinkLibs $(pkg) ] ;
    local libdir    = [ Package-LibDir $(pkg) ] ;
    local linkflags = [ Package-LinkFlags $(pkg) ] ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists openssl ]
        {
            includes  = [ PkgConfig-Includes openssl ] ;
            defines   = [ PkgConfig-CFlags openssl ] ;
            linklibs  = [ PkgConfig-LinkLibs openssl ] ;
            linkflags = [ PkgConfig-LinkFlags openssl ] ;

            if [ OpenSsl-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = $(pkg) ;
            }
        }
    }

    if ! $(result)
    {
        if [ OpenSsl-Probe $(includes) : $(defines) ]
        {
            local used = [ OpenSsl-ConfigureLink $(includes) : $(defines)
                                               : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = $(pkg) ;
            }
        }
    }

    if $(result)
    {
        Package-SetIncludes $(pkg) : $(includes) ;
        Package-SetDefines $(pkg) : $(defines) ;
        Package-SetLinkLibs $(pkg) : $(linklibs) ;
        Package-SetLibDir $(pkg) : $(libdir) ;
        Package-SetLinkFlags $(pkg) : $(linkflags) ;
        Package-Configure $(pkg) ;
    }

    return $(result) ;
}

} # JAMBASE_OPENSSL_JAM_INCLUDED
