if ! $(JAMBASE_PREBUILT_JAM_INCLUDED) {
JAMBASE_PREBUILT_JAM_INCLUDED = true ;

# prebuilt.jam
#
# Maps a prebuilt bundle onto the common package variables. Loaded on
# demand by Jamconfigure. Fetch, identity, Prebuilt-Has, Prebuilt-Bin
# and Prebuilt-Lib live here. Prebuilt-Import root binds the bundle.
# Prebuilt-Enable pkg fills still-empty pkg.* flag variables.

Load fetch.jam ;

# Identity: <os>-<arch>-<toolset>[-<abi>]. Windows always has md/mdd.
# ABI auto-map is WITH_DEBUG && ! WITH_OPTIM -> mdd, else md.
#
rule Prebuilt-Id ( abi ? )
{
    local os = $(TARGET_OS:L) ;
    switch $(os)
    {
        case nt     : os = windows ;
        case win32  : os = windows ;
        case macosx : os = macos ;
    }

    local arch = $(TARGET_OSPLAT:L) ;
    switch $(arch)
    {
        case x86_64  : arch = x64 ;
        case amd64   : arch = x64 ;
        case aarch64 : arch = arm64 ;
    }

    local toolset = $(TOOLSET:L) ;
    switch $(toolset)
    {
        case vc* : toolset = msvc ;
    }

    local id = $(os)-$(arch)-$(toolset) ;
    if $(abi)
    {
        id = $(id)-$(abi) ;
    }

    return $(id) ;
}

# Prebuilt-Fetch <url> : <root>
#
# Download <url> when <url>.manifest differs from the sidecar
# root.manifest. root is the prefix directory. The sidecar sits
# next to root, not inside it, so replacing the tree leaves it in
# place. Detects curl and tar itself. Returns root when fetched,
# empty when up to date.
#
rule Prebuilt-Fetch ( url : root )
{
    Fetch-Configure ;

    local manifestLocal = $(root).manifest ;
    local manifestTmp   = $(root).manifest.tmp ;
    local archiveTmp    = $(root).tmp ;
    local fetched       = ;

    Fetch-Url "$(url).manifest" : $(manifestTmp) ;
    local remoteContent = [ FILE_GET_CONTENTS $(manifestTmp) ] ;

    local localContent = ;
    if [ CHECK_IF_FILE $(manifestLocal) ]
    {
        localContent = [ FILE_GET_CONTENTS $(manifestLocal) ] ;
    }

    if $(remoteContent) != $(localContent)
    {
        Fetch-Url $(url) : $(archiveTmp) ;
        Fetch-RmDir $(root) ;
        Fetch-Unzip $(archiveTmp) : $(root) ;
        FILE_REMOVE $(manifestLocal) ;
        FILE_RENAME $(manifestTmp) : $(manifestLocal) ;
        fetched = $(root) ;
    }
    else
    {
        FILE_REMOVE $(manifestTmp) ;
    }

    FILE_REMOVE $(archiveTmp) ;

    return $(fetched) ;
}

# Prebuilt-Import <root>
#
# Binds the bundle at root: sets prebuilt.ROOT, includes prebuilt.jam,
# and checks prebuilt.VERSION (must be 1). Caller invokes this once
# when a prebuilt folder is selected.
#
rule Prebuilt-Import ( root )
{
    prebuilt.ROOT = $(root) ;

    if ! $(prebuilt.VERSION)
    {
        local jamfile = [ FDirName $(prebuilt.ROOT) prebuilt.jam ] ;

        if ! [ CHECK_IF_FILE $(jamfile) ]
        {
            Exit "Error: prebuilt prebuilt.jam not found:" $(jamfile) ;
        }
        else
        {
            include $(jamfile) ;

            if $(prebuilt.VERSION) != 1
            {
                Exit "Error: unsupported prebuilt.VERSION:" $(prebuilt.VERSION) ;
            }
        }
    }
}

# Prebuilt-Enable <pkg>
#
# Returns <pkg> when the loaded bundle lists it, empty otherwise. On
# success fills still-empty pkg.INCLUDES, pkg.DEFINES, pkg.LINKLIBS,
# pkg.LIBDIR and pkg.LINKFLAGS from the bundle. Leaves pkg.TARGET
# empty. Already set values, including -s overrides, are left unchanged.
#
rule Prebuilt-Enable ( pkg )
{
    local result ;

    if $(pkg) in $(prebuilt.PACKAGES)
    {
        if ! [ Package-Includes $(pkg) ]
        {
            Package-SetIncludes $(pkg) : [ Prebuilt-Includes $(pkg) ] ;
        }

        if ! [ Package-Defines $(pkg) ]
        {
            Package-SetDefines $(pkg) : [ Prebuilt-Defines $(pkg) ] ;
        }

        if ! [ Package-LinkLibs $(pkg) ]
        {
            Package-SetLinkLibs $(pkg) : [ Prebuilt-LinkLibs $(pkg) ] ;
        }

        if ! [ Package-LibDir $(pkg) ]
        {
            Package-SetLibDir $(pkg) : [ Prebuilt-LibDir $(pkg) ] ;
        }

        if ! [ Package-LinkFlags $(pkg) ]
        {
            Package-SetLinkFlags $(pkg) : [ Prebuilt-LinkFlags $(pkg) ] ;
        }

        result = $(pkg) ;
    }

    return $(result) ;
}

# Prebuilt-Depends <packages>
#
# Uses prebuilt.$(pkg).DEPENDS for a unique dependency walk.
# Named packages are first, dependencies last. Small-N list membership; not a
# solver.
#
rule Prebuilt-Depends ( packages + )
{
    local result ;
    local pending = $(packages) ;

    while $(pending)
    {
        local pkg = $(pending[1]) ;
        pending = $(pending[2-]) ;

        if ! $(pkg) in $(result)
        {
            result += $(pkg) ;
            pending += $(prebuilt.$(pkg).DEPENDS) ;
        }
    }

    return $(result) ;
}

# Prebuilt-Includes <packages>
#
# Include dirs of the prebuilt.$(pkg).DEPENDS closure. Always
# $(root)/$(pkg)/include, plus prebuilt.$(pkg).INCLUDES when set
# (prefix-relative, may contain /).
#
rule Prebuilt-Includes ( packages + )
{
    local result ;
    local pkgs = [ Prebuilt-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        result += [ FDirName $(prebuilt.ROOT) $(pkg) include ] ;

        for local inc in $(prebuilt.$(pkg).INCLUDES)
        {
            local parts = [ SPLIT_BY_CHARACTERS $(inc) : "/" ] ;
            result += [ FDirName $(prebuilt.ROOT) $(parts) ] ;
        }
    }

    return $(result) ;
}

# Prebuilt-Defines <packages>
#
# [ FDefines ... ] from prebuilt.$(pkg).DEFINES for the named
# packages only.
#
rule Prebuilt-Defines ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        if $(prebuilt.$(pkg).DEFINES)
        {
            result += [ FDefines $(prebuilt.$(pkg).DEFINES) ] ;
        }
    }

    return $(result) ;
}

# Prebuilt-LinkLibs <packages>
#
# prebuilt.$(pkg).LIBS, prebuilt.$(pkg).SYSLIBS and
# prebuilt.$(pkg).FRAMEWORKS of the named packages only. Named packages
# first. Frameworks are appended as -framework <name>. The package entry
# is the complete public link line for this bundle.
#
rule Prebuilt-LinkLibs ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        result += [ FLinkLibs $(prebuilt.$(pkg).LIBS)
                              $(prebuilt.$(pkg).SYSLIBS) ] ;

        for local fw in $(prebuilt.$(pkg).FRAMEWORKS)
        {
            result += -framework $(fw) ;
        }
    }

    return $(result) ;
}

# Prebuilt-LibDir <packages>
#
# Library paths of the prebuilt.$(pkg).DEPENDS closure. Always
# $(pkg)/lib, plus prebuilt.$(pkg).LIBDIR when set (prefix-relative).
#
rule Prebuilt-LibDir ( packages + )
{
    local result ;
    local pkgs = [ Prebuilt-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        local paths = $(pkg)/lib $(prebuilt.$(pkg).LIBDIR) ;

        for local path in $(paths)
        {
            local parts = [ SPLIT_BY_CHARACTERS $(path) : "/" ] ;
            local dir = [ FDirName $(prebuilt.ROOT) $(parts) ] ;

            if ! $(dir) in $(result)
            {
                result += $(dir) ;
            }
        }
    }

    return $(result) ;
}

# Prebuilt-LinkFlags <packages>
#
# Extra linker flags from prebuilt.$(pkg).LINKFLAGS of the named
# packages only. Never FLibPath: the caller adds it from LIBDIR.
#
rule Prebuilt-LinkFlags ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        result += $(prebuilt.$(pkg).LINKFLAGS) ;
    }

    return $(result) ;
}

# Prebuilt-Packages
#
# Names of all packages exported by the prefix.
#
rule Prebuilt-Packages
{
    return $(prebuilt.PACKAGES) ;
}

# Prebuilt-Has <pkg>
#
# Returns <pkg> when it is in prebuilt.PACKAGES, empty otherwise.
#
rule Prebuilt-Has ( pkg )
{
    local result ;

    if $(pkg) in $(prebuilt.PACKAGES)
    {
        result = $(pkg) ;
    }

    return $(result) ;
}

# Prebuilt-Files <directory>
#
# Recursively returns all files below directory. Directories are not returned.
#
rule Prebuilt-Files ( directory )
{
    local result ;

    for local entry in [ GLOB $(directory) : * ]
    {
        if [ FILE_IS_DIR $(entry) ]
        {
            result += [ Prebuilt-Files $(entry) ] ;
        }
        else
        {
            result += $(entry) ;
        }
    }

    return $(result) ;
}

# Prebuilt-Bin <packages>
#
# Files below the native bin directory of each named package. Does not resolve
# package dependencies.
#
rule Prebuilt-Bin ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        local directory = [ FDirName $(prebuilt.ROOT) $(pkg) bin ] ;

        for local file in [ Prebuilt-Files $(directory) ]
        {
            if ! $(file) in $(result)
            {
                result += $(file) ;
            }
        }
    }

    return $(result) ;
}

# Prebuilt-Lib <packages>
#
# Files below the native lib directory of each named package. Does not resolve
# package dependencies.
#
rule Prebuilt-Lib ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        local directory = [ FDirName $(prebuilt.ROOT) $(pkg) lib ] ;

        for local file in [ Prebuilt-Files $(directory) ]
        {
            if ! $(file) in $(result)
            {
                result += $(file) ;
            }
        }
    }

    return $(result) ;
}

} # JAMBASE_PREBUILT_JAM_INCLUDED
