if ! $(PREBUILT_JAM_INCLUDED) {
PREBUILT_JAM_INCLUDED = true ;

# prebuilt.jam
#
# Maps a prebuilt bundle onto the common package variables. Loaded on
# demand by Jamconfigure. Fetch, identity, Prebuilt-Has, Prebuilt-Bin
# and Prebuilt-Lib live here. Prebuilt-Load dest binds the bundle.
# Prebuilt-Use pkg fills still-empty pkg.* flag variables.

Load fetch.jam ;

# Identity: <os>-<arch>-<toolset>[-<abi>]. Windows always has md/mdd.
# ABI auto-map is WITH_DEBUG && ! WITH_OPTIM -> mdd, else md.
#
rule Prebuilt-Tuple ( abi ? )
{
    local os = $(TARGET_OS:L) ;
    switch $(os)
    {
        case nt     : os = windows ;
        case win32  : os = windows ;
        case macosx : os = macos ;
    }

    local arch = $(TARGET_OSPLAT:L) ;
    switch $(arch)
    {
        case x86_64  : arch = x64 ;
        case amd64   : arch = x64 ;
        case aarch64 : arch = arm64 ;
    }

    local toolset = $(TOOLSET:L) ;
    switch $(toolset)
    {
        case vc* : toolset = msvc ;
    }

    local id = $(os)-$(arch)-$(toolset) ;
    if $(abi)
    {
        id = $(id)-$(abi) ;
    }

    return $(id) ;
}

# Prebuilt-Fetch <url> : <dest>
#
# Download <url> when <url>.manifest changed. dest is the
# prefix directory. The sidecar is dest.manifest, next to dest,
# not inside it. Returns dest when fetched, empty when up to
# date. Caller must Fetch-Configure first.
#
rule Prebuilt-Fetch ( url : dest )
{
    Fetch-Configure ;

    local manifestLocal = [ FDirName $(dest) manifest ] ;
    local manifestTmp   = $(dest).manifest.tmp ;
    local archiveTmp    = $(dest).tmp ;
    local fetched       = ;

    Fetch-Url "$(url).manifest" : $(manifestTmp) ;
    local remoteContent = [ FILE_GET_CONTENTS $(manifestTmp) ] ;

    local localContent = ;
    if [ CHECK_IF_FILE $(manifestLocal) ]
    {
        localContent = [ FILE_GET_CONTENTS $(manifestLocal) ] ;
    }

    if $(remoteContent) != $(localContent)
    {
        Fetch-Url $(url) : $(archiveTmp) ;
        Fetch-RmDir $(dest) ;
        Fetch-Unzip $(archiveTmp) : $(dest) ;
        FILE_RENAME $(manifestTmp) : $(manifestLocal) ;
        fetched = $(dest) ;
    }

    FILE_REMOVE $(manifestTmp) ;
    FILE_REMOVE $(archiveTmp) ;

    return $(fetched) ;
}

# Prebuilt-Load <dest>
#
# Binds the bundle at dest: sets PREBUILT_ROOT, includes prebuilts.jam,
# and checks prebuilts.version (must be 1). Caller invokes this once
# when a prebuilt folder is selected.
#
rule Prebuilt-Load ( dest )
{
    PREBUILT_ROOT = $(dest) ;

    if ! $(prebuilts.version)
    {
        local jamfile = [ FDirName $(PREBUILT_ROOT) prebuilts.jam ] ;

        if ! [ CHECK_IF_FILE $(jamfile) ]
        {
            Exit "Error: prebuilt prebuilts.jam not found:" $(jamfile) ;
        }
        else
        {
            include $(jamfile) ;

            if $(prebuilts.version) != 1
            {
                Exit "Error: unsupported prebuilts.version:" $(prebuilts.version) ;
            }
        }
    }
}

# Prebuilt-Use <pkg>
#
# Returns <pkg> when the loaded bundle lists it, empty otherwise. On
# success fills still-empty pkg.INCLUDES, pkg.DEFINES, pkg.LINKLIBS,
# pkg.LIBDIR and pkg.LINKFLAGS from the bundle. Leaves pkg.TARGET
# empty. Already set values, including -s overrides, are left unchanged.
#
rule Prebuilt-Use ( pkg )
{
    local result ;

    if $(pkg) in $(prebuilts.packages)
    {
        if ! [ Packages-Includes $(pkg) ]
        {
            Packages-SetIncludes $(pkg) : [ Prebuilt-Includes $(pkg) ] ;
        }

        if ! [ Packages-Defines $(pkg) ]
        {
            Packages-SetDefines $(pkg) : [ Prebuilt-CxxFlags $(pkg) ] ;
        }

        if ! [ Packages-LinkLibs $(pkg) ]
        {
            Packages-SetLinkLibs $(pkg) : [ Prebuilt-LinkLibs $(pkg) ] ;
        }

        if ! [ Packages-LibDir $(pkg) ]
        {
            Packages-SetLibDir $(pkg) : [ Prebuilt-LibPath $(pkg) ] ;
        }

        if ! [ Packages-LinkFlags $(pkg) ]
        {
            Packages-SetLinkFlags $(pkg) : [ Prebuilt-LinkFlags $(pkg) ] ;
        }

        result = $(pkg) ;
    }

    return $(result) ;
}

# Prebuilt-Depends <packages>
#
# Uses prebuilts.$(pkg).DEPENDS for a unique dependency walk.
# Named packages are first, dependencies last. Small-N list membership; not a
# solver.
#
rule Prebuilt-Depends ( packages + )
{
    local result ;
    local pending = $(packages) ;

    while $(pending)
    {
        local pkg = $(pending[1]) ;
        pending = $(pending[2-]) ;

        if ! $(pkg) in $(result)
        {
            result += $(pkg) ;
            pending += $(prebuilts.$(pkg).DEPENDS) ;
        }
    }

    return $(result) ;
}

# Prebuilt-Includes <packages>
#
# Include dirs of the prebuilts.$(pkg).DEPENDS closure. Always
# $(root)/$(pkg)/include, plus prebuilts.$(pkg).INCLUDES when set
# (prefix-relative, may contain /).
#
rule Prebuilt-Includes ( packages + )
{
    local result ;
    local pkgs = [ Prebuilt-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        result += [ FDirName $(PREBUILT_ROOT) $(pkg) include ] ;

        for local inc in $(prebuilts.$(pkg).INCLUDES)
        {
            local parts = [ SPLIT_BY_CHARACTERS $(inc) : "/" ] ;
            result += [ FDirName $(PREBUILT_ROOT) $(parts) ] ;
        }
    }

    return $(result) ;
}

# Prebuilt-CxxFlags <packages>
#
# [ FDefines ... ] from prebuilts.$(pkg).DEFINES for the named
# packages only.
#
rule Prebuilt-CxxFlags ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        if $(prebuilts.$(pkg).DEFINES)
        {
            result += [ FDefines $(prebuilts.$(pkg).DEFINES) ] ;
        }
    }

    return $(result) ;
}

# Prebuilt-LinkLibs <packages>
#
# prebuilts.$(pkg).LIBS, prebuilts.$(pkg).SYSLIBS and
# prebuilts.$(pkg).FRAMEWORKS of the named packages only. Named packages
# first. Frameworks are appended as -framework <name>. The package entry
# is the complete public link line for this bundle.
#
rule Prebuilt-LinkLibs ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        result += [ FLinkLibs $(prebuilts.$(pkg).LIBS)
                              $(prebuilts.$(pkg).SYSLIBS) ] ;

        for local fw in $(prebuilts.$(pkg).FRAMEWORKS)
        {
            result += -framework $(fw) ;
        }
    }

    return $(result) ;
}

# Prebuilt-LibPath <packages>
#
# Library paths of the prebuilts.$(pkg).DEPENDS closure. Always
# $(pkg)/lib, plus prebuilts.$(pkg).LIBDIR when set (prefix-relative).
#
rule Prebuilt-LibPath ( packages + )
{
    local result ;
    local pkgs = [ Prebuilt-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        local paths = $(pkg)/lib $(prebuilts.$(pkg).LIBDIR) ;

        for local path in $(paths)
        {
            local parts = [ SPLIT_BY_CHARACTERS $(path) : "/" ] ;
            local dir = [ FDirName $(PREBUILT_ROOT) $(parts) ] ;

            if ! $(dir) in $(result)
            {
                result += $(dir) ;
            }
        }
    }

    return $(result) ;
}

# Prebuilt-LinkFlags <packages>
#
# Extra linker flags from prebuilts.$(pkg).LINKFLAGS of the named
# packages only. Never FLibPath: the caller adds it from LIBDIR.
#
rule Prebuilt-LinkFlags ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        result += $(prebuilts.$(pkg).LINKFLAGS) ;
    }

    return $(result) ;
}

# Prebuilt-Packages
#
# Names of all packages exported by the prefix.
#
rule Prebuilt-Packages
{
    return $(prebuilts.packages) ;
}

# Prebuilt-Has <package>
#
# Returns <package> when it is in prebuilts.packages, empty otherwise.
#
rule Prebuilt-Has ( package )
{
    local result ;

    if $(package) in $(prebuilts.packages)
    {
        result = $(package) ;
    }

    return $(result) ;
}

# Prebuilt-Files <directory>
#
# Recursively returns all files below directory. Directories are not returned.
#
rule Prebuilt-Files ( directory )
{
    local result ;

    for local entry in [ GLOB $(directory) : * ]
    {
        if [ FILE_IS_DIR $(entry) ]
        {
            result += [ Prebuilt-Files $(entry) ] ;
        }
        else
        {
            result += $(entry) ;
        }
    }

    return $(result) ;
}

# Prebuilt-Bin <packages>
#
# Files below the native bin directory of each named package. Does not resolve
# package dependencies.
#
rule Prebuilt-Bin ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        local directory = [ FDirName $(PREBUILT_ROOT) $(pkg) bin ] ;

        for local file in [ Prebuilt-Files $(directory) ]
        {
            if ! $(file) in $(result)
            {
                result += $(file) ;
            }
        }
    }

    return $(result) ;
}

# Prebuilt-Lib <packages>
#
# Files below the native lib directory of each named package. Does not resolve
# package dependencies.
#
rule Prebuilt-Lib ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        local directory = [ FDirName $(PREBUILT_ROOT) $(pkg) lib ] ;

        for local file in [ Prebuilt-Files $(directory) ]
        {
            if ! $(file) in $(result)
            {
                result += $(file) ;
            }
        }
    }

    return $(result) ;
}

} # PREBUILT_JAM_INCLUDED
