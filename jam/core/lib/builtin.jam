if ! $(JAMBASE_BUILTIN_JAM_INCLUDED) {
JAMBASE_BUILTIN_JAM_INCLUDED = true ;

# builtin.jam
#
# Selects source packages from a root directory. Loaded by
# Jamconfigure and by the parent Jamfile.
# This module knows nothing about prebuilt bundles, configure option
# parsing, or resolution order.
#
# The package name is the public identity. Builtin-Configure,
# Builtin-Top, Builtin-SubInclude, Builtin-Set and Builtin-Get all
# take that name. The parent passes the source path once, at
# configure, to Builtin-Configure.

# Builtin-Top <pkg>
#
# Returns pkg.TOP, the source root set by Builtin-Configure. Empty if
# unset.
#
rule Builtin-Top ( pkg )
{
    local name = $(pkg).TOP ;
    return $($(name)) ;
}

# Builtin-Set <pkg> : <var> : <value>
#
# Sets pkg.var to value. The parent sets package-specific names the
# package Jamfile reads with Builtin-Get, for example OUTPUT_TARGET.
#
rule Builtin-Set ( pkg : var : value * )
{
    local name = $(pkg).$(var) ;
    $(name) = $(value) ;
}

# Builtin-Get <pkg> : <var>
#
# Returns pkg.var. Empty if unset.
#
rule Builtin-Get ( pkg : var )
{
    local name = $(pkg).$(var) ;
    return $($(name)) ;
}

# Builtin-Configure <pkg> : <dir>
#
# Joins dir with FDirName to form the source root. Returns pkg when
# the source package is selected, empty otherwise. Presence is a
# directory check of the root. There is no network access and no
# download. When the directory exists the rule sets pkg.TOP, includes
# <root>/Jamconfigure, and returns pkg when pkg.TARGET is set. On
# success it persists pkg.TOP and the six common variables. A missing
# directory returns empty. A missing Jamconfigure is an Exit. A
# configure error in the package Jamconfigure is also an Exit. The
# rule does not set pkg.TARGET and does not probe.
#
rule Builtin-Configure ( pkg : dir + )
{
    local result ;
    local root = [ FDirName $(dir) ] ;

    if [ FILE_IS_DIR $(root) ]
    {
        local jamconfigure = [ FDirName $(root) Jamconfigure ] ;

        if ! [ CHECK_IF_FILE $(jamconfigure) ]
        {
            Exit "Error: builtin Jamconfigure not found:" $(jamconfigure) ;
        }
        else
        {
            local name = $(pkg).TOP ;
            $(name) = $(root) ;
            include $(jamconfigure) ;

            if [ Package-Target $(pkg) ]
            {
                Configure $(name) ;
                Package-Configure $(pkg) ;
                result = $(pkg) ;
            }
        }
    }

    return $(result) ;
}

# Builtin-SubInclude <pkg>
#
# Includes the package Jamfile. Sets the SubDir Jamrules gate
# pkg.TOP-included, then SubInclude pkg.TOP. The caller invokes this
# only when Package-Target is set.
#
rule Builtin-SubInclude ( pkg )
{
    local name = $(pkg).TOP ;
    local gate = $(name)-included ;
    $(gate) = TRUE ;
    SubInclude $(name) ;
}

} # JAMBASE_BUILTIN_JAM_INCLUDED
