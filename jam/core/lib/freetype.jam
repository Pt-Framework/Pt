if ! $(JAMBASE_FREETYPE_JAM_INCLUDED) {
JAMBASE_FREETYPE_JAM_INCLUDED = true ;

FREETYPE_CHECK_CODE = "#include <ft2build.h>"
                     "#include FT_FREETYPE_H"
                     "int main() {"
                     "FT_Library ft;"
                     "FT_Init_FreeType( &ft );"
                     "return 0; }" ;

rule Freetype-Probe ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    return [ CheckBuildC++ $(FREETYPE_CHECK_CODE)
                          : $(defines) [ FIncludes $(includes) ]
                          : $(linklibs) [ FLibPath $(libdir) ] $(linkflags) ] ;
}

rule Freetype-ConfigureLink ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local used ;
    local candidate ;

    local is_debug ;
    if $(WITH_DEBUG) && ! $(WITH_OPTIM) { is_debug = true ; }

    if ! $(used) && $(linklibs)
    {
        if [ Freetype-Probe $(includes) : $(defines) : $(linklibs) : $(libdir) : $(linkflags) ]
        {
            used = $(linklibs) ;
        }
    }

    if ! $(used) && $(is_debug)
    {
        candidate = [ FLinkLibs freetyped ] ;
        if [ Freetype-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    if ! $(used)
    {
        candidate = [ FLinkLibs freetype ] ;
        if [ Freetype-Probe $(includes) : $(defines) : $(candidate) : $(libdir) : $(linkflags) ]
        {
            used = $(candidate) ;
        }
    }

    return $(used) ;
}

# Freetype-Configure INCLUDES : DEFINES : LINKLIBS : LIBDIR : LINKFLAGS
#
# Probes for a system freetype installation by trying pkg-config first (if
# no hints have been provided), then falling back to compile-probes with
# toolset-neutral library flags.
#
# On success writes the five flag variables unmerged through Package-Set*
# and returns freetype. On failure returns empty and leaves the variables
# unchanged.

rule Freetype-Configure ( includes * : defines * : linklibs * : libdir * : linkflags * )
{
    local result ;
    local hdr ;

    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(defines) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists freetype2 ]
        {
            includes  = [ PkgConfig-Includes freetype2 ] ;
            defines   = [ PkgConfig-CFlags freetype2 ] ;
            linklibs  = [ PkgConfig-LinkLibs freetype2 ] ;
            linkflags = [ PkgConfig-LinkFlags freetype2 ] ;

            if [ Freetype-Probe $(includes) : $(defines) : $(linklibs) : : $(linkflags) ]
            {
                result = freetype ;
            }
        }
    }

    if ! $(result)
    {
        if [ Freetype-Probe $(includes) : $(defines) ]
        {
            hdr = yes ;
        }
        else if ! $(includes)
        {
            includes = /usr/include/freetype2 /usr/include ;
            if [ Freetype-Probe $(includes) : $(defines) ]
            {
                hdr = yes ;
            }
            else
            {
                includes = /usr/local/include/freetype2 /usr/local/include ;
                if [ Freetype-Probe $(includes) : $(defines) ]
                {
                    hdr = yes ;
                }
            }
        }

        if $(hdr)
        {
            local used = [ Freetype-ConfigureLink $(includes) : $(defines)
                                                : $(linklibs) : $(libdir) : $(linkflags) ] ;
            if $(used)
            {
                linklibs = $(used) ;
                result = freetype ;
            }
        }
    }

    if $(result)
    {
        Package-SetIncludes freetype : $(includes) ;
        Package-SetDefines freetype : $(defines) ;
        Package-SetLinkLibs freetype : $(linklibs) ;
        Package-SetLibDir freetype : $(libdir) ;
        Package-SetLinkFlags freetype : $(linkflags) ;
    }

    return $(result) ;
}

} # JAMBASE_FREETYPE_JAM_INCLUDED
