##########################################################################
# Jam Environment
#
# TODO:
# http://www.boost.org/boost-build2/doc/html/jam/language.html
#
##########################################################################

if ! $(JAM_ROOT)
{
    Exit "JAM_ROOT not set" ;
}

JAM_ROOT = $(JAM_ROOT:J=" ") ;
JAM_LIBPATH = $(JAM_ROOT)/core/lib ;
JAM_LIBPATH += $(JAM_ROOT)/local/lib ;

# Load <dir> * <name>
#
# Loads a Jam runtime module from JAM_LIBPATH. The arguments passed to the
# Load rule are joined as a local path.
#
rule Load
{
    local _inc = $(<[1]) ;

    for local _dir in $(<[2-])
    {
        _inc = $(_dir:R=$(_inc)) ;
    }

    local _found ;
    for local _dir in $(JAM_LIBPATH)
    {
        local _file = $(_inc:R=$(_dir)) ;
        if [ CHECK_IF_FILE $(_file) ]
        {
            include $(_file) ;
            _found = true ;
            break ;
        }
    }

    if ! $(_found)
    {
        Exit "Could not load" $(_inc) "in" $(JAM_LIBPATH) ;
    }
}

Load base.jam ;

##########################################################################
# Configuration Switch
##########################################################################

for local arg in $(ARGV)
{
    if $(JAM_SWITCH) && ! $(JAM_SWITCH_CONFIG)
    {
        JAM_SWITCH_CONFIG = $(arg) ;
    }

    if $(arg) = "switch"
    {
        JAM_SWITCH = true ;
    }
}

if status in $(ARGV)
{
    Load configure.jam ;
    ConfigureStatus ;
}

##########################################################################
# Configure Step
##########################################################################

if configure in $(ARGV)
{
    JAM_CONFIGURE = true ;
}

if $(JAM_SWITCH) || $(JAM_CONFIGURE)
{
    Load configure.jam ;

    ConfigureClean ;

    if $(JAM_SWITCH)
    {
        ConfigureSwitch $(JAM_SWITCH_CONFIG) ;
    }

    Echo "Configuring..." ;
    EchoOption JAMBASE : "Using Jambase" : $(JAMBASE) ;
    EchoOption OS : "Build Host OS" : $(OS:L) ;
    EchoOption OSPLAT : "Host Platform" ;

    if --debug in $(ARGV)
    {
        WITH_DEBUG = yes ;
        CONFIG ?= debug ;
    }

    EchoOption --debug : "Debug Build" : $(WITH_DEBUG:E="no") ;

    if --optimize in $(ARGV)
    {
        WITH_OPTIM = yes ;
        CONFIG ?= release ;
    }

    EchoOption --optimize : "Optimized Build" : $(WITH_OPTIM:E="no") ;

    STDC++ ?= [ GetOption --stdc++ ] ;

    EchoOption --stdc++ : "C++ Standard" : $(STDC++:E="(compiler default)") ;

    # configure build
    ConfigureLog "[ Configure ]" ;
    ConfigureRm ;
    ConfigureMv ;
    ConfigureCp ;
    ConfigureMkDir ;
    ConfigureChMod ;
    ConfigureLn ;
    ConfigureDotSlash ;
    ConfigureCmd ;
    ConfigureTarget ;
    ConfigureToolset ;

    # TODO: set NDEBUG here for all toolsets

    # Project specific configuration
    ConfigureLog "\n[ Jamconfigure ]" ;
    include Jamconfigure ;

    # save configuration, so it can be reused
    Configure CONFIG ;
    ConfigureSave $(CONFIG) ;
    EchoOption CONFIG : "Build configuration" ;

    ConfigureExit ;
}

if ! [ CHECK_IF_FILE Jamrules ]
{
    Exit "Build not configured. Run jam configure first." ;
}

##########################################################################
# Build Step
##########################################################################

Load build.jam ;

# Project root Jamfile
include Jamfile ;

##########################################################################
# Reset Target
##########################################################################

if $(CONFIG)
{
    DEPENDS reset : clean ;
    NOTFILE reset ;
    ALWAYS reset ;

    Clean reset : $(JAMRULES) ;
    Clean reset : [ GLOB "" : Jamrules.$(CONFIG) ] ;
}
