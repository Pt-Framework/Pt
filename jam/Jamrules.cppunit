if ! $(JAMRULES_CPPUNIT) {
JAMRULES_CPPUNIT = true ;


# Rules for build and execute cppunit test
#


rule CppUnitTest
{
	local _target = $(1:S=$(SUFEXE)) ;

	DEPENDS test : $(_target) ;

	Main $(<) : $(>) ;
	Main_LinkLibraries $(1) : cppunit ;	

	local _output = $(1:S=.cppunit) ;
	Depends $(_output) : $(_target) ;
	Clean clean : $(_output) ;

	testExe on $(_target) = $(_target) ;
	CppUnitTestAction $(_target) : $(_output) ;
}


actions CppUnitTestAction bind testExe
{ 
	$(testExe) -f$(1:S=.cppunit)
}


if $(TARGET_OS:U) = WINCE 
{

	if $(REMOTE_TESTS)
	{
		actions CppUnitTestAction bind testExe
		{ 	
			IF EXIST $(testExe:D)$(SLASH)$(1:S=.cppunit.ok) $(RM) $(testExe:D)$(SLASH)$(1:S=.cppunit.ok)

			ce connect 1

			ce copy $(testExe) \$(testExe:BS)

			ce start "\$(testExe:BS)" -f\$(testExe:B).cppunit

			@ping 127.0.0.1 -n 2 -w 1000 > nul
			@ping 127.0.0.1 -n 5 -w 1000 > nul

			REM ce get \$(testExe:B).cppunit $(testExe:D)$(SLASH)$(1:S=.cppunit)
			ce get \$(testExe:B).cppunit $(1:S=.cppunit)

			REM ce get \$(testExe:B).cppunit.ok $(testExe:D)$(SLASH)$(1:S=.cppunit.ok)
			ce get \$(testExe:B).cppunit.ok $(1:S=.cppunit.ok)

			taskkill /F /IM DeviceEmulator.exe

			REM IF NOT EXIST $(testExe:D)$(SLASH)$(1:S=.cppunit.ok) $(MV) $(testExe:D)$(SLASH)$(1:S=.cppunit) $(testExe:D)$(SLASH)$(1:S=.failed)
			IF NOT EXIST $(1:S=.cppunit.ok) $(MV) $(1:S=.cppunit) $(1:S=.failed)

			REM IF EXIST $(testExe:D)$(SLASH)$(1:S=.cppunit.ok) $(RM) $(testExe:D)$(SLASH)$(1:S=.cppunit.ok)
			IF EXIST $(1:S=.cppunit.ok) $(RM) $(1:S=.cppunit.ok)
		}
	}
	else
	{
		actions CppUnitTestAction bind testExe
		{ 	
			echo Enable tests with -sREMOTE_TESTS=true (NOTE: Device Command Shell must be installed.)
		}
	}
	
}


} # JAMRULES_CPPUNIT
