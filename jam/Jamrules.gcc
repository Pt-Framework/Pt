CC        = gcc ;
C++       = g++ ;
if $(CXX)
{
	C++ = $(CXX) ;
}

CCFLAGS 	+= -Wall ;
C++FLAGS	+= $(CCFLAGS) ; # -std=c++98 -D__STDC_VERSION__=199901L ;
LINKFLAGS	?= $(CCFLAGS) ;
LINKLIBS	+= -lstdc++ ;
RANLIB		?= ranlib ;


# Configuration specific compiler flags
#
if $(CONFIG) = debug 
{
	CCFLAGS += -DDEBUG -g ;
	OPTIM   = -O ;
}
else
{
	OPTIM		= -O2 ;
}

# CPU specific compiler flags
#
if $(TARGET_OSPLAT:U) != X86
{
	CCFLAGS += -fPIC ;
}


# MinGW support for gcc under NT
#
if $(TARGET_OS:L) = "nt"
{
	if $(MINGW) 
	{
		MINGW   = $(MINGW:J=" ") ;
		AR      = "$(MINGW)\\bin\\ar ru" ;
		CC      = $(MINGW)\\bin\\gcc ;
		C++     = $(MINGW)\\bin\\g++ ;
		RANLIB  = $(MINGW)\\bin\\ranlib ;
		LINKFLAGS += -Wl,--enable-runtime-pseudo-reloc ;
	}
	else
	{
		Exit "Please specify path to the MinGW installation with -sMINGW" ;
	}
}


# Add a compiler define
#
# The specified string will be returnd as a define compiler
# option, i.e. -D on gcc or /D on vc++
#
rule FDefines 
{ return -D$(<) ; }


rule FIncludes 
{ return -I$(<) ; }


# @brief Links a shared library to an executable
#
# @param < the target name
# @param > list of shared libraries
rule Main_LinkSharedLibraries
{
	local _target = $(<)$(SUFEXE) ;
	LINKFLAGS on $(_target) += -L$(SEARCH_SHLIB) ;
	LINKLIBS on $(_target) += -l$(>)$(SUFDBG) $(LINKLIBS) ;
}


rule SharedLibrary_MakeLocate
{
	MakeLocate $(PRELIB)$(<:S=$(SUFDLL)) : $(>) ;
	SEARCH_SHLIB += $(>) ;
}


# @brief Links a shared library to an executable
#
# @param < the target name
# @param > list of shared libraries
rule SharedLibrary_LinkSharedLibraries
{
	local _target = $(PRELIB)$(<)$(SUFDLL) ;
	Depends $(_target) : $(PRELIB)$(>)$(SUFDLL) ;
	LINKFLAGS on $(_target) += -L$(SEARCH_SHLIB) ;	
	LINKLIBS on $(_target) += -l$(>)$(SUFDBG) $(LINKLIBS) ;
}

# Set outputdirectory for binary files
#
# param 1 target name
# param 2 file name with suffix
# param 3 directory name
#
rule SetOutputDirectory
{
	local _outputDir = $(LOCATE_TARGET) ;
	
	if $(3)	{	
		_outputDir = $(3) ;		
	}	
	MakeLocate $(2) : $(_outputDir) ;
	LINKFLAGS on $(2) += -L$(3) ;
}


# @brief builds a shared library from object files
#
rule SharedLibraryFromObjects
{
	# Add grist to file names
	local _sources = [ FGristObjectFiles $(>) ] ;

	# Add library name decorations <lib><name><.so>
	local _target = $(PRELIB)$(<)$(SUFDLL) ;

	
	# setup dependencies
	Depends exe : $(_target) ;
	Depends lib : $(_target) ;
	Depends $(_target) : $(_sources) ;
	Depends $(PRELIB)$(<:S=$(SUFLIB)) : $(_target) ;

	#MakeLocate $(_target) : $(LOCATE_TARGET) ;

	# include library path
	SEARCH_SHLIB += $(LOCATE_TARGET) ;

	Clean clean : $(_target) ;

	LINKFLAGS on $(_target) += $(LINKFLAGS) -shared ;
	Link $(_target) : $(_sources) ;
}


actions Link bind NEEDLIBS
{
    $(CC) $(LINKFLAGS) -o $(<) $(UNDEFS) $(>) -Wl,--start-group $(LINKLIBS) $(NEEDLIBS) --end-group
}

