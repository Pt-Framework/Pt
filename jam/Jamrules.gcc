
# Initialize variables
#
CC        = gcc ;
C++       = g++ ;
if $(CXX)
{
	C++ = $(CXX) ;
}
RANLIB		?= ranlib ;


# Flags and options
#
# TODO: How to detect if the GCC version is >= 4.0.0 and thus the visibility
#       options below can be enabled ???
#
#CCFLAGS 	+= -fvisibility-inlines-hidden -fvisibility=hidden ;
#LINKFLAGS	?= -fvisibility-inlines-hidden -fvisibility=hidden ;
LINKLIBS	+= -lstdc++ ;

if $(CONFIG:L) = debug
{
	CCFLAGS += -DDEBUG -g ;
	OPTIM   ?= -O0 ;
}
else
{
	CCFLAGS += -DNDEBUG ;
	OPTIM	  ?= -O1 ;
}

WARN ?= -Wall ;

# only use -fPIC for non-X86 CPUs
if $(TARGET_OSPLAT:U) != X86
{
	CCFLAGS += -fPIC ;
}

C++FLAGS	+= $(CCFLAGS) ;


# MinGW support for gcc under NT
#
if $(TARGET_OS:L) = "nt"
{
	if $(MINGW)
	{
		MINGW   = $(MINGW:J=" ") ;
		AR      = "$(MINGW)\\bin\\ar ru" ;
		CC      = $(MINGW)\\bin\\gcc ;
		C++     = $(MINGW)\\bin\\g++ ;
		RANLIB  = $(MINGW)\\bin\\ranlib ;
		LINKFLAGS += -Wl,--enable-runtime-pseudo-reloc ;
	}
	else
	{
		Exit "Please specify path to the MinGW installation with -sMINGW" ;
	}
}


rule FDefines
{ return -D$(<) ; }


rule FIncludes
{ return -I$(<) ; }


rule MainImpl
{
    # Add executable name decoration
    local _target = $(<:S=$(SUFEXE)) ;

    # linker flag -E: export global symbols from the executable
    LINKFLAGS on $(_target) += $(LINKFLAGS) -Wl,-E ;
}


rule Main_LinkSharedLibrariesImpl
{
    local _target = $(<)$(SUFEXE) ;
    Depends $(_target) : $(PRELIB)$(>)$(SUFDLL) ;

    local _l = $(>:S=$(SUFDLL)) ;
    SHLIBS on $(_target) += $(_l) ;
}


# Adds a resource to be linked with a binary.
# Not implemented for GCC - on Windows, it can be 
# used to add an icon to the binary
#
# param 1 executable
# param 2 resource file
# param 3 output directory of compiled resource file
#
# Resource prog : resources.rc : output_directory ;
rule Resource
{
}


rule SharedLibraryImpl
{
    # Add library name decorations <lib><name><.so>
    local _target = $(PRELIB)$(<)$(SUFDLL) ;

    LINKFLAGS on $(_target) += $(LINKFLAGS) -shared ;
}


rule SharedLibrary_LinkSharedLibrariesImpl
{
    local _target = $(PRELIB)$(<)$(SUFDLL) ;
    local _deps = $(PRELIB)$(>)$(SUFDLL) ;
    Depends $(_target) : $(_deps) ;

    local _l = $(>:S=$(SUFDLL)) ;
    SHLIBS on $(_target) += $(_l) ;

    # Add all shared libraries required by this shared library in a
    # variable called RPATHLIBS so that their paths can be added as
    # rpath-link option to the linker command later
    for local _d in $(_deps)
    {
        local _found = false ;

        for _r in $(RPATHLIBS)
        {
            if $(_r) = $(_d)
            {
                _found = true ;
            }
        }

        # only add if not added previously
        if $(_found) = false
        {
            Echo rpath $(_d) ;
            RPATHLIBS += $(_d)  ;
        }
    }
}


actions Link bind NEEDLIBS SHLIBS RPATHLIBS
{
    $(CC) $(LINKFLAGS) -Wl,-rpath-link$(SPACE)$(RPATHLIBS:P) -L$(SHLIBS:P) $(WARN) -o $(<) $(UNDEFS) $(>) -Wl,--start-group -l$(SHLIBS:B) $(LINKLIBS) $(NEEDLIBS) -Wl,--end-group
}

