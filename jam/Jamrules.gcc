# Tools
#
CC        = gcc ;
C++       = g++ ;
if $(CXX)
{
	C++ = $(CXX) ;
}
RANLIB		?= ranlib ;

# Flags and options
#
# TODO: How to detect if the GCC version is >= 4.0.0 and thus the visibility
#       options below can be enabled ???
#
CCFLAGS 	+= -Wall ; #-fvisibility-inlines-hidden -fvisibility=hidden ;
LINKFLAGS	?= -Wall ; #-fvisibility-inlines-hidden -fvisibility=hidden ;
LINKLIBS	+= -lstdc++ ;

if $(CONFIG) = debug
{
	CCFLAGS += -DDEBUG -g ;
	OPTIM   = -O ;
}
else
{
	CCFLAGS += -DNDEBUG ;
	OPTIM	= -O1 ;
}

# only use -fPIC for non-X86 CPUs
if $(TARGET_OSPLAT:U) != X86
{
	CCFLAGS += -fPIC ;
}

C++FLAGS	+= $(CCFLAGS) ;


# MinGW support for gcc under NT
#
if $(TARGET_OS:L) = "nt"
{
	if $(MINGW)
	{
		MINGW   = $(MINGW:J=" ") ;
		AR      = "$(MINGW)\\bin\\ar ru" ;
		CC      = $(MINGW)\\bin\\gcc ;
		C++     = $(MINGW)\\bin\\g++ ;
		RANLIB  = $(MINGW)\\bin\\ranlib ;
		LINKFLAGS += -Wl,--enable-runtime-pseudo-reloc ;
	}
	else
	{
		Exit "Please specify path to the MinGW installation with -sMINGW" ;
	}
}


rule FDefines
{ return -D$(<) ; }


rule FIncludes
{ return -I$(<) ; }


rule Main_LinkSharedLibraries
{
    local _target = $(<)$(SUFEXE) ;
    Depends $(_target) : $(PRELIB)$(>)$(SUFDLL) ;
    NEEDLIBS on $(_target) += $(PRELIB)$(>:S=$(SUFDLL)) ;
}


rule SharedLibrary_MakeLocate
{
    MakeLocate $(PRELIB)$(<:S=$(SUFDLL)) : $(>) ;
}


rule SharedLibrary_LinkSharedLibraries
{
    local _target = $(PRELIB)$(<)$(SUFDLL) ;
    Depends $(_target) : $(PRELIB)$(>)$(SUFDLL) ;
    NEEDLIBS on $(_target) += $(PRELIB)$(>:S=$(SUFDLL)) ;
}


rule SharedLibraryFromObjects
{
	# Add grist to file names
	local _sources = [ FGristFiles $(>) ] ;

	# Add library name decorations <lib><name><.so>
	local _target = $(PRELIB)$(<)$(SUFDLL) ;

	# setup dependencies
	Depends exe : $(_target) ;
	Depends lib : $(_target) ;
	Depends $(_target) : $(_sources) ;
	Depends $(PRELIB)$(<:S=$(SUFLIB)) : $(_target) ;

	MakeLocate $(_target) : $(LOCATE_TARGET) ;

	Clean clean : $(_target) ;

	LINKFLAGS on $(_target) += $(LINKFLAGS) -shared ;
	Link $(_target) : $(_sources) ;
}


actions Link bind NEEDLIBS
{
    $(CC) $(LINKFLAGS) -o $(<) $(UNDEFS) $(>) -Wl,--start-group $(LINKLIBS) $(NEEDLIBS) --end-group
}

