##############################################################################
# Configuration rules
##############################################################################

rule TryBuild
{
    local _cc = $(1) ;
    local _src = $(2) ;
    local _cflags = $(3) ;
    local _l = $(4) ;
    local _L = $(5) ;
    local _out = a.out ;
    local _cmd ;

    TryCommand $(RM) $(_out) ;

    if $(4)
    {
        _cmd = $(_cc) $(LINKFLAGS) -o $(_out) $(_cflags) -I$(STDHDRS) -L$(5) -bdynamic $(4) $(_src) ;
    }
    else
    {
        _cmd = $(_cc) -c -o $(_out) $(_cflags) -I$(STDHDRS) $(_src) ;
    }

    local _r = [ TryCommand $(_cmd) ] ;

    TryCommand $(RM) $(_out) ;
    return $(_r) ;
}


rule TryBuildCc
{
    local _cflags = $(CCFLAGS) $(2) ;
    return [ TryBuild $(CC) : $(1) : $(2) : $(3) : $(4) ] ;
}


rule TryBuildC++
{
    local _cflags = $(C++FLAGS) $(2) ;
    return [ TryBuild $(C++) : $(1) : $(2) : $(3) : $(4) ] ;
}


rule ConfigureCc
{
    if ! $(CC_CONFIGURED)
    {
        CC_CONFIGURED = 1 ;
   
        AS     ?= as ;
        CC     ?= xlC_r ;
        RANLIB ?= ranlib ;
        AR     ?= ar ru ;
        LINK   ?= $(CC) ;
    
        Configure AS ;
        Echo "Checking for assember..." $(AS:BS) ;
    
        Configure AR ;
        Echo "Checking for archiver..." $(AR:BS) ;
    
        Configure CC ;
        Echo "Checking for C compiler..." $(CC:BS) ;
    
        Configure LINK ;
        Echo "Checking for linker..." $(LINK:BS) ;
    
        Configure RANLIB ;
        Echo "Checking for ranlib..." $(RANLIB:BS) ;
    
        LINKFLAGS += -bh:5 ;

        if $(CONFIG:L) = debug
        {
            CCFLAGS += -DDEBUG ;
            OPTIM   ?= -O0 -g ;
        }
        else
        {
            CCFLAGS += -DNDEBUG ;
            OPTIM	  ?= -O2 ;
        }

        WARN ?= -qinfo=lan ;

        Configure CCFLAGS ;
        Configure OPTIM ;
        Configure WARN ;
        Configure LINKFLAGS ;
    }
}


rule ConfigureC++
{
    ConfigureCc ;

    if ! $(C++_CONFIGURED)
    {
        C++_CONFIGURED = 1 ;

        CC++ ?= xlC_r ;
        Configure C++ ;
        Echo "Checking for C++ compiler..." $(C++:BS) ;

        LINK++ = $(C++) ;
        Configure LINK++ ;
        Echo "Checking for C++ linker" $(LINK++:BS) ;

        C++FLAGS += -qrtti -qlanglvl=newexcp -qeh -qstaticinline ;
        
        if $(CONFIG:L) = debug
        {
            C++FLAGS  += -DDEBUG ;
        }
        else
        {
            C++FLAGS  += -DNDEBUG ;
        }

        Configure C++FLAGS ;

        local _r = [ CheckBuildC++ "#include <iostream>"
                                   "int main() { std::cout << 42; return 0; }" ] ;
        if ! $(_r)
        {
            Exit "ERROR: configured C++ compiler does not work" ;
        }
    }
}


##############################################################################
# Build rules
##############################################################################

rule FDefines
{ return -D$(<) ; }


rule FIncludes
{ return -I$(<) ; }


rule Main-LinkSharedLibraries
{
    local _target = [ FAppendSuffix $(<) : $(SUFEXE) ] ;
    local _libs = $(PRELIB)$(>:S=$(SUFDLL)) ;

    if $(3)
    {
        LINKLIBS on $(_target) += $(LINKLIBS) -L$(3) -l$(2) ;
    }
    else
    {
        Depends $(_target) : $(PRELIB)$(>:S=$(SUFDLL)) ;
        SHLIBS on $(_target) += $(_libs) ;
        LINKSHLIBS on $(_target) += $(>:S=$(SUFDLL)) ;
    }
}


rule SharedLibrary-Build
{
    SharedLibraryFromObjects $(<) : $(>:GBS=$(SUFOBJ)) ; # FIX was only S
    Objects $(>) ;

    # Add library name decorations <lib><name><.so>
    local _target = $(PRELIB)$(<)$(SUFDLL) ;

    LINKFLAGS on $(_target) += $(LINKFLAGS) -qmkshrobj ;
}


rule SharedLibrary-LinkSharedLibraries
{
    local _target = $(PRELIB)$(<)$(SUFDLL) ;
    local _libs = $(PRELIB)$(>)$(SUFDLL) ;

    if $(3)
    {
        LINKLIBS on $(_target) += $(LINKLIBS) -L$(3) -l$(2) ;
    }
    else
    {
        Depends $(_target) : $(_libs) ;
        SHLIBS on $(_target) += $(_libs) ;
        LINKSHLIBS on $(_target) += $(>:S=$(SUFDLL)) ;
    }
}

##############################################################################
# Build actions
##############################################################################

actions Link bind NEEDLIBS SHLIBS LINKSHLIBS
{
    $(CC) $(LINKFLAGS) -L$(SHLIBS:P) $(WARN) -o $(<) $(UNDEFS) $(>) -bdynamic -l$(LINKSHLIBS:B) $(LINKLIBS) $(NEEDLIBS)
}

