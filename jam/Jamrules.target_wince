# For wince cross compiles we default to arm CPUs
#
JAVA_SYSTEM_INCLUDE = win32 ;

TARGET_OSPLAT ?= arm ;

SUFOBJ	= .obj ;
PRELIB	= "" ;
SUFLIB	= .lib ;
SUFEXE	= .exe ;
SUFDLL	= .dll ;

if $(CONFIG:L) = debug 
{
	SUFLIB	= d.lib ;
	SUFEXE	= d.exe ;
	SUFDLL	= d.dll ;
}

TOOLSET ?= vc8 ;
