if ! $(JAMRULES_PTUNIT) {
JAMRULES_PTUNIT = true ;


# Special targets
#
NOTFILE test ;
DEPENDS all-test : all test ;
NOTFILE all-test ;


# Build a unit test program
#
# Replaces the Main rule to build unit tests executables. The built target 
# becomes a dependency of the special target 'test'.
#
rule PtUnitTest
{

	local _target = $(1:S=$(SUFEXE)) ;

    DEPENDS test : $(_target) ;

	SetObjectOutput $(1) ;
	SetOutputDirectory $(1) : $(_target) : $(3) ;
	
	Objects $(2) : $(3) ;
    MainFromObjects $(<) : $(>:S=$(SUFOBJ)) : $(3) ;

	local _output = $(1:S=.unit) ;
	Depends $(_output) : $(_target) ;
	Clean clean : $(_output) ;

	#Depends $(1) : $(_output) ;
	#Depends all : $(1) ;
	#Main $(1) : $(2) : $(3) ;
	#Main_LinkLibraries $(1) : cppunit ;
	#MakeLocate $(1:S=.cppunit) : $(3) ;

	testExe on $(_target) = $(_target) ;
	PtUnitTestAction $(_target) : $(_output) ;
}


# Actions
#
if $(UNIX)
{

	actions PtUnitTestAction bind testExe
	{
		sh -c "export LD_LIBRARY_PATH=`pwd`/bin && $(testExe) -f$(1:S=.unit)"
	}

}
else
{

	actions PtUnitTestAction bind testExe
	{
		$(testExe) -f$(1:S=.unit)
	}

}

} # JAMRULES_CPPUNIT
