
if $(VISUALC) 
{
	VISUALC = $(VISUALC:J=" ") ;
}

# Add a compiler define
#
# The specified string will be added as a define compiler
# option, i.e. -D on gcc or /D on vc++
#
rule FDefines 
{ 
	return /D$(<) ; 
}


rule FIncludes 
{ 
	return /I$(<) ; 
}


# Set outputdirectory for binary files
#
# param 1 target name
# param 2 file name with suffix
# param 3 directory name
#
rule SetOutputDirectory
{	
	local _outputDir = $(LOCATE_TARGET) ;
	
	if $(3)
	{
		_outputDir = $(3) ;		
	}

	# SetProgramDataBase $(_outputDir) : $(2) ;
	
	# Tell jam where it can find the .pdb, .lib, .exp   
	MakeLocate $(2) : $(_outputDir) ;
	MakeLocate $(2:S=.lib) : $(_outputDir) ;
	MakeLocate $(2:S=.exp) : $(_outputDir) ;
	MakeLocate $(2:S=.pdb) : $(_outputDir) ;
	MakeLocate $(2:S=.ilk) : $(_outputDir) ;
	MakeLocate $(2).manifest : $(_outputDir) ;
	
	# clean rules only replace '.exe' suffic while 'd' for debug is kept
	Clean clean : $(2) ;
	Clean clean : $(2:S=.lib) ;
	Clean clean : $(2:S=.exp) ;	
	Clean clean : $(2:S=.pdb) ;
	Clean clean : $(2:S=.ilk) ;
	Clean clean : $(2).manifest ;
}


# Set the filename /-path for .pdb file
#
# param 1 output directory
# param 2 filename with suffix
#
rule SetProgramDataBase
{
	# set output for program data base
	PROGRAMDATABASE = [ FDirName $(1) $(2:S=.pdb) ] ;	
	
	LINKFLAGS on $(2) += /PDB:$(PROGRAMDATABASE) $(LINKFLAGS) ;
	
	DEPENDS obj : $(1) ;
	
}


# Links a shared library into another shared library
#
# param < the target name
# param > list of shared libraries
#
rule Main_LinkSharedLibraries
{
	LinkLibraries $(<) : $(>) ;
}


rule Main_MakeLocate
{
	local _target = $(<:S=$(SUFEXE)) ;
	MakeLocate $(_target) : $(>) ;
	
	MakeLocate $(_target:S=.lib) : $(>) ;
	MakeLocate $(_target:S=.exp) : $(>) ;
	MakeLocate $(_target:S=.pdb) : $(>) ;
	MakeLocate $(_target:S=.ilk) : $(>) ;
	MakeLocate $(_target:S=.exe.manifest) : $(LOCATE_TARGET) ;
}


# @brief builds a shared library from object files
rule SharedLibraryFromObjects
{
	# Add grist to file names
	local _sources = [ FGristObjectFiles $(>) ] ;

	# Add library name decorations <name><.dll/.so>
	local _target = $(PRELIB)$(<:S=$(SUFDLL)) ;

	# setup dependencies
	Depends exe : $(_target) ;
	Depends lib : $(_target) ;
	Depends $(_target) : $(_sources) ;
	Depends $(PRELIB)$(<:S=$(SUFLIB)) : $(_target) ;
	
	LINKFLAGS on $(_target) += /dll $(LINKFLAGS) ;
	Link $(_target) : $(_sources) ;
}


# Adds dependend shared libraries to a shared library
#
# @param < the target name
# @param > list of shared libraries
rule SharedLibrary_LinkSharedLibraries
{
	# Add library name decorations <name><.dll/.so>
	local _target = $(PRELIB)$(<:S=$(SUFDLL)) ;
		
	# make library dependency of target		
	Depends $(_target) : $(>:S=$(SUFLIB)) ;
	Depends $(_target) : $(>:S=$(SUFDLL)) ;
	
	# set NEEDLIBS variable used by 'Link'		
	NEEDLIBS on $(_target) += $(>:S=$(SUFLIB)) ;
}


rule SharedLibrary_MakeLocate
{
	local _target = $(PRELIB)$(<:S=$(SUFDLL)) ;

	
	MakeLocate $(_target) : $(>) ;
	MakeLocate $(_target:S=.lib) : $(>) ;
	MakeLocate $(_target:S=.exp) : $(>) ;
	MakeLocate $(_target:S=.pdb) : $(>) ;
	MakeLocate $(_target:S=.ilk) : $(>) ;
	
	SEARCH_SHLIB += $(>) ;
}


actions updated together piecemeal Archive
{
set PATH=$(VISUALC)\Common7/IDE;%PATH%

set _inputfile_=archive.cmd
echo "$(>)" > %_inputfile_%

if exist $(<) set _$(<:B)_=$(<)

"$(AR)" /NOLOGO /out:$(<) %_$(<:B)_% @%_inputfile_%

del %_inputfile_%
}

# set PATH=$(VISUALC)\Common7/IDE;%PATH%
# if exist $(<) set _$(<:B)_=$(<)
# "$(AR)" /out:$(<) %_$(<:B)_% $(>)


actions As
{
set PATH=$(VISUALC)\Common7/IDE;%PATH%
"$(AS)" /Ml /p /v /w2 $(>) $(<) ,nul,nul;
}


actions Cc
{
set PATH=$(VISUALC)\Common7/IDE;%PATH%
"$(CC)" /c $(CCFLAGS) $(OPTIM) /Fo$(<) /Fd$(PROGRAMDATABASE) /I$(HDRS) /I$(STDHDRS) $(>)
}


actions C++
{	
	set PATH=$(VISUALC)\Common7\IDE;%PATH%
	"$(C++)" /c $(C++FLAGS) $(OPTIM) /Fo$(<) /Fd$(PROGRAMDATABASE) /I$(HDRS) /I$(STDHDRS) /Tp $(>)
}

actions together Link bind NEEDLIBS
{
	set PATH=$(VISUALC)\Common7\IDE;%PATH%
	set LIB=$(VCDIR)\lib\;$(PLATFORMSDK)\lib\;%LIB%	
	"$(LINK)" $(LINKFLAGS) /out:$(<) $(UNDEFS) $(>) $(NEEDLIBS) $(LINKLIBS)
}


