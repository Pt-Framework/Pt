# Toolset commands
#
CC   = $(VISUALC)\\VC\\ce\\bin\\x86_arm\\cl /nologo ;
C++  = $(CC) ;
LINK = $(VISUALC)\\VC\\ce\\bin\\x86_arm\\link /nologo ;


# Flags and options
#
LINKFLAGS += /LIBPATH:"\"$(VISUALC)\\SmartDevices\\SDK\\PocketPC2003\\Lib\\armv4"\" ;
LINKFLAGS += /LIBPATH:"\"$(VISUALC)\\VC\\ce\\lib\\armv4"\" ;
LINKFLAGS += /ARMPADCODE ;
LINKFLAGS += /machine:ARM ;
C++FLAGS +=  /D ARM /D _ARM_ /QRarch4 ;
CCFLAGS  += -DARM -D_ARM_ -DQRarch4 ;

LINKLIBS += coredll.lib 
	    corelibc.lib
            ole32.lib
	    oleaut32.lib
	    uuid.lib
            commctrl.lib
            ccrtrtti.lib
            secchk.lib 
            comsuppwd.lib
            winsock.lib
            Ws2.lib
            mmtimer.lib
	    ;
 
# also possible:
# /QRarch4
# /QRarch5
# /QRarch4t
# /QRarch5t



