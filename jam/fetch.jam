if ! $(FETCH_JAM) {
FETCH_JAM = true ;

# fetch.jam
#
# Small toolbox for downloading and extracting files at jam parse
# time. Intended to be reusable across projects; contains no
# project-specific knowledge.
#
# Tools (curl + tar) are detected by Fetch-Configure, which must
# be called before any other Fetch-* rule. Both are present out
# of the box on modern Windows 10+, macOS and most Linux
# distributions. tar transparently handles .zip and .tar.*
# archives.
#
# Directory creation reuses the MKDIR variable configured by
# ConfigureMkDir in configure.jam.

# Fetch-Configure
#
# Detects curl and tar and stores their invocation in FETCH_CURL
# and FETCH_TAR respectively. Tools that are not found are left
# unset; Fetch-Url and Fetch-Unzip will abort if they are needed
# but not available. Repeated calls are no-ops.
#
rule Fetch-Configure
{
    if ! $(FETCH_CONFIGURED)
    {
        if ! $(FETCH_CURL) && [ TryCommand "curl --version" ]
        {
            FETCH_CURL = "curl" ;
        }

        Configure  FETCH_CURL : $(FETCH_CURL) ;
        EchoOption FETCH_CURL : "Download tool" ;

        if ! $(FETCH_TAR) 
            && [ TryCommand "C:\\Windows\\System32\\tar.exe --version" ]
        {
            FETCH_TAR = "C:\\Windows\\System32\\tar.exe" ;
        }

        if ! $(FETCH_TAR) && [ TryCommand "tar --version" ]
        {
            FETCH_TAR = "tar" ;
        }

        Configure  FETCH_TAR : $(FETCH_TAR) ;
        EchoOption FETCH_TAR : "Extract tool" ;

        FETCH_CONFIGURED = 1 ;
    }
}

# Fetch-MkDir <dir>
#
# Creates <dir>, including missing parents, using the MKDIR
# command configured by ConfigureMkDir. Skips creation if the
# directory already exists. The GLOB check may return stale
# results when directories are created by external commands
# (tar, curl) during the same Jam run; mkdir failures are
# therefore non-fatal.
#
rule Fetch-MkDir ( dir )
{
    if ! [ GLOB $(dir:P) : $(dir:BS) ]
    {
        TryCommand "$(MKDIR)" "\"$(dir)\"" ;
    }
}

# Fetch-Url <url> : <dest>
#
# Downloads <url> to <dest>, creating the parent directory if
# necessary. Aborts the build with Exit on failure.
#
rule Fetch-Url ( url : dest )
{
    if ! $(FETCH_CURL)
    {
        Exit "Error: curl is required to download" $(url) ;
    }

    Fetch-MkDir $(dest:D) ;

    local cmd = "$(FETCH_CURL) -fsSL -o \"$(dest)\" \"$(url)\"" ;

    if ! [ TryCommand $(cmd) ]
    {
        Exit "Error: download failed:" $(url) ;
    }
}

# Fetch-Unzip <archive> : <dest-dir>
#
# Extracts <archive> into <dest-dir>, creating it if necessary.
# tar transparently handles .zip and .tar.* archives. Aborts the
# build with Exit on failure.
#
rule Fetch-Unzip ( archive : dest )
{
    if ! $(FETCH_TAR)
    {
        Exit "Error: tar is required to extract" $(archive) ;
    }

    Fetch-MkDir $(dest) ;

    local cmd = "$(FETCH_TAR) -xf \"$(archive)\" -C \"$(dest)\"" ;

    if ! [ TryCommand $(cmd) ]
    {
        Exit "Error: extraction failed:" $(archive) ;
    }
}

# Fetch-Copy <src> : <dest>
#
# Copies <src> to <dest>, creating the parent directory if
# necessary. Aborts the build with Exit on failure.
#
rule Fetch-Copy ( src : dest )
{
    Fetch-MkDir $(dest:D) ;

    local cmd = "$(CP) \"$(src)\" \"$(dest)\"" ;

    if ! [ TryCommand $(cmd) ]
    {
        Exit "Error: copy failed:" $(src) ;
    }
}

# Fetch-Compare <base-url> : <local-dir> : <file-name>
#
# Compares a remote version file against a local copy.
# Downloads <base-url>/<file-name> into a temporary location
# (.downloads) and includes it. The file must set DEPS_VERSION.
# If <local-dir>/<file-name> exists, it is included first to
# obtain the current version.
#
# Returns the new DEPS_VERSION when it differs from the current
# version, or empty if both match (i.e. content is up to date).
#
rule Fetch-Compare ( baseUrl : localDir : fileName )
{
    local localFile = [ FDirName $(localDir) $(fileName) ] ;
    local downloads = [ FDirName $(localDir) .downloads ] ;
    local fetchFile = [ FDirName $(downloads) $(fileName) ] ;

    DEPS_VERSION = ;

    if [ CHECK_IF_FILE $(localFile) ]
    {
        include $(localFile) ;
    }

    local currentVersion = $(DEPS_VERSION) ;
    DEPS_VERSION = ;

    Fetch-Url "$(baseUrl)/$(fileName)" : $(fetchFile) ;
    include $(fetchFile) ;

    if ! $(DEPS_VERSION)
    {
        Exit "Error: $(fetchFile) did not define DEPS_VERSION." ;
    }

    if $(DEPS_VERSION) != $(currentVersion)
    {
        return $(DEPS_VERSION) ;
    }
}

} # FETCH_JAM
