#
# Platform subsettings
#
if $(TARGET_OS:L) = nt
{
    SYS ?= win32 ;
    GUI ?= gdi ;
}
if $(TARGET_OS:L) = linux
{
    SYS ?= posix ;
    GUI ?= x11 ;
}
if $(TARGET_OS:L) = macosx
{
    SYS ?= posix ;
    GUI ?= none ;
}
if $(TARGET_OS) = aix
{
    SYS ?= posix ;
    GUI ?= x11 ;
}
if $(TARGET_OS:L) = qnxnto
{
    SYS ?= posix ;
    GUI ?= photon ;
}
if $(TARGET_OS:L) = wince
{
    SYS ?= wince ;
    GUI ?= gdi ;
}

#
# System libraries and includes
#
if $(SYS:L) = "win32"
{
    SYSLIBS = version.lib Winmm.lib Psapi.lib ;
    NETLIBS = wsock32.lib ws2_32.lib ;

    if $(MINGW)
    {
        SYSLIBS = $(MINGW)$(SLASH)lib$(SLASH)libversion.a
                $(MINGW)$(SLASH)lib$(SLASH)libwinmm.a
                $(MINGW)$(SLASH)lib$(SLASH)libpsapi.a ;
        NETLIBS = $(MINGW)$(SLASH)lib$(SLASH)libwsock32.a
                $(MINGW)$(SLASH)lib$(SLASH)libws2_32.a ;
    }
}

if $(TARGET_OS:L) = linux
{
    SYSLIBS = -ldl -lpthread -lrt ;
    NETLIBS = -lnsl ;
}

if $(TARGET_OS:L) = macosx
{
    SYSLIBS = -ldl -lpthread -lrt ;
    NETLIBS = -lnsl ;
}

if $(TARGET_OS) = aix
{
    SYSLIBS = -bdynamic -ldl -lpthread -lrt ;
    LINKLIBS += $(SYSLIBS) ;
    # NETLIBS =
}

if $(TARGET_OS:L) = qnxnto
{
    SYSLIBS     =  ;
    NETLIBS     = -lsocket ;
}

if $(SYS:L) = wince
{
    SYSLIBS = mmtimer.lib ;
    NETLIBS = winsock.lib Ws2.lib ;
}

#
# Gui libraries and includes
#
if $(GUI:L) = "gdi"
    {
    if $(TARGET_OS:L) = "nt"
    {
        GUILIBS = gdi32.lib user32.lib ;
    }
    if $(MINGW)
    {
        GUILIBS = $(MINGW)$(SLASH)lib$(SLASH)libgdi32.a
                $(MINGW)$(SLASH)lib$(SLASH)libuser32.a  ;
    }
}

if $(GUI:L) = "x11"
{
    #
    # Check if X11 library
    #
    local _libX11 = [ GLOB  /usr/lib : *X11.* ] ;

    if $(_libX11) = ""
    {
        _libX11 = [ GLOB  /usr/X11R6/lib : *X11.* ] ;
    }
    if $(_libX11) = ""
    {
        _libX11 = [ GLOB  /opt/X11R6/lib : *X11.* ] ;
    }
    if $(_libX11) = ""
    {
        Echo "Checking for X11 library... FAILED" ;
    }
    else
    {
        Echo "Checking for X11 library... " $(_libX11) ;
        GUILIBS += -L$(_libX11:P) -lX11 -lXext ;
    }

    #
    # Check if Xft includes are installed
    #
    local _xftIncludes = [ GLOB  /usr/include/X11 : Xft ] ;
    if $(_xftIncludes) = ""
    {
        _xftIncludes = [ GLOB  /opt/X11R6/include/X11 : Xft ] ;
    }
    if $(_xftIncludes) = ""
    {
        Echo "Checking for Xft includes... FAILED" ;
    }
    else
    {
        Echo "Checking for Xft includes... $(_xftIncludes)" ;
        GUILIBS += -lXft -lXrender ;
    }
}

if $(GUI:L) = "gf"
{
    if $(CONFIG:L) = "release"
    {
        GUILIBS = -L/usr/lib -lgfS ;
    }
    else
    {
        GUILIBS = -L/usr/lib -lgfS_g ;
    }
}


if $(GUI:L) = "photon"
{
    GUILIBS = -lphrender -lph ;
}


# Must search X11 includes in these locations (sorted by priority) :
# /usr/X11R7/include/X11
# /usr/X11R6/include/X11
# /usr/include/X11
# /usr/X11R6/include
# /usr/X11R7/include
# /usr/include
#
# /usr/local/X11R6/include/X11
