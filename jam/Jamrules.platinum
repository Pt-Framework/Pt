if $(TARGET_OS:L) = nt
{
	SYS	?= win32 ;
	GUI	?= gdi ;
}
if $(TARGET_OS:L) = linux
{
	SYS     ?= posix ;
	GUI     ?= x11 ;

}
if $(TARGET_OS) = aix
{
        SYS     ?= posix ;
        GUI     ?= x11 ;
}
if $(TARGET_OS:L) = qnxnto
{
	SYS ?= posix ;
	GUI ?= gf ;
}
if $(TARGET_OS:L) = wince
{
	SYS ?= wince ;
	GUI ?= gdi ;
}


if $(SYS:L) = "win32"
{
	SYSLIBS = version.lib Winmm.lib Psapi.lib ;
	NETLIBS = wsock32.lib ws2_32.lib ;

	if $(MINGW)
	{
		SYSLIBS = $(MINGW)\\lib\\libversion.a
		          $(MINGW)\\lib\\libwinmm.a
		          $(MINGW)\\lib\\libpsapi.a ;
		NETLIBS = $(MINGW)\\lib\\libwsock32.a 
		          $(MINGW)\\lib\\libws2_32.a ;
	}
}

if $(TARGET_OS:L) = linux
{
	SYSLIBS     = -ldl -lpthread -lrt ;
    NETLIBS     = -lnsl ;
}

if $(TARGET_OS) = aix
{
    SYSLIBS = -bdynamic -ldl -lpthread -lrt ;
    LINKLIBS += $(SYSLIBS) ;
    # NETLIBS = 
}

if $(TARGET_OS:L) = qnxnto
{
    SYSLIBS     =  ;
    NETLIBS     = -lsocket ;
}

if $(SYS:L) = wince
{
	SYSLIBS = mmtimer.lib ;
	NETLIBS = winsock.lib Ws2.lib ;
}

if $(GUI:L) = "gdi"
{
	if $(TARGET_OS:L) = "nt"
	{
		GUILIBS = gdi32.lib user32.lib ;
	}
	if $(MINGW)
	{
		GUILIBS = $(MINGW)\\lib\\libgdi32.a 
              $(MINGW)\\lib\\libuser32.a  ;
	}
}
if $(GUI:L) = "x11"
{
	# Must search X11 includes in these locations (sorted by priority) :
	# /usr/X11R7/include/X11
	# /usr/X11R6/include/X11
	# /usr/include/X11
	# /usr/X11R6/include
	# /usr/X11R7/include
	# /usr/include
	#
	# /usr/local/X11R6/include/X11
	# /usr/local/X11R7/include/X11
	# /usr/local/include/X11
	# /usr/local/X11R6/include
	# /usr/local/X11R7/include
	# /usr/local/include
	#
	# /opt/X11R6/include/X11
	# /opt/X11R7/include/X11
	# /opt/include/X11
	# /opt/X11R6/include
	# /opt/X11R7/include
	# /opt/include
	#

	# Must search X11 libraries in these locations (sorted by priority) :
	# /usr/X11R6/lib64/X11
	# /usr/X11R6/lib32/X11
	# /usr/X11R6/lib/X11
	# /usr/X11R7/lib64/X11
	# /usr/X11R7/lib32/X11
	# /usr/X11R7/lib/X11
	# /usr/lib64/X11
	# /usr/lib32/X11
	# /usr/lib/X11
	# /usr/X11R6/lib64
	# /usr/X11R6/lib32
	# /usr/X11R6/lib
	# /usr/X11R7/lib64
	# /usr/X11R7/lib32
	# /usr/X11R7/lib
	# /usr/lib64
	# /usr/lib32
	# /usr/lib
	#
	# /usr/local/X11R6/lib64/X11
	# /usr/local/X11R6/lib32/X11
	# /usr/local/X11R6/lib/X11
	# /usr/local/X11R7/lib64/X11
	# /usr/local/X11R7/lib32/X11
	# /usr/local/X11R7/lib/X11
	# /usr/local/lib64/X11
	# /usr/local/lib32/X11
	# /usr/local/lib/X11
	# /usr/local/X11R6/lib64
	# /usr/local/X11R6/lib32
	# /usr/local/X11R6/lib
	# /usr/local/X11R7/lib64
	# /usr/local/X11R7/lib32
	# /usr/local/X11R7/lib
	# /usr/local/lib64
	# /usr/local/lib32
	# /usr/local/lib
	#
	# /opt/X11R6/lib64/X11
	# /opt/X11R6/lib32/X11
	# /opt/X11R6/lib/X11
	# /opt/X11R7/lib64/X11
	# /opt/X11R7/lib32/X11
	# /opt/X11R7/lib/X11
	# /opt/lib64/X11
	# /opt/lib32/X11
	# /opt/lib/X11
	# /opt/X11R6/lib64
	# /opt/X11R6/lib32
	# /opt/X11R6/lib
	# /opt/X11R7/lib64
	# /opt/X11R7/lib32
	# /opt/X11R7/lib
	# /opt/lib64
	# /opt/lib32
	# /opt/lib
	#

	#
	# Check if Xft includes are installed
	#
	local _xftIncludes = [ GLOB  /usr/include/X11 : Xft ] ;
    if  $(_xftIncludes) = ""
    {
            _xftIncludes = [ GLOB  /opt/X11R6/include/X11 : Xft ] ;
    }
	if  $(_xftIncludes) = ""
	{
        Echo "Checking for Xft includes... FAILED" ;
	}
	else
	{
		Echo "Checking for Xft includes... $(_xftIncludes)" ;
	}

	#
	# Check if Xmu library is installed
	#
	local _libXmu = [ GLOB  /usr/lib : *Xmu.so ] ;
	if  $(_libXmu) = ""
	{
		_libXmu = [ GLOB  /usr/X11R6/lib : *Xmu.so ] ;
	}
    if  $(_libXmu) = ""
    {
            _libXmu = [ GLOB  /opt/X11R6/lib : *Xmu.so ] ;
    }
	if  $(_libXmu) = ""
	{
        Echo "Checking for Xmu library... FAILED" ;
	}
	else
	{
		Echo "Checking for Xmu library... " $(_libXmu) ;
	}

	GUILIBS  = -L/usr/X11R6/lib -L/opt/X11R6/lib -lX11 -lXext -lXmu -lXft -lXrender ;
}
if $(GUI:L) = "gf"
{
    if $(CONFIG:L) = "release"
    {
	    GUILIBS = -L/usr/lib -lgfS ;
    }
    else
    {
        GUILIBS = -L/usr/lib -lgfS_g ;
    }
        
}

