if ! $(PLATFORM_JAM_INCLUDED) {
PLATFORM_JAM_INCLUDED = true ;

Load fetch.jam ;

# Identity: <os>-<arch>-<toolset>[-<abi>]. Windows always has md/mdd.
# ABI auto-map is WITH_DEBUG && ! WITH_OPTIM -> mdd, else md.
#
rule Platform-Tuple ( abi ? )
{
    local os = $(TARGET_OS:L) ;
    switch $(os)
    {
        case nt     : os = windows ;
        case win32  : os = windows ;
        case macosx : os = macos ;
    }

    local arch = $(TARGET_OSPLAT:L) ;
    switch $(arch)
    {
        case x86_64  : arch = x64 ;
        case amd64   : arch = x64 ;
        case aarch64 : arch = arm64 ;
    }

    local toolset = $(TOOLSET:L) ;
    switch $(toolset)
    {
        case vc* : toolset = msvc ;
    }

    local id = $(os)-$(arch)-$(toolset) ;
    if $(abi)
    {
        id = $(id)-$(abi) ;
    }

    return $(id) ;
}

# Platform-Fetch <url> : <dest>
#
# Download <url> when <url>.manifest changed. dest is the
# prefix directory. The sidecar is dest.manifest, next to dest,
# not inside it. Returns dest when fetched, empty when up to
# date. Caller must Fetch-Configure first.
#
rule Platform-Fetch ( url : dest )
{
    Fetch-Configure ;

    local manifestLocal = [ FDirName $(dest) manifest ] ;
    local manifestTmp   = $(dest).manifest.tmp ;
    local archiveTmp    = $(dest).tmp ;
    local fetched       = ;

    Fetch-Url "$(url).manifest" : $(manifestTmp) ;
    local remoteContent = [ FILE_GET_CONTENTS $(manifestTmp) ] ;

    local localContent = ;
    if [ CHECK_IF_FILE $(manifestLocal) ]
    {
        localContent = [ FILE_GET_CONTENTS $(manifestLocal) ] ;
    }

    if $(remoteContent) != $(localContent)
    {
        Fetch-Url $(url) : $(archiveTmp) ;
        Fetch-RmDir $(dest) ;
        Fetch-Unzip $(archiveTmp) : $(dest) ;
        FILE_RENAME $(manifestTmp) : $(manifestLocal) ;
        fetched = $(dest) ;
    }

    FILE_REMOVE $(manifestTmp) ;
    FILE_REMOVE $(archiveTmp) ;

    return $(fetched) ;
}

# Platform-Import <root>
#
# Sets PLATFORM_ROOT, includes <root>/jam/packages.jam, and checks
# PLATFORM_SCHEMA (must be 1).
#
rule Platform-Import ( root )
{
    PLATFORM_ROOT = $(root) ;

    local jamfile = [ FDirName $(PLATFORM_ROOT) jam packages.jam ] ;

    if ! [ CHECK_IF_FILE $(jamfile) ]
    {
        Exit "Error: platform packages.jam not found:" $(jamfile) ;
    }
    else
    {
        include $(jamfile) ;

        if $(PLATFORM_SCHEMA) != 1
        {
            Exit "Error: unsupported PLATFORM_SCHEMA:" $(PLATFORM_SCHEMA) ;
        }
    }
}

# Platform-Depends <packages>
#
# Unique walk of PLATFORM_PACKAGE_DEPENDS. Named packages first, deps
# last. Small-N list membership; not a solver.
#
rule Platform-Depends ( packages + )
{
    local result ;
    local pending = $(packages) ;

    while $(pending)
    {
        local pkg = $(pending[1]) ;
        pending = $(pending[2-]) ;

        if ! $(pkg) in $(result)
        {
            result += $(pkg) ;
            pending += $(PLATFORM_PACKAGE_DEPENDS.$(pkg)) ;
        }
    }

    return $(result) ;
}

# Platform-Includes <packages>
#
# Include dirs of the compile closure. PLATFORM_PACKAGE_INCLUDES.$(pkg)
# is prefix-relative (may contain /) when the default $(pkg)/include
# is not enough; otherwise $(root)/$(pkg)/include.
#
rule Platform-Includes ( packages + )
{
    local result ;
    local pkgs = [ Platform-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        if $(PLATFORM_PACKAGE_INCLUDES.$(pkg))
        {
            for local inc in $(PLATFORM_PACKAGE_INCLUDES.$(pkg))
            {
                local parts = [ SPLIT_BY_CHARACTERS $(inc) : "/" ] ;
                result += [ FDirName $(PLATFORM_ROOT) $(parts) ] ;
            }
        }
        else
        {
            result += [ FDirName $(PLATFORM_ROOT) $(pkg) include ] ;
        }
    }

    return $(result) ;
}

# Platform-CxxFlags <packages>
#
# [ FDefines ... ] for the named packages only.
#
rule Platform-CxxFlags ( packages + )
{
    local result ;

    for local pkg in $(packages)
    {
        if $(PLATFORM_PACKAGE_DEFINES.$(pkg))
        {
            result += [ FDefines $(PLATFORM_PACKAGE_DEFINES.$(pkg)) ] ;
        }
    }

    return $(result) ;
}

# Platform-LinkLibs <packages>
#
# Shared: PLATFORM_PACKAGE_LIBS + PLATFORM_PACKAGE_SYSLIBS of the named
# packages. Static: same after Platform-Depends. Named first, deps last.
# Frameworks appended as -framework <name> when present.
#
rule Platform-LinkLibs ( packages + )
{
    local result ;
    local pkgs = $(packages) ;

    if $(PLATFORM_LINKAGE) = static
    {
        pkgs = [ Platform-Depends $(packages) ] ;
    }

    for local pkg in $(pkgs)
    {
        result += [ FLinkLibs $(PLATFORM_PACKAGE_LIBS.$(pkg))
                              $(PLATFORM_PACKAGE_SYSLIBS.$(pkg)) ] ;

        for local fw in $(PLATFORM_PACKAGE_FRAMEWORKS.$(pkg))
        {
            result += -framework $(fw) ;
        }
    }

    return $(result) ;
}

# Platform-LibDir <packages>
#
# $(root)/$(pkg)/lib. Shared: named packages. Static: closure (the link
# probe must see dependent archives).
#
rule Platform-LibDir ( packages + )
{
    local result ;
    local pkgs = $(packages) ;

    if $(PLATFORM_LINKAGE) = static
    {
        pkgs = [ Platform-Depends $(packages) ] ;
    }

    for local pkg in $(pkgs)
    {
        local dir = [ FDirName $(PLATFORM_ROOT) $(pkg) lib ] ;

        if ! $(dir) in $(result)
        {
            result += $(dir) ;
        }
    }

    return $(result) ;
}

# Platform-LinkFlags <packages>
#
# Extra flags only. Never FLibPath: CheckDependencyLinkC++ already adds
# it from LIBDIR.
#
rule Platform-LinkFlags ( packages + )
{
    local result ;
    return $(result) ;
}

# Platform-Deploy <packages>
#
# $(root)/$(pkg)/bin/$(PLATFORM_PACKAGE_DEPLOY.$(pkg)) plus deploy
# closure over PLATFORM_PACKAGE_DEPENDS.
#
rule Platform-Deploy ( packages + )
{
    local result ;
    local pkgs = [ Platform-Depends $(packages) ] ;

    for local pkg in $(pkgs)
    {
        for local f in $(PLATFORM_PACKAGE_DEPLOY.$(pkg))
        {
            local path = [ FDirName $(PLATFORM_ROOT) $(pkg) bin $(f) ] ;

            if ! $(path) in $(result)
            {
                result += $(path) ;
            }
        }
    }

    return $(result) ;
}

} # PLATFORM_JAM_INCLUDED
