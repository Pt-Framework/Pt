#	MakeLocate $(_target:S=.lib) : $(LOCATE_TARGET) ;
#	MakeLocate $(_target:S=.exp) : $(LOCATE_TARGET) ;
#	MakeLocate $(_target:S=.pdb) : $(LOCATE_TARGET) ;
