# Include target specific options
#
JamInclude Jamrules.vc8.wince.$(TARGET_OSPLAT:L) ;


# Flags and options
#
CCFLAGS += /D "_WIN32_WCE=0x420" /D "WINCE" /D "UNDER_CE" /D "WIN32_PLATFORM_PSPC" ;
CCFLAGS += /D "_CONSOLE" /D "_UNICODE" /D "UNICODE" /W3 ;

LINKFLAGS += /MANIFEST:NO /NODEFAULTLIB:"oldnames.lib" ;
LINKFLAGS += /subsystem:windowsce,4.20 /ERRORREPORT:PROMPT ;

if $(CONFIG:L) = debug 
{
	CCFLAGS += /Os /Od /Zi /D "DEBUG" /D "_DEBUG" /MDd ;
	LINKFLAGS += /DEBUG ;
}
else
{
	#C++FLAGS += /MD /O1 /Oy /D "NDEBUG" ;
	CCFLAGS += /MD /O1 /Oy /D "NDEBUG" ;
}

C++FLAGS  +=  $(CCFLAGS) ;
C++FLAGS  +=  /EHsc /fp:fast /GR /TP ;


# set MFC directory
#
MFCDIR = \"$(VISUALC)\\vc\\ce\\atlmfc\" ;


STDHDRS = \"$(VISUALC)\\vc\\ce\\include\" 
	  \"$(VISUALC)\\smartdevices\\sdk\\pocketpc2003\\include\" ;


# TODO: entry flags might go to global linkflags
rule Main
{
	local _target = $(1:S=$(SUFEXE)) ;
	LINKFLAGS on $(_target) += $(LINKFLAGS) /ENTRY:"mainWCRTStartup" ;
	
	Clean clean : $(_target) ;
	Clean clean : $(_target:S=.lib) ;
	Clean clean : $(_target:S=.exp) ;	
	Clean clean : $(_target:S=.pdb) ;
	Clean clean : $(_target:S=.ilk) ;
	Clean clean : $(_target:S=.idb) ;
	Clean clean : $(_target:S=.exe.manifest) ;
	
	MainFromObjects $(<) : $(>:S=$(SUFOBJ)) ;
	Objects $(2) : $(1) ;   
}


actions win32-Link bind NEEDLIBS RESPONSEFILE
{
	set PATH=$(VISUALC)\Common7\IDE;%PATH%
	"$(LINK)" $(LINKFLAGS) /out:$(<) $(UNDEFS) @$(RESPONSEFILE) $(NEEDLIBS) $(LINKLIBS)
}
