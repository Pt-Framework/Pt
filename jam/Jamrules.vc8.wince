# Include target specific options
#
JamInclude Jamrules.vc8.wince.$(TARGET_OSPLAT:L) ;


# Flags and options
#
CCFLAGS += /D "_WIN32_WCE=0x420" /D "WINCE" /D "UNDER_CE" /D "WIN32_PLATFORM_PSPC" ;
CCFLAGS += /D "_CONSOLE" /D "_UNICODE" /D "UNICODE" /W3 ;

LINKFLAGS     += /MANIFEST:NO /NODEFAULTLIB:"oldnames.lib" ;
LINKFLAGS     += /subsystem:windowsce,4.20 /ERRORREPORT:PROMPT ;
MAINLINKFLAGS += /ENTRY:"mainWCRTStartup" ;


if $(CONFIG:L) = debug 
{
	CCFLAGS   +=  /Zi /D "DEBUG" /D "_DEBUG" /MDd ;
	OPTIM     ?=  /Os /Od ;
	LINKFLAGS += /DEBUG ;
}
else
{
	CCFLAGS += /MD /D "NDEBUG" ;
	OPTIM   ?=  /O1 /Oy ;
}

WARN      ?= /W3 ;
C++FLAGS  +=  $(CCFLAGS) ;
C++FLAGS  +=  /EHsc /fp:fast /GR /TP ;


STDHDRS = \"$(VISUALC)\\vc\\ce\\include\" 
          \"$(VISUALC)\\smartdevices\\sdk\\pocketpc2003\\include\" ;


###################################################################################################
# Die hier folgende Implementierung der Rule Link ist ein Workaround, um die Zeilenlängen-
# beschränkung der Shell unter Windows für den VC Linker zu umgehen. Dazu wird ein Response-File
# mit den zu linkenden Object-Files angelegt, der dann dem Linker übergeben wird.
# Problematisch ist diese Rule, wenn JAM mit dem Parameter -r aufgerufen wird (z.B. im Autobuild)
# Dann verursacht das von JAM genutzte Pipen der Logausgabe mittels >> in Kombination mit dem Pipen
# in den Responsefile einen Konflikt
###################################################################################################
