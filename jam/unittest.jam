
if ! $(PT_UNIT_JAM) {
PT_UNIT_JAM = true ;

#############################################################################
# Unit testing rules and actions
#############################################################################
# Special targets
#
NOTFILE test ;
DEPENDS test : files ;
DEPENDS all-test : all test ;
NOTFILE all-test ;


# Build a unit test program
#
# Replaces the Main rule to build unit tests executables. The built target 
# becomes a dependency of the special target 'test'.
#
rule PtUnitTest
{
  Main $(<) : $(>) ;
  $(<)_type = "PtUnitTest" ;

  local _target = $(<:S=$(SUFEXE)) ;
  local _output = $(<:S=.unit) ;

  Depends $(_output) : $(_target) ;
  Depends test : $(_output) ;

  Clean clean : $(_output) ;
  MakeLocate $(_output) : $(LOCATE_TARGET) ;

  PtUnitTestAction $(_output) : $(_target) ;
}


rule RunUnitTest
{
  local _target = $(<:S=$(SUFEXE)) ;
  local _output = $(<:S=.unit) ;
  local _resultdir = $(>) ;

  MakeLocate $(_output) : $(_resultdir) ;

  Depends $(_output) : $(_target) ;
  Depends test : $(_output) ;

  Clean clean : $(_output) ;
  MakeLocate $(_output) : $(>) ;

  PtUnitTestAction2 $(_output) : $(_target) ;
}


rule PtUnitTest-MakeLocate
{
  local _output = $(<:S=.unit) ;

  Main-MakeLocate $(<) : $(>) ;
  MakeLocate $(_output) : $(>) ;
}


rule PtUnitTest-LinkLibs
{
  Main-LinkLibs $(<) : $(>) : $(3) : $(4) ;
}

rule PtUnitTest-LinkFlags
{
  Main-LinkFlags $(<) : $(>) : $(3) : $(4) ;
}


rule PtUnitTest-LinkLibraries
{
  Main-LinkLibraries $(<) : $(>) : $(3) : $(4) ;
}


rule PtUnitTest-LinkLibraries
{
  Main-LinkLibraries $(<) : $(>) : $(3) : $(4) ;
}


rule PtUnitTest-LinkSharedLibraries
{
  Main-LinkSharedLibraries $(<) : $(>) : $(3) : $(4) ;
}


if $(UNIX)
{
  # $(<) : <path_to_test>/test.unit
  # $(>) : <path_to_test>/testd.exe
  actions PtUnitTestAction
  {
    cd $(>:D)
    sh -c "LD_LIBRARY_PATH=$LD_LIBRARY_PATH:. DYLD_LIBRARY_PATH=$DYLD_LIBRARY_PATH:. ./$(>:BS) -f $(<:BS)"
  }

  actions PtUnitTestAction2
  {
    sh -c "LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(>:D) DYLD_LIBRARY_PATH=$DYLD_LIBRARY_PATH:$(>:D) ./$(>) -f $(<)"
  }

}
else if $(TARGET_OS:L) = "wince"
{

  actions PtUnitTestAction
  {
      ce del \$(<:BS).failed > nul
      ce copy $(>) \$(>:BS)

      rem start will return after process has started
      ce start "\$(>:BS)" -f \$(<:BS)

      :Loop
        ping 127.0.0.1 -n 5 -w 1000 > nul
        ce tlist | findstr "$(>:BS)" > nul
        IF %ERRORLEVEL% EQU 0 GOTO Loop

      ce get \$(<:BS).failed $(<).failed > nul

      SET TEST_FAILED=0
      IF EXIST $(<).failed (
        SET TEST_FAILED=1
        ce get \$(<:BS) $(<).failed
        ce del \$(<:BS).failed
      ) ELSE (
        ce get \$(<:BS) $(<)
        IF EXIST $(<) (
          SET TEST_FAILED=0
        ) ELSE (
          SET TEST_FAILED=1
        )
      )
      ce del \$(<:BS)
      ce del \$(>:BS)

      rem taskkill /F /IM DeviceEmulator.exe
      rem IF EXIST $(<).failed $(RM) $(<).failed

      EXIT %TEST_FAILED%
  }

}
else
{

  actions PtUnitTestAction
  {
    cd $(>:D)
    $(>:BS) -f $(<:BS)
  }

  actions PtUnitTestAction2
  {
    $(>) -f $(<)
  }

}

} # PT_UNIT_JAM