# Do not allow OSPLAT other than x86 for NT
#
if $(TARGET_OSPLAT:L) != x86
{
	Exit "This target-platform is not supported on this toolset" ;
}


CC = $(VISUALC)\\vc\\bin\\cl /nologo ;

LINKLIBS += \"$(VISUALC)\\vc\\PlatformSDK\\lib\\advapi32.lib\"
	    \"$(VISUALC)\\vc\\PlatformSDK\\lib\\gdi32.lib\"
	    \"$(VISUALC)\\vc\\PlatformSDK\\lib\\user32.lib\"
	    \"$(VISUALC)\\vc\\PlatformSDK\\lib\\kernel32.lib\" ;
C++FLAGS += /EHsc /GR /FD /W3 /DWIN32 ;


if $(CONFIG:L) = debug 
{
	C++FLAGS += /ZI /MDd /Od /RTC1 ;
	LINKFLAGS += /DEBUG ;

	CCFLAGS += /MDd /Zi ;
}
else
{
	C++FLAGS += /MD ;
}


# set directories to standard header 
#
STDHDRS = \"$(VISUALC)\\vc\\include\" 
	  \"$(VISUALC)\\vc\\PlatformSDK\\include\" ;


# set directory to mfc for this toolset
#
MFCDIR = \"$(VISUALC)\\vc\\atlmfc\" ;
	

