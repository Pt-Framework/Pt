# Do not allow OSPLAT other than x86 for NT
#
if $(TARGET_OSPLAT:L) != x86
{
    Exit "This target-platform is not supported on this toolset" ;
}

LINKFLAGS += /LIBPATH:"\"$(PLATFORMSDK)\\lib"\" ;

CCFLAGS += /DWIN32 ;

if $(CONFIG:L) = debug 
{
    CCFLAGS   += /MDd /Zi /RTC1 ;
    OPTIM     ?= /Od ;
    LINKFLAGS += /DEBUG ;
}
else if $(CONFIG:L) = release 
{
    CCFLAGS += /MD /D "NDEBUG" ;
    OPTIM   ?= /Ox /Ot /Oy ;
}
else if $(CONFIG:L) = aqtime
{
    CCFLAGS += /MD /Zi /D "NDEBUG" ;
    OPTIM   ?= /Ox /Ot /Oy ;
    LINKFLAGS += /DEBUG ;
}

WARN     ?= /W3 ;
C++FLAGS += $(CCFLAGS) /EHsc /GR /FD ;


# set directories to standard header 
#
STDHDRS = \"$(VISUALC)\\vc\\include\" 
          \"$(PLATFORMSDK)\\include\" ;

