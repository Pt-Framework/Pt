##########################################################################
# Jam Environment
#
# TODO:
# http://www.boost.org/boost-build2/doc/html/jam/language.html
#
##########################################################################

JAMDIR ?= jam ;

rule Load
{
    local _inc = $(<[1]) ;
    
    for local _i in $(<[2-])
    {
        _inc = $(_i:R=$(_inc)) ;
    }
    
    _inc = $(_inc:R=$(JAMDIR)) ;
    include $(_inc) ;
}

Load base.jam ;

##########################################################################
# Configure Step
##########################################################################

if configure in $(ARGV)
{
    Load configure.jam ;

    EchoOption JAMBASE : "Using Jambase" : $(JAMBASE) ;
    EchoOption OS : "Build Host OS" : $(OS:L) ;
    EchoOption OSPLAT : "Host Platform" ;

    if --debug in $(ARGV)
    {
        WITH_DEBUG = yes ;
    }

    if --optimize in $(ARGV)
    {
        WITH_OPTIM = yes ;
    }

    EchoOption --debug : "Debug Build" : $(WITH_DEBUG:E="no") ;
    EchoOption --optimize OPTIM : "Optimized Build" : $(WITH_OPTIM:E="no") ;

    ConfigureClean ;

	if [ CHECK_IF_FILE Jamrules.$(CONFIG) ] # TODO: check timestamp against Jamconfigure
	{
		include Jamrules.$(CONFIG) ;
		TryCommand $(CP) Jamrules.$(CONFIG) Jamrules ;
		Echo "Using " Jamrules.$(CONFIG) ;
		Exit ;
	}

    ConfigureLog "[ Configure ]" ;
    ConfigureRm ;
    ConfigureMv ;
    ConfigureCp ;
    ConfigureMkDir ;
    ConfigureChMod ;
    ConfigureLn ;
    ConfigureDotSlash ;
    ConfigureTarget ;
    ConfigureToolset ;

    # Project specific configuration
    ConfigureLog "\n[ Jamconfigure ]" ;
    include Jamconfigure ;

    ConfigureExit ;
}

if ! [ CHECK_IF_FILE Jamrules ]
{
    Exit "Build not configured. Run jam configure first." ;
}

##########################################################################
# Build Step
##########################################################################

Load build.jam ;

# Project root Jamfile
include Jamfile ;
