##########################################################################
# Jam Environment
#
# TODO:
# http://www.boost.org/boost-build2/doc/html/jam/language.html
#
##########################################################################

JAMDIR ?= jam ;

rule Load
{
    local _s = $(<:R=$(JAMDIR)) ;
    include $(_s) ;
}

Load base.jam ;

##########################################################################
# Configure Step
##########################################################################

if configure in $(ARGV)
{
    Load configure.jam ;

    EchoOption JAMBASE : "Using Jambase" : $(JAMBASE) ;
    EchoOption OS : "Build Host OS" : $(OS:L) ;
    EchoOption OSPLAT : "Host Platform" ;

    if --debug in $(ARGV)
    {
        WITH_DEBUG = yes ;
    }

    EchoOption --debug : "Debug Build" : $(WITH_DEBUG:E="no") ;

    TryCommand "rm -f config.jam" ;
    TryCommand "del /f/q config.jam" ;

    TryCommand "rm -f config.log" ;
    TryCommand "del /f/q config.log" ;

    ConfigureLog "[ Configure ]" ;
    ConfigureRm ;
    ConfigureMv ;
    ConfigureCp ;
    ConfigureMkDir ;
    ConfigureChMod ;
    ConfigureLn ;
    ConfigureDotSlash ;
    ConfigureTarget ;
    ConfigureToolset ;

    # Project specific configuration
    ConfigureLog "\n[ Jamconfigure ]" ;
    include Jamconfigure ;

    # move this to toolset.jam
    EchoOption OPTIM : "Optimisation" ;
    EchoOption WARN : "Warning Level" ;
    EchoOption CCFLAGS : "C Flags" ;
    EchoOption C++FLAGS : "C++ Flags" ;
    EchoOption LINKFLAGS : "Linker Flags" ;

    ConfigureExit ;
}

if ! [ CHECK_IF_FILE config.jam ]
{
    Exit "Build not configured. Run jam configure first." ;
}

include config.jam ;

##########################################################################
# Build Step
##########################################################################

# Toolset specific variables and rules
Load $(TOOLSET:L).jam ;

# Project root Jamfile
include Jamfile ;
