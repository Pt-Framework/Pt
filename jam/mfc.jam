if ! $(JAMBASE_MFC_JAM_INCLUDED) {
JAMBASE_MFC_JAM_INCLUDED = true ;

###############################################################################
# Configure MFC (Microsoft Foundation Classes)
###############################################################################

# Mfc-Configure
#
# Locates MFC include and library directories from the Visual C++
# installation path (VISUALC). Searches known atlmfc directory
# layouts across different MSVC versions.
#
# If MFC_INCLUDES or MFC_LIBDIR are preset by the user, those
# paths are used directly.
#
# On success, MFC_INCLUDES and MFC_LINKFLAGS are set.
# Returns "yes" on success.

rule Mfc-Configure
{
    local result ;

    # Locate include directory
    if ! $(MFC_INCLUDES)
    {
        MFC_INCLUDES = [ GLOB $(VISUALC)\\VC\\atlmfc : include ] ;
    }

    if ! $(MFC_INCLUDES)
    {
        MFC_INCLUDES = [ GLOB $(VISUALC)\\atlmfc : include ] ;
    }

    if $(MFC_INCLUDES)
    {
        MFC_INCLUDES = \"$(MFC_INCLUDES)\" ;

        # Locate library directory
        if ! $(MFC_LIBDIR)
        {
            if $(TARGET_OSPLAT:L) = "x86_64"
            {
                MFC_LIBDIR = [ GLOB $(VISUALC)\\VC\\atlmfc\\lib : amd64 ] ;
            }
            else if $(TARGET_OSPLAT:L) = "x86"
            {
                MFC_LIBDIR = [ GLOB $(VISUALC)\\VC\\atlmfc : lib ] ;
            }
        }

        if ! $(MFC_LIBDIR)
        {
            if $(TARGET_OSPLAT:L) = "x86_64"
            {
                MFC_LIBDIR = [ GLOB $(VISUALC)\\atlmfc\\lib : x64 ] ;
            }
            else if $(TARGET_OSPLAT:L) = "x86"
            {
                MFC_LIBDIR = [ GLOB $(VISUALC)\\atlmfc\\lib : x86 ] ;
            }
        }

        if $(MFC_LIBDIR)
        {
            MFC_LINKFLAGS = /LIBPATH:\"$(MFC_LIBDIR)\" ;
            result = yes ;
        }
    }

    return $(result) ;
}

} # JAMBASE_MFC_JAM_INCLUDED
