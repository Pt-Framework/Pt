JAVA_SYSTEM_INCLUDE = win32 ;

##############################################################################
# Default values and settings
##############################################################################
if $(MSVCDir)
{
    TOOLSET ?= vc7 ;
}
else if $(VSINSTALLDIR)
{
    TOOLSET ?= vc8 ;

    if $(VS90COMNTOOLS)
    {
        TOOLSET = vc9 ;
    }
}
else if $(MINGW)
{
    TOOLSET ?= mingw ;
}
else
{
    TOOLSET ?= vc7 ;
}

SUFOBJ	= .obj ;
PRELIB	= "" ;

if $(CONFIG) = debug 
{
	SUFLIB	= d.lib ;
	SUFEXE	= d.exe ;
	SUFDLL	= d.dll ;
	SUFDBG  = d ;
}
else
{
	SUFLIB	= .lib ;
	SUFEXE	= .exe ;
	SUFDLL	= .dll ;
	SUFDBG  = "" ;
}



