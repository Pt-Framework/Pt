JAVA_SYSTEM_INCLUDE = win32 ;

##############################################################################
# Default values and settings
##############################################################################
if $(MSVCDir)
{
    TOOLSET ?= vc7 ;
}
else if $(VSINSTALLDIR)
{
    if $(VS100COMNTOOLS)
    {
        TOOLSET ?= vc10 ;
    }

    if $(VS90COMNTOOLS)
    {
        TOOLSET ?= vc9 ;
    }
   
    TOOLSET ?= vc8 ;
}
else if $(MINGW)
{
    TOOLSET ?= mingw ;
}
else
{
    TOOLSET ?= vc7 ;
}

SUFOBJ	= .obj ;
PRELIB	= "" ;
SUFLIB	= .lib ;
SUFEXE	= .exe ;
SUFDLL	= .dll ;
SUFDBG  = "" ;




