JAVA_SYSTEM_INCLUDE = win32 ;

SUFOBJ		= .obj ;
PRELIB		= "" ;

if $(CONFIG) = debug 
{
	SUFLIB		= d.lib ;
	SUFEXE		= d.exe ;
	SUFDLL	= d.dll ;
}
else
{
	SUFLIB		= .lib ;
	SUFEXE		= .exe ;
	SUFDLL	= .dll ;
}

# Deduce TOOLSET from envars usually set by build console
#
if $(MSVCDir)
{
	TOOLSET ?= vc7 ;
}
else if $(VSINSTALLDIR) 
{
	TOOLSET ?= vc8 ;
}
else
{
	TOOLSET ?= vc7 ;
}

SYS		?= win32 ;
GUI		?= gdi ;

SYSLIBS += wsock32.lib ;
SYSLIBS += version.lib ;
GFXLIBS = ;
GUILIBS = ;



