
rule ConfigurePsapi
{
    WITH_PSAPI = [ CheckBuildC++ "#include <windows.h>"
                                        "#include <Psapi.h>"
                                        "int main() { PROCESS_MEMORY_COUNTERS pmc;"
                                        "GetProcessMemoryInfo( NULL, &pmc, sizeof(pmc) );"
                                        "return 0; }"
                                        : ""
                                        : Psapi.lib ] ;

    EchoOption WITH_PSAPI : "PsApi library" ;
    Configure WITH_PSAPI ;

    if $(WITH_PSAPI)
    {
        PSAPI_LIBS += Psapi.lib ;

        EchoOption PSAPI_LIBS : "PsAapi lib flags" ;
        Configure PSAPI_LIBS ;
    }
}

rule ConfigureWsa
{
    WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                      "#include <windows.h>"
                                      "#include <winsock2.h>"
                                      "int main() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                      "return 0; }"
                                      : ""
                                      : wsock32.lib ws2_32.lib ] ;

    if $(WITH_WSA)
    {
        WSA_LIBS = wsock32.lib ws2_32.lib ;
    }

    if ! $(WITH_WSA)
    {
        WITH_WSA = [ CheckBuildC++ "#define WIN32_LEAN_AND_MEAN"
                                    "#include <windows.h>"
                                    "#include <winsock2.h>"
                                    "int main() { WSADATA wd; WSAStartup(MAKEWORD(2,2), &wd);"
                                    "return 0; }"
                                    : ""
                                    : winsock.lib Ws2.lib ] ;
        if $(WITH_WSA)
        {
            WSA_LIBS = winsock.lib Ws2.lib ;
        }
    }

    EchoOption WITH_WSA : "WSA2 library" ;
    Configure WITH_WSA ;

    if $(WITH_WSA)
    {
        EchoOption WSA_LIBS : "WSA2 lib flags" ;
        Configure WSA_LIBS ;
    }
}


rule ConfigureGdi
{
    WITH_GDI = [ CheckBuildC++ "#include <windows.h>"
                               "int main() { HDC dc; Rectangle(dc,0,0,0,0); return 0; }"
                              : ""
                              : gdi32.lib ] ;

    if $(WITH_GDI)
    {
        GDI_LIBS = gdi32.lib ;
    }

    if ! $(WITH_GDI)
    {
        WITH_GDI = [ CheckBuildC++ "#include <windows.h>"
                                   "int main() { HDC dc; Rectangle(dc,0,0,0,0); return 0; }"
                                  : ""
                                  : coredll.lib ] ;
    }
    
    EchoOption WITH_GDI : "GDI library" ;
    Configure WITH_GDI ;

    if $(WITH_GDI)
    {
        EchoOption GDI_LIBS : "GDI lib flags" ;
        Configure GDI_LIBS ;
    }
}


rule ConfigureWinUI
{
    WITH_WINUI = [ CheckBuildC++ "#include <windows.h>"
                                 "int main() { WNDCLASS wc; RegisterClass(&wc); return 0; }"
                                : ""
                                : user32.lib ] ;

    if $(WITH_WINUI)
    {
        WINUI_LIBS = user32.lib ;
    }

    if ! $(WITH_WINUI)
    {
        WITH_WINUI = [ CheckBuildC++ "#include <windows.h>"
                                     "int main() { WNDCLASS wc; RegisterClass(&wc); return 0; }"
                                      : ""
                                      : "coredll.lib" ] ;
    }

    EchoOption WITH_WINUI : "Windows UI" ;
    Configure WITH_WINUI ;

    if $(WITH_WINUI)
    {
        EchoOption WINUI_LIBS : "User32 lib flags" ;
        Configure WINUI_LIBS ;
    }
}