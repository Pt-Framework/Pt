#
# Runs the moc on header files containing class definitions to generate a
# source file that has to be compiled with the other source files.
#
# Example usage:
#
# Moc qtest.moc.cpp : qtest.h ;
#
# Main qtest : qtest.cpp qtest.moc.cpp ;
#

QT_DIR ?= ;

###############################################################################
# Configure moc
###############################################################################
QT_MOC ?= [ FDirName $(QT_DIR) "moc"$(SUFEXE) ] ;

rule ConfigureMoc
{
    WITH_QT_MOC = [ CHECK_IF_FILE $(QT_MOC) ] ;
 
    if ! $(WITH_QT_MOC)
    {
        EchoOption QT_MOC : "Qt moc" : $(QT_MOC) "not found" ;
    }
    else
    {
        Configure QT_MOC : $(QT_MOC) ;
        EchoOption QT_MOC : "Qt moc" ;
    }
}

###############################################################################
# Configure uic
###############################################################################
QT_UIC ?= [ FDirName $(QT_DIR) "uic"$(SUFEXE) ] ;

rule ConfigureUic
{
    WITH_QT_UIC = [ CHECK_IF_FILE $(QT_UIC) ] ;
 
    if ! $(WITH_QT_UIC)
    {
        EchoOption QT_UIC : "Qt uic" : $(QT_UIC) "not found" ;
    }
    else
    {
        Configure QT_UIC : $(QT_UIC) ;
        EchoOption QT_UIC : "Qt uic" ;
    }
}

###############################################################################
# Configure Qt
###############################################################################

rule ConfigureQt
{
    WITH_QT = ;

    EchoOption QT_DIR : "Qt directory" ;

    ConfigureMoc ;
    ConfigureUic ;

    if $(WITH_QT_MOC) && $(WITH_QT_UIC)
    {
        WITH_QT = yes ;
    }
}

###############################################################################
# Rules and Actions for moc
###############################################################################
rule Moc
{
	local _mocFile = [ FGristFiles $(<) ] ;
	local _header = $(>) ;

	MakeLocate $(_mocFile) : $(LOCATE_SOURCE) ;
	SEARCH on $(>) = $(SEARCH_SOURCE) ;
	Depends $(_mocFile) : $(_header) ;
	Moc1 $(_mocFile) : $(>) ;

	Clean clean : $(_mocFile) ;
}

actions Moc1
{
	$(QT_MOC) $(>) -o $(<)
}

###############################################################################
# Rules and Actions for uic
###############################################################################
rule Uic
{
	local _headerFile = [ FGristFiles $(<) ] ;
	local _uicFile = $(>) ;

	MakeLocate $(_headerFile) : $(LOCATE_SOURCE) ;
	SEARCH on $(>) = $(SEARCH_SOURCE) ;
	Depends $(_headerFile) : $(_uicFile) ;
	Uic1 $(_headerFile) : $(>) ;

	Clean clean : $(_headerFile) ;
}

actions Uic1
{
	$(QT_UIC) $(>) -o $(<)
}
