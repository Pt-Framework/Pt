if ! $(JAMBASE_ZLIB_JAM_INCLUDED) {
JAMBASE_ZLIB_JAM_INCLUDED = true ;

ZLIB_CHECK_CODE = "#include <zlib.h>"
                  "int main() {"
                  "z_stream zstream;"
                  "return deflateInit(&zstream, Z_DEFAULT_COMPRESSION); }" ;

rule ZLib-CheckCompile ( includes * : c++flags * )
{
    return [ CheckDependencyCompileC++ ZLIB : $(ZLIB_CHECK_CODE)
                                            : $(includes) : $(c++flags) ] ;
}

rule ZLib-CheckLink ( includes * : c++flags * : linklibs * : libdir * : linkflags * )
{
    return [ CheckDependencyLinkC++ ZLIB : $(ZLIB_CHECK_CODE)
                                        : $(includes) : $(c++flags)
                                        : $(linklibs) : $(libdir) : $(linkflags) ] ;
}

rule ZLib-Check ( includes * : c++flags * : linklibs * : libdir * : linkflags * )
{
    return [ CheckDependencyC++ ZLIB : $(ZLIB_CHECK_CODE)
                                    : $(includes) : $(c++flags)
                                    : $(linklibs) : $(libdir) : $(linkflags) ] ;
}

rule ZLib-ConfigureInclude ( includes * : c++flags * )
{
    local hdr_found = [ ZLib-CheckCompile $(includes) : $(c++flags) ] ;
    return $(hdr_found) ;
}

rule ZLib-ConfigureLink ( includes * : c++flags * : linklibs * : libdir * : linkflags * )
{
    local result ;

    local is_debug ;
    if $(WITH_DEBUG) && ! $(WITH_OPTIM) { is_debug = true ; }

    # 1: caller-provided libs
    if ! $(result) && $(linklibs)
    {
        result = [ ZLib-CheckLink $(includes)
                                : $(c++flags)
                                : $(linklibs)
                                : $(libdir) : $(linkflags) ] ;
    }

    # 2: debug lib (zlibd)
    if ! $(result) && $(is_debug)
    {
        result = [ ZLib-CheckLink $(includes)
                                : $(c++flags)
                                : [ FLinkLibs zlibd ]
                                : $(libdir) : $(linkflags) ] ;
    }

    # 3: MSVC-style lib name (zlib)
    if ! $(result)
    {
        result = [ ZLib-CheckLink $(includes)
                                : $(c++flags)
                                : [ FLinkLibs zlib ]
                                : $(libdir) : $(linkflags) ] ;
    }

    # 4: MSVC-style alternate lib name (zlib1)
    if ! $(result)
    {
        result = [ ZLib-CheckLink $(includes)
                                : $(c++flags)
                                : [ FLinkLibs zlib1 ]
                                : $(libdir) : $(linkflags) ] ;
    }

    # 5: Unix-style lib name (z)
    if ! $(result)
    {
        result = [ ZLib-CheckLink $(includes)
                                : $(c++flags)
                                : [ FLinkLibs z ]
                                : $(libdir) : $(linkflags) ] ;
    }

    return $(result) ;
}

# ZLib-Configure INCLUDES : C++FLAGS : LINKLIBS : LIBDIR : LINKFLAGS
#
# Probes for a system zlib installation by trying pkg-config first (if no
# hints have been provided), then falling back to compile-probes with
# toolset-neutral library flags.
#
# Returns "yes" on success; ZLIB_INCLUDES, ZLIB_C++FLAGS, ZLIB_LINKLIBS
# and ZLIB_LINKFLAGS are set as a side-effect by CheckDependencyCompileC++
# and CheckDependencyLinkC++.

rule ZLib-Configure ( includes * : c++flags * : linklibs * : libdir * : linkflags * )
{
    local result ;

    # Pkg-config (only when no hints are provided)
    if ! $(includes) && ! $(libdir) && ! $(linklibs) && ! $(c++flags) && ! $(linkflags)
    {
        Load pkgconfig.jam ;

        if [ PkgConfig-Exists zlib ]
        {
            includes  = [ PkgConfig-Includes zlib ] ;
            c++flags  = [ PkgConfig-CFlags zlib ] ;
            linklibs  = [ PkgConfig-LinkLibs zlib ] ;
            linkflags = [ PkgConfig-LinkFlags zlib ] ;

            result = [ ZLib-Check $(includes)
                                : $(c++flags)
                                : $(linklibs)
                                : : $(linkflags) ] ;
        }
    }

    # Include search, then link search
    if ! $(result)
    {
        if [ ZLib-ConfigureInclude $(includes) : $(c++flags) ]
        {
            includes = $(ZLIB_INCLUDES) ;
            c++flags = $(ZLIB_C++FLAGS) ;

            result = [ ZLib-ConfigureLink $(includes) : $(c++flags)
                                        : $(linklibs) : $(libdir) : $(linkflags) ] ;
        }
    }

    return $(result) ;
}

} # JAMBASE_ZLIB_JAM_INCLUDED
