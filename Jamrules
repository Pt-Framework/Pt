rule CheckC++
{
    local _line ;
    for _line in $(2)
    {
        WriteFile $(1).cpp : $(_line) ;
    }

    local _cmd = $(C++) -o $(1:S=$(SUFEXE)) $(1).cpp ;
    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    _cmd = $(RM) $(1).cpp ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    _cmd = $(RM) $(1:S=$(SUFEXE)) ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    if $(_result[2]) = 0
    {
    	WriteFile Jamconfig : $(1)" = 1 ;"  ;
        return 1 ;
    }
    else
    {
    	WriteFile Jamconfig :  $(1)" = 0 ;"   ;
        return 0 ;
    }
}


rule ConfigureDefine
{
    local _line = "#ifndef" $(2) ;
    WriteFile $(1) : $(_line:J=" ") ;

    _line = "#define" $(2) "=" $(3) ;
    WriteFile $(1) : $(_line:J=" ") ;

    WriteFile $(1) : "#endif" ;
}


rule ConfigureCommand
{
    local _var = $(1) ;
    local _val = $(2) ;
    local _cmd = $(3) ;

    local _result = [ COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ] ;

    if $(_result[2]) = 0
    {
        $(_var) = $(_val) ;
        WriteFile Jamconfig :  $(_var)" = "$(_val)" ;"   ;
        return 1 ;
    }
}


rule ConfigureC++
{
    local _cmd ;
    local _result ;

    WriteFile check.cpp : "#include <string>" ;
    WriteFile check.cpp : "int main() { return 0; } " ;

    if [ ConfigureCommand C++ : "g++" : "g++ -o check check.cpp" ]
    {
        Echo "Checking for C++ compiler... g++" ;
        _cmd = $(RM) "check" ;
        COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
        _result = "g++" ;
    }
    else if [ ConfigureCommand C++ : "CC" : "CC -o check check.cpp" ]
    {
        Echo "Checking for C++ compiler... CC" ;
        _cmd = $(RM) "check" ;
        COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;
        _result = "CC" ;
    }

    _cmd = $(RM) "check.cpp" ;
    COMMAND $(_cmd:J=" ") : "exit-status" : "no-output" ;

    if ! $(_result)
    {
        Exit "Checking for C++ compiler... NOT FOUND" ;
    }

    return $(_result) ;
}


