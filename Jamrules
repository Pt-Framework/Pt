if $(GUI:L) = "x11"
{
    JamInclude x11.jam ;

    local x11incl = [ X11Includes ] ;
    if $(x11incl) = ""
    {
        Echo "    ERROR: X11 includes are required!" ;
    }

    local x11libs = [ X11Libs ] ;
    if $(x11libs) = ""
    {
        Echo "    ERROR: X11 libraries are required!" ;
    }

    local xextlibs = [ XextLibs ] ;
    if $(xextlibs) = ""
    {
        Echo "    ERROR: Xext libraries are required!" ;
    }

    local xftincl = [ XftIncludes ] ;
    if $(xftincl) = ""
    {
        Echo "    INFO: Xft includes not available!" ;
    }

    local xftlibs = [ XftLibs ] ;
    if $(xftlibs) = ""
    {
        Echo "    INFO: Xft libraries not available!" ;
    }

    GUILIBS += $(x11libs) $(xextlibs) $(xftlibs) ;
}

if $(GUI:L) = "gf"
