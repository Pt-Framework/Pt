rule TntnetLibrary
{
  local _source = $(<:S=.cpp) ;
  local _sourceGristed = [ FGristFiles $(_source) ] ;

  MakeLocate $(_source) : $(LOCATE_TARGET) ;
  SEARCH on $(>) = $(SEARCH_SOURCE) ;
  Clean clean : $(_source) ;

  Depends $(_sourceGristed) : $(>) ;
  Depends $(_source) : $(>) ;

  SharedLibrary $(<) : $(_source) ;
  LINKFLAGS on $(PRELIB)$(<:S=$(SUFDLL)) += $(TNTNETLIBS) ;

  Ecppc $(_source) : $(>) ;
}

actions Ecppc
{
    ecppc -o $(<) -n $(<:B) $(>)
}


#############################################################################
# Auto configuration rules and actions
#############################################################################
#NOTFILE configure configure-clean ;
#Depends configure : Jamconfig ;
#Depends Jamconfig : configure-clean ;
#Clean configure-clean : Jamconfig ;


rule _ConfigureC++
{
    local _defines = Jamconfig ;
    local _source = $(1:S=.cpp) ;
    local _target = $(1:S=$(SUFEXE)) ;
    local _libs = $(3) ;

    Depends Jamconfig : $(_target) ;

    LINKLIBS on $(_target) = $(_libs) ;
    CheckC++ $(_target) : $(_source) : $(2) ;
    Jamconfig Jamconfig : $(1) ;
}

rule _CheckC++
{
    local _target = $(1) ;
    local _source = $(2) ;
    local _prog = $(3) ;

    NOCARE $(1) ;

    local _include ;
    for local _line in $(_prog)
    {
        _include = [ Match "(<[a-z,A-Z,0-9,.]*>)" : $(_line) ] ;
        _include = [ Match "([a-z,A-Z,0-9][a-z,A-Z,0-9,.]*)" : $(_include) ] ;

        if $(_include)
        {
            if $(NT)
            {
                AppendFile $(_source) : "#include ^<"$(_include)"^>" ;
            }
            else
            {
                AppendFile $(_source) : "#include <"$(_include)">" ;
            }
        }
        else
        {
            AppendFile $(_source) : $(_line) ;
        }
    }

    RmTemps configure : $(_target) ;
    RmTemps configure : $(_source) ;

    Depends $(_target) : $(_source) ;
}

if $(NT)
{
    actions quietly _AppendFile
    {
        echo $(2) >> $(1)
    }

    actions quietly _Jamconfig
    {
        if exist $(2:S=$(SUFEXE)) goto exists
        echo $(2) = 0 ; >> $(1)
        goto end

        :exists
            echo $(2) = 1 ; >> $(1)

        :end
    }
}
else
{
    actions quietly _AppendFile
    {
        printf "$(2)\n" >> $(1)
    }

    actions quietly _Jamconfig
    {
        if test -f $(2:S=$(SUFEXE)); then
            echo $(2)" = 1 ;" >> $(1)
        fi
    }
}

if $(VISUALC)
{
    actions ignore _CheckC++
    {
        set LIB=$(VCDIR)\lib\;$(PLATFORMSDK)\lib\;%LIB% 
        "$(C++)" /Fo$(<:S=.obj) /Fe$(<) /I$(HDRS) /I$(STDHDRS) /EHsc /TP $(>) /link $(LINKLIBS)
    }
}
else
{
    actions ignore _CheckC++
    {
        $(C++) -o $(<) $(>) -l$(LINKLIBS)
    }
}



