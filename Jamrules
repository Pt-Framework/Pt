# Translate build variables to preprocessor defines
#
C++FLAGS += [ FDefines "PT_"$(OS:U) ] ;
C++FLAGS += [ FDefines "PT_"$(OSPLAT:U) ] ;
C++FLAGS += [ FDefines "PT_"$(TOOLSET:U) ] ;


# print project information
Echo ;
Echo "Project                  :" "Platinum Framework" ;
Echo "Operating System         :" $(OS:L) ;
Echo "Platform                 :" $(OSPLAT:L) ;
Echo "Target Operating System  :" $(TARGET_OS:L) ;
Echo "Target Platform          :" $(TARGET_OSPLAT:L) ;
Echo "Toolset                  :" $(TOOLSET) ;
Echo "Byte Order               :" $(BYTEORDER:L) ;
Echo "System Interface         :" $(SYS) ;
Echo "Graphic User Interface   :" $(GUI) ;
Echo "Configuration            :" $(CONFIG) ;
Echo ;

