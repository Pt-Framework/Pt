{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pt-Mcp-Demo (HTTP) - Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Pt-Mcp-Demo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Pt-Forms-Demo (Windows) - Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Pt-Mcp-test.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Pt-Forms-Demo (Linux) - Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Pt-Forms-Demo",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Pt-Forms-Demo (MacOS) - Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Pt-Forms-Demo",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Remote Debug (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/tmp/Pt-test",
            "args": [ "-t",  "AnyTest"],
            "stopAtEntry": false,
            "cwd": "/tmp",
            "environment": [
                 {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/tmp:/tmp/lib"
                }
            ],
            "MIMode": "gdb",
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            },
            "pipeTransport": {
                "debuggerPath": "/usr/bin/gdb",
                "pipeProgram": "C:\\Windows\\System32\\OpenSSH\\ssh.exe",
                "pipeArgs": [
                    "-i",
                    "${workspaceFolder}\\id_rsa_bravo",
                    "-T",
                    "root@192.168.0.229"
                ],
                "pipeCwd": ""
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
