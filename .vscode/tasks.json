{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "configureOptions",
            "type": "pickString",
            "description": "Select configuration options",
            "options": [
                { "label": "Debug",   "value": "-sCONFIG=debug --debug" },
                { "label": "Release", "value": "-sCONFIG=release --debug --optimize" }
            ],
            "default": "Debug"
        },
        {
            "id": "configureExtra",
            "type": "promptString",
            "description": "Additional configuration options",
            "default": ""
        }
    ],
    "tasks": [
        {
            "label": "Configure...",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat configure ${input:configureOptions} ${input:configureExtra}"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true, "reveal": "always", "focus": false, "panel": "shared"
            }
        },
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "configure", "-sCONFIG=debug", "--debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            }
        },
        {
            "label": "Configure Release",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "configure", "-sCONFIG=release", "--debug", "--optimize"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            }
        },
        {
            "label": "Switch Debug",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "switch", "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            }
        },
        {
            "label": "Switch Release",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "switch", "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            }
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "-q", "-j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${cwd}"]
                },
                {
                    "base": "$msCompile",
                    "fileLocation": ["relative", "${cwd}"]
                }
            ]
        },
        {
            "label": "Clean All",
            "type": "shell",
            "command": "./jam.sh",
            "windows": {
                "command": ".\\jam.bat"
            },
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always", "focus": false, "panel": "shared"
            }
        }
    ]
}